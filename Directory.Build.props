<Project>
  <!-- Общие настройки нового бота (src/, tools/, tests/).
       Старый проект BotCH/BotCH.csproj тоже видит этот файл — его не трогаем. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'BotCH'">
    <TargetFramework>net48</TargetFramework>
    <!-- Клиент игры 32-битный: процесс бота тоже 32-битный -->
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <Company>gotyefrid</Company>
    <Product>BotCH</Product>
  </PropertyGroup>
</Project>
