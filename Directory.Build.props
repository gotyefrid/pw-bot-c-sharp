<Project>
  <!-- Общие настройки всех проектов (src/, tools/, tests/) -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- Клиент игры 32-битный: процесс бота тоже 32-битный -->
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <Company></Company>
    <Product>Notes</Product>
  </PropertyGroup>

  <!-- Релиз без отладочных данных: в готовом exe (и во вшитой в него BotCH.Core.dll) не остаётся пути к папке сборки -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
