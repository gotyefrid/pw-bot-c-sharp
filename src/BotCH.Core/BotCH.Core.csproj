<Project Sdk="Microsoft.NET.Sdk">
  <!-- Вся логика бота без интерфейса: память, профили серверов, снимок мира, действия, мозг, настройки, лог -->
  <PropertyGroup>
    <RootNamespace>BotCH.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BotCH.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Профили серверов вшиваются в сборку: бот — один exe -->
    <EmbeddedResource Include="Profiles\*.jsonc" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
</Project>
