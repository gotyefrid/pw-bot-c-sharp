/*
  PW Classic 1.3.6 — https://pwclassic.net/
  Перенесено из старого бота: BotCH/MemoryHelpers/Offsets/PwClassic136.cs (ветка master).

  Все адреса функций (rva) — от начала модуля ElementClient.exe. Он грузится с 0x400000,
  т.е. адрес в IDA/x32dbg = 0x400000 + rva. Смещения полей — от начала своего объекта.
  0 = «на этом сервере нет / ещё не найдено».

  КАК ИСКАТЬ ПОЛЯ В ПАМЯТИ ДЛЯ ДРУГОГО КЛИЕНТА (метод «до/после»)
    1. Снять дамп структуры объекта (моба, предмета) — например, первые 0x600 байт.
    2. Сделать в игре одно действие (убить моба, натравить пета, бросить предмет).
    3. Снять дамп ещё раз и сравнить: искомое поле меняется ровно один раз и в нужный момент.
    4. Проверить кандидата на других объектах вокруг: у всех «обычных» должно быть одно и то же значение.
    Одного опыта мало: в первом тесте «флаг боя» легко принять за «флаг смерти». Повторять минимум дважды.
    HP моба для этого не годится: клиент знает HP только у выбранной цели, у остальных там 0.

  КАК ИСКАТЬ ФУНКЦИИ ОТПРАВКИ КОМАНД (c2s_SendCmd*) В ДРУГОМ КЛИЕНТЕ
    Каждая команда серверу — пакет [номер команды, 2 байта][данные]. Все функции устроены одинаково:
        выделить буфер; mov word [esi], НОМЕР; записать данные; push РАЗМЕР; push esi; call SendGameData
    1. SendGameData — функция, которую вызывают больше всего мест (здесь 0x5D2350, ~168 вызовов, ecx = [[0x9B3EEC]+0x20]).
       Ищется перебором exe: места «mov word [reg], маленькое число ... call X», самый частый X — она.
    2. Все её вызывающие лежат подряд одной таблицей (здесь ~0x5F01C0–0x5F3800) в порядке номеров команд.
    3. Нужную выбираем по номеру команды (из протокола PW) и проверяем по размеру пакета:
        0x02 выбор цели (6 байт), 0x03 обычная атака (3), 0x06 подбор (10), 0x08 снять цель, 0x28 предмет, 0x29 скилл.
       0x01 — выход из игры, НЕ вызывать. 0x66 — отпустить пета, НЕ вызывать.
    4. Проверить в игре тестовым вызовом. Код игры не менять: патч .text защита ловит и закрывает клиент (~1 с).

  КАК ИСКАТЬ ЛОГИКУ КЛИЕНТА
    В exe есть RTTI (имена классов, «.?AVCECHostPlayer@@»): имя → vtable → конструктор → кто создаёт.

  СИГНАТУРЫ — начало функции; «??» — адреса внутри кода (call/jmp, глобальные переменные).
    Совпала по rva — вызываем. Не совпала — ищем по всему коду; одно совпадение — функция переехала, иначе не вызываем.
    Сделаны командой «BotCH.Probe sigmake» (самая короткая от 12 байт, минимум 10 точных, встречающаяся в коде ровно один раз),
    проверяются командой «BotCH.Probe sigcheck». Короткие 4–6 байт старого бота встречались в коде до 16+ раз.
*/
{
  "id": "pwclassic136",
  "name": "PW Classic 1.3.6",
  "clientProcessName": "elementclient",

  "base": {
    // Тот же указатель, что использует SendGameData: [0x9B3EEC] = [0x400000 + 0x5B3EEC]
    "basePointer": "0x5B3EEC",
    "game": "0x1C",
    "unfreeze": "0x48C"
  },

  // Персонаж: [game + 0x20]. Это объект CECHostPlayer (vtable 0x8D74C8)
  "host": {
    "struct": "0x20",
    "namePointer": "0x608",
    "castFlag": "0xB8",
    "wid": "0x458",
    // Уровень лежит рядом с WID (0x458) и HP (0x46C); 0x474 — похоже, текущий опыт
    "level": "0x464",
    "hp": "0x46C",
    "mp": "0x470",
    "maxHp": "0x4A4",
    // Найдено «Probe scanint» при полной мане: 490 лежит в +0x470 (MP) и +0x4A8 — так же, как HP +0x46C / MaxHP +0x4A4.
    // Подтвердить «до/после»: потратить ману — +0x470 уменьшится, +0x4A8 останется
    "maxMp": "0x4A8",
    "targetId": "0xAF0",
    // От старого клиента: значение 0 в покое подтверждено, отсчёт не проверялся.
    // Перезарядка корма пета (0xBF4 у старого клиента) на PW Classic всегда 0 — не использовать, поэтому её здесь нет
    "hpPotionCooldown": "0x9EC",
    // X, высота, Y
    "location": "0x3C",
    // CECHPWorkMan — менеджер «работ» (идти в точку, подойти к цели, анимации)
    "workMan": "0xE48",
    // Сумка: найдено так — в сумке лежали подобранные известь (tid 8084) и мех (8083), искали указатели из структуры
    // перса, ведущие к массиву предметов с этими tid. Совпадение одно
    "inventory": "0xC34",
    // Массив указателей на объекты скиллов и их число. Найдено поиском в структуре перса массива объектов одного класса
    // (общий vtable 0x8DB00C) с небольшими числами внутри
    "skills": "0xE70",
    "skillsCount": "0xE74",
    "petManager": "0xE60"
  },

  // Менеджер петов: [перс + 0xE60]
  "petManager": {
    // Номер призванной клетки (с 0), -1 — пета нет
    "activeCage": "0x8",
    // Пет клетки N: [менеджер + 0x10 + (N-1)*4]. 10 клеток: 0x10..0x34, следом 0x38 — WID пета
    "cages": "0x10",
    "cageCount": 10,
    // WID призванного пета. Он же лежит в списке мобов с типом 9. Меняется при КАЖДОМ призыве
    "activePetWid": "0x38"
  },

  // Пет в клетке
  "pet": {
    // float 0..1
    "hpRatio": "0x1C",
    "hunger": "0x8"
  },

  // Мир: [game + 0x8]. Менеджеры мира устроены одинаково — хэш-таблица: [менеджер + 0x18] — массив 769 ячеек,
  // ячейка — указатель на узел {+0x0 следующий узел, +0x4 объект, +0x8 WID/id}. Цепочки (несколько узлов в ячейке) возможны,
  // старый бот их не обходил. [менеджер + 0x14] — сколько объектов всего (проверено: 12 мобов, 30 предметов — совпало с обходом)
  "world": {
    "world": "0x8",
    "npcs": "0x24",
    // Найдено перебором менеджеров рядом со списком мобов (мир +0x10...+0x3C): здесь объекты с ID вида 0xC0000000|n
    // (у мобов 0x80000000|n) и координатами рядом с персонажем
    "groundItems": "0x28",
    "slotArray": "0x18",
    "slotCount": 769,
    "count": "0x14",
    "objectInSlot": "0x4"
  },

  // Моб / NPC / пет в мире
  "npc": {
    // WID = константа + номер ячейки в списке, поэтому моб после респавна получает ТОТ ЖЕ WID. Чёрные списки по WID не работают
    "wid": "0x11C",
    // 6 моб, 7 NPC, 9 пет
    "type": "0xB4",
    // 1 стоит, 5 идёт, 2 бьёт физ. атакой, 3 кастует, 4 мёртв (держится, пока лежит труп).
    // Найдено «до/после» на убийстве моба: 4 ставится ровно в момент смерти. На Comeback это поле 0x2D4
    "state": "0x2B8",
    // Только у выбранной цели; у остальных мобов 0. До 0 при смерти может и не дойти. НЕ фильтровать по нему
    "hp": "0x12C",
    "distance": "0x270",
    // WID персонажа или пета, на которого агрится моб; 0 — нейтрален.
    // Найдено так: натравить пета на моба и искать в структуре моба поле, где появится WID пета.
    // Рядом (0x0DC: 0x96 -> 0x64) есть ещё флаг «моб вступил в бой» — не путать со смертью
    "target": "0x2D4",
    // Указатель на название (UTF-16). Найдено командой «BotCH.Probe scanstr mob»: у всех мобов «Сидящий волк» по +0x24C.
    // (0x26C из старого кода — с другого клиента, здесь там не строка.) По названию работает белый список мобов
    "namePointer": "0x24C",
    "location": "0x3C"
  },

  // Предмет на земле
  "groundItem": {
    // id для подбора
    "id": "0x10C",
    // id типа предмета (монета 3044 и т.п.), второй параметр подбора
    "tid": "0x110",
    // 1 предмет, 2 ресурс (копать, не подбирать), 3 монеты
    "kind": "0x14C",
    // Расстояние до персонажа, float (сверено с координатами)
    "distance": "0x154",
    // Указатель на название (UTF-16)
    "namePointer": "0x164",
    "location": "0x3C"
  },

  // Сумка: [перс + 0xC34]. +0xC массив указателей на предметы (индекс = ячейка, с 0), +0x10 число ячеек (32).
  // Предмет: +0x4 категория (9 банки, 27 корм пета, 8 материалы, 0/15/19 экипировка...), +0x8 tid, +0x10 сколько в стопке,
  // +0x14 максимум в стопке, +0x40 указатель на текст подсказки (название в начале), +0x54 описание (шаблон)
  "inventory": {
    "items": "0xC",
    "size": "0x10",
    "itemCategory": "0x4",
    "itemTid": "0x8",
    "itemCount": "0x10",
    "itemEssence": "0x54",
    // У корма пета другой класс предмета, и описание лежит по другому указателю
    "foodEssence": "0x4C",
    "categoryPotion": 9,
    "categoryPetFood": 27
  },

  // Описание банки (найдено сравнением малой и средней банок HP и банки MP): +0x0 tid, +0x164/+0x168 цены
  "potion": {
    "requiredLevel": "0x14C",
    "hp": "0x154",
    // за сколько секунд (10 у малой и средней — подтверждено в игре)
    "hpSeconds": "0x158",
    "mp": "0x15C",
    "mpSeconds": "0x160"
  },

  // Описание корма (сравнение трёх кормов на 10/50/100 верности): +0x0 tid, +0x144 класс корма (1/2/3),
  // +0x150 вид корма битовой маской (16 = «чистая вода»), +0x154 цена, +0x15C максимум в стопке.
  // Что ест конкретный пет, не ищем: бот проверяет, уменьшилась ли стопка после кормления
  // (отказ ≠ «не ест» — см. ТЗ, часть 4)
  "petFood": {
    "loyalty": "0x148"
  },

  // Объект скилла. Названия в нём нет — берётся по ID из файла игры (configs.pck → skillstr.txt).
  // Какой ID за что отвечает, узнали так: применяли скилл руками и смотрели, у кого пошла перезарядка
  "skill": {
    "id": "0x8",
    "level": "0xC",
    // Признак, что скилл принят сервером, — началась перезарядка; у долгих скиллов только после каста
    "cooldownLeft": "0x10",
    "cooldownFull": "0x14",
    "flags": "0x18"
  },

  // ID скиллов друида (захардкожено: персонаж с петом пока один). Ещё: 167 «Городской портал»
  "skills": {
    // «Исцеление питомца», каст ~1.6 с
    "healPet": 330,
    // «Оживление питомца», каст ~12 с
    "revivePet": 329,
    // «Жалящий рой» — базовый атакующий скилл друида, есть у всех друидов
    "defaultAttack": 299,
    // Точно не атакующие — не показываются в списке атакующих. Дописывать по мере нахождения
    "notAttack": [ 167, 329, 330 ]
  },

  "functions": {
    // c2s_SendCmdSelectTarget(int id), команда 0x02, пакет 6 байт. Код: push esi; push 6; call alloc ... mov word [esi], 2
    "selectTarget": { "rva": "0x1F0330", "convention": "cdecl", "signature": "56 6A 06 E8 ?? ?? ?? ?? 8B F0 83 C4 04 85 F6 74 26 8B 44 24 08 66 C7 06 02 00 89 46" },

    // c2s_SendCmdUnselect(), команда 0x08, пакет 2 байта, без параметров (аналог Esc)
    "unselect": { "rva": "0x1F0C90", "convention": "cdecl", "signature": "56 6A 02 E8 ?? ?? ?? ?? 8B F0 83 C4 04 85 F6 74 1E 66 C7 06 08 00 A1 ??" },

    // c2s_SendCmdNormalAttack(byte pvpMask), команда 0x03, пакет 3 байта. Стоит сразу за выбором цели.
    // Код: push esi; push 1; call 0x6AFC40; push 3; call alloc ... mov word [esi], 3. Персонаж сам подбегает к цели
    "normalAttack": { "rva": "0x1F0370", "convention": "cdecl", "signature": "56 6A 01 E8 ?? ?? ?? ?? 6A 03 E8 ?? ?? ?? ?? 8B F0 83 C4 08" },

    // c2s_SendCmdPickup(int id, int tid), команда 0x06, пакет 10 байт.
    // К предмету персонаж НЕ подходит: сервер поднимает только в радиусе ~10 м (проверено: 9.8 м да, 10.2 м нет).
    // Единственный вызывающий в клиенте — 0x5CC050 (ограничитель частоты), его вызывает 0x46E930 (логика клиента)
    "pickup": { "rva": "0x1F03B0", "convention": "cdecl", "signature": "56 6A 0A E8 ?? ?? ?? ?? 8B F0 83 C4 04 85 F6 74 2D 8B 44 24 08 8B 4C 24 0C 66 C7 06 06 00 89 46" },

    // c2s_SendCmdUseItem(byte where, byte index, int tid, byte count), команда 0x28, пакет 10 байт:
    // [0x28][where][count][index:2][tid:4]. where 0 = сумка, count 1. Работает и для банок, и для корма пета (пет должен быть призван)
    "useItem": { "rva": "0x1F03F0", "convention": "cdecl", "signature": "56 6A 0A E8 ?? ?? ?? ?? 8B F0 83 C4 04 85 F6 74 3E 8A 44 24 08 8B 54 24 10 66 0F B6 4C 24 0C 66 C7 06 28 00" },

    // c2s_SendCmdCastSkill(int skill, byte pvpMask, int count, int* targets), команда 0x29, пакет 8 + 4*count байт:
    // [0x29][skill:4][pvpMask][count][targets...]. Цель зависит от скилла (проверено тестом):
    //   лечение пета — целью сам пет (без цели сервер не принимает), воскрешение пета — без цели (count 0)
    "castSkill": { "rva": "0x1F0D70", "convention": "cdecl", "signature": "53 8B 5C 24 10 55 56 8D 34 9D 08 00 00 00 56 89 74 24 1C E8 ?? ?? ?? ?? 8B E8 ?? ?? ?? ?? ED 74 45 8B 44 24 10 8A 4C 24 14 66 C7 45 00 29 00 89" },

    // c2s_SendCmdSummonPet(int index), команда 0x64, пакет 6 байт. index = клетка - 1. Призыв идёт ~3.5 с.
    // Найдено по вызовам: клиент перед вызовом берёт пета из [перс+0xE60]+0x10+index*4 и проверяет, что он жив.
    // Рядом: 0x65 @0x5F1F80 — отозвать (без параметров), 0x66 @0x5F1FC0 — отпустить пета (НЕ вызывать), 0x63 — не пет
    "summonPet": { "rva": "0x1F1F40", "convention": "cdecl", "signature": "56 6A 06 E8 ?? ?? ?? ?? 8B F0 83 C4 04 85 F6 74 26 8B 44 24 08 66 C7 06 64 00 89 46" },

    // c2s_SendCmdPetCtrl(int target, int cmd, void* data, int size), команда 0x67, пакет 10 + size байт.
    // Стоит в таблице сразу за командами пета 0x63–0x66. Код: push ebx; push ebp; push esi; mov esi,[esp+1Ch].
    // Номера приказов — по вызовам из клиента (через ограничитель 0x5CC430, вызовы ~0x52DC00–0x52E080):
    //   1 атаковать (data: 1 байт pvpMask, цель — текущая цель персонажа; это Alt+1), 2 следовать/стоять (int),
    //   3 режим агрессии (int 0/1/2), 4 скилл пета (5 байт), 5 ещё один режим (int)
    "petCtrl": { "rva": "0x1F2000", "convention": "cdecl", "signature": "53 55 56 8B 74 24 1C 8D 6E 0A 55 E8" },

    // CECHostPlayer::ApplySkill(int id, bool, int target, int pvp) — то, что делает нажатие кнопки скилла (this = перс).
    // Из интерфейса клиент вызывает (id, 0, 0, -1): цель 0 = текущая цель персонажа, -1 = обычный режим PvP.
    // Если цель дальше дальности скилла — создаёт «подойти к цели» (CECHPWorkTrace, тип 2) с причиной 3 = скилл,
    // дойдя, кастует сам. Проверено в игре: моб в 32 м, подошёл до 18.6 м, применил «Жалящий рой».
    // Лечение пета: (330, 0, WID пета, -1) — проверено. Воскрешению пета дальность не нужна — прямая команда castSkill.
    // Внутри есть особая проверка на ID 167 (Городской портал). Найдено как вызывающий SetTraceTarget(id, 3)
    "hostApplySkill": { "rva": "0x5CC50", "convention": "thiscall", "signature": "53 55 56 57 8B F1 6A 04 E8 ?? ?? ?? ?? 8B 5C 24" },

    // CECHostPlayer::PickupObject(int id, bool gather) — то, что делает клик по предмету на земле (this = перс).
    // Проверяет, что id — предмет (0xC...), что его вид (+0x14C) совпадает с gather (2 = ресурс), создаёт работу
    // «подойти к цели» (CECHPWorkTrace, тип 2) с причиной 1 = подобрать (4 = собрать ресурс) и запускает её.
    // Дойдя (~3 м), клиент сам отправляет c2s_SendCmdPickup. Проверено в игре: подошёл ~6 м и поднял.
    // Как нашли: по RTTI (.?AVCECHPWorkTrace@@) -> vtable -> конструктор -> фабрика работ
    // CECHPWorkMan::CreateWork @0x466C70 (тип 1 идти в точку, 2 подойти к цели, 11 анимация подбора) -> кто создаёт тип 2
    "hostPickupObject": { "rva": "0x62800", "convention": "thiscall", "signature": "53 55 57 8B F9 8B 87 68 06 00 00 C1" },

    // Идти в точку — то, что делает клик по земле (проверено в игре: дошёл до точки, остановился в 0.3 м):
    //   work = WorkMan->CreateWork(1)          0x466C70 (тип 1 = CECHPWorkMove)
    //   work->SetDestination(0, &point)        0x46A890 (0 — точка на земле, 1 — 3D (полёт? не проверено),
    //                                                    2 — НАПРАВЛЕНИЕ: бежит по вектору без остановки, 3 — толчок)
    //   WorkMan->StartWork(1, work, 1, 0)      0x467070
    // WorkMan = [перс+0xE48]. Точка — 3 float: X, высота, Y (как в объекте с +0x3C)
    "workCreate": { "rva": "0x66C70", "convention": "thiscall", "signature": "64 A1 00 00 00 00 6A FF 68 ?? ?? ?? ?? 50 8B 44 24 10 64 89 25 00 00 00 00 56 83 F8 0F 8B ?? ??" },
    "workMoveSetDestination": { "rva": "0x6A890", "convention": "thiscall", "signature": "8B 44 24 08 83 EC 18 53 56 8B 74 24" },
    "workStart": { "rva": "0x67070", "convention": "thiscall", "signature": "8A 44 24 10 53 8B 5C 24 10 55 56 8B" }
  }
}
