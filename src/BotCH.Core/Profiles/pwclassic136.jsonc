/*
  PW Classic 1.3.6 — https://pwclassic.net/, клиент client.exe

  Клиент ветки Comeback: из 15 функций comeback136 9 нашлись ровно в одном месте. Поэтому образец — comeback136.jsonc
  (там подробно, что каждое поле значит). Старый клиент elementclient.exe бот не поддерживает.

  Как переносили (08.10.2026):
    1) функции — по сигнатурам comeback136 (Probe sigcheck --server comeback136);
    2) поля — сопоставлением кода с ElementClient.exe Comeback 1.3.6: функции, одинаковые с точностью до чисел, дают пары
       «старое смещение → новое» (1348 пар функций). В комментарии — «было» в comeback136 и сколько инструкций за это;
    3) каждое поле проверяет Probe port --server pwclassic136: читает живой клиент, где нужно — просит сделать
       действие в игре и смотрит, что изменилось. Что ещё не проверено — помечено «не проверено».

  Проверено на живом клиенте 08.10: всё чтение (перс, мир, сумка, скиллы, пет, каст, копание, корм, полёт, бой мобов),
  все 15 функций найдены по сигнатурам. НЕ проверено: вызовы функций в игре (Probe act), типы хода moveTypes, работа
  свёрнутым и память за долгий фарм.

  exe грузится всегда с 0x400000 (без ASLR), флаг LAA (4 ГБ) стоит. Архивы .pck — стандартные ключи (раздел gameFiles
  не нужен). Античита в процессе нет.
*/
{
  "id": "pwclassic136",
  "name": "PW Classic 1.3.6",

  "base": {
    // game = [база + 0x1C]. Саму базу бот находит в коде клиента (самая читаемая переменная) — в профиле её нет
    "game": "0x1C",
    // Связь с сервером: перед SendGameData код берёт ecx = [[база] + 0x20]
    "session": "0x20",
    // Настройки игры (в них макросы): запуск макроса (hostApplyComboSkill) зовёт разбор макроса, тот читает [[база] + 0x18]
    "configs": "0x18"
  },

  "host": {
    // 0x28 → 0x2C (112 инструкций; 0x28 — 215, но там не перс: vtable 0x100). Ник, уровень 22, HP/MP читаются
    "struct": "0x2C",
    // Ник — как на экране. 0x780 → 0x6C0 (5 инструкций)
    "namePointer": "0x6C0",
    // Байт «кастует» — как в comeback136: запись Probe port 08.10 — 0 → 1 на время каста «Жалящего роя», потом 0
    "castFlag": "0xB8",
    // Весь блок уровень/HP/MP сдвинут на -0x10 (0x4AC → 0x49C, 25 инструкций). Сверено со скриншотом: ур. 22, HP 1001/1001,
    // MP 1068/1068; после каста MP 988 при максимуме 1068 — MP и максимум различены. HP и его максимум (оба 1001) — пока только
    // по сопоставлению. WID 0x15A420 — правдоподобен, не проверен
    "wid": "0x49C",
    "level": "0x4A8",
    "hp": "0x4B0",
    "mp": "0x4B4",
    // 0x524 → 0x4FC (2)
    "maxHp": "0x4FC",
    "maxMp": "0x500",
    // Цель: 0x5A8 → 0x580 (9). Probe port 08.10: выбрал «Шамана пламени» — его WID, снял цель — 0
    "targetId": "0x580",
    // Перезарядка корма, мс: Probe port 08.10 — покормил, скачок вверх и убывает как часы (в comeback136 +0xC84)
    "petFoodCooldown": "0xBC4",
    // Координаты: в памяти (1584.8; 637.9; h 219.6) = на экране 558, 613, высота 21 (карта = (x + 4000) / 10, (y + 5500) / 10)
    "location": "0x3C",
    // Объект кастуемого скилла (там +0x8 = 299), рядом +0x7B0 — цель каста; в конце 0. 0x878 → 0x7AC (сопоставление, 2)
    // и запись Probe port 08.10
    "castingSkill": "0x7AC",
    // Копание — запись Probe port 08.10 (шахта крупного угля, 5 с): «прошло» +0xB1C растёт 0 → 5000 вместе с часами,
    // «всего» +0xB20 = 5000 с начала (оба -0xC0 от comeback136, как и корм); после конца остаются последними.
    // Id ресурса нет: обработчик «начало сбора» (0x3CF940, сообщение 0x7E) пишет его в +0x7C8 только в редкой ветке, обычно
    // заводит работу «сбор» — копает ли, смотрим по ней (gatherWork). +0xE64 — не копание: там то, к чему подходит (моб, монета)
    "gatherTarget": "0x0",
    "gatherElapsed": "0xB1C",
    "gatherTotal": "0xB20",
    // Менеджер петов: 0x1948 → 0x14F0 (4). Probe port: призыв/отзыв видны (клетка и WID пета)
    "petManager": "0x14F0",
    // Менеджер работ: 0x1930 → 0x14D8 (24); его же берёт hostPickupObject (0x3E5150: mov ecx, [edi+0x14D8])
    "workMan": "0x14D8",
    // Сумка: 0x1090 → 0x1078 (33). Probe port: 26 предметов, банки и корм на местах, кирка 3073
    "inventory": "0x1078",
    // Сопоставление не дало; у comeback136 скиллы на +0x14 от менеджера петов — так же и здесь. Проверено: 299 «Жалящий рой»,
    // 328, 329, 330, 167 — названия из configs.pck
    "skills": "0x1504",
    "skillsCount": "0x1508",
    // Где персонаж: 0x790 → 0x6D0 (6). Probe port 08.10: взлёт — 0 → 2
    "moveEnv": "0x6D0"
  },

  // Как в comeback136. Probe port 08.10: призыв — клетка и WID пета, отзыв — обратно
  "petManager": {
    "activeCage": "0x8",
    "cages": "0x10",
    "cageCount": 20,
    "activePetWid": "0x64"
  },

  "pet": {
    "hpRatio": "0x1C",
    "hunger": "0x8",
    "tid": "0xC",
    "essence": "0x190",
    "essenceName": "0x8",
    // Где живёт питомец (0 земля, 1 вода, 2 воздух): живой клиент 08.10 — скорпион 10492 = 0, пчела 10521 = 2; +0x1DC — то же.
    // В comeback136 +0x1E8 — здесь там указатели (без этого поля окно не знает среду и просит номер клетки)
    "essenceInhabit": "0x1D8"
  },

  // Probe port 08.10: мир — game +0x18 (в comeback136 +0x14); в мире менеджеры сдвинуты на +4: мобы +0x24 (в +0x20 здесь
  // игроки), предметы +0x28. Проверено: обход слотов дал ровно счётчик, все объекты рядом с персом, у мобов тип 6/7/9
  "world": {
    "world": "0x18",
    "slotCount": 769,
    "objectInSlot": "0x4",
    "npcs": { "manager": "0x24", "slotArray": "0x20", "count": "0x18" },
    "groundItems": { "manager": "0x28", "slotArray": "0x1C", "count": "0x14" }
  },

  // Probe port 08.10: название (+0x244), расстояние (+0x26C) и запись справочника (+0x384) — сдвиг -0x20..-0x28 от comeback136;
  // названия и уровни как на экране (скриншот владельца). HP (+0x128) — только у цели, у пета 386.
  // Бой — запись 08.10 (все мобы раз в 0,25 с, 200 с), владелец дрался с агрессивными мобами и увёл одного полётом.
  // Сопоставление здесь ошиблось (state +0x31C, цели +0x338/+0x33C — там float)
  "npc": {
    "wid": "0x114",
    "type": "0xB4",
    // Состояние: 1 стоит, 5 идёт, 2 бьёт, 4 мёртв — все четыре видны в записи боя (в comeback136 +0x2DC)
    "state": "0x2B8",
    "hp": "0x128",
    // Общего поля «цель» нет: +0x210 (как в comeback136) всё время боя 0. Бот берёт цель удара
    "target": "0x0",
    // Цель каста: WID перса или пета, пока моб кастует (состояние 3), — сразу за целью удара, как в comeback136 (+0x2F8 → +0x2FC).
    // Как найти: моб кастует в пета — ищем WID пета в мобе; было в каждом снимке каста, цель удара при этом 0
    "castTarget": "0x2D8",
    // Кого бьёт: WID перса (или пета), пока моб бьёт; после отагра остаётся. Рядом +0x2D0 — мс до удара. В comeback136 +0x2F8
    "attackTarget": "0x2D4",
    // У пета то же поле — на кого идёт по приказу: пет в бою — WID моба 102 раза из 148 снимков (+0x2D4 — 67, когда бьёт).
    // У моба здесь WID только во время каста (вне каста — числа вида 0x16D016C), поэтому у мобов — только как цель каста
    "petTarget": "0x2D8",
    "level": "0x120",
    "distance": "0x26C",
    "namePointer": "0x244",
    "location": "0x3C",
    // Указатель на запись справочника: +0x0 — id вида (он же в мобе +0x118)
    "essence": "0x384",
    // «Возвращается»: бит 0x20000 встал, когда перс взлетел на 18 м над мобом (через 4 с), снялся, когда моб ушёл; у мобов,
    // не бивших перса, бит никогда не стоит. +0x224 — копия. В comeback136 +0x22C
    "returning": "0x214",
    "returningFlag": "0x20000"
  },

  // Сумка — как в comeback136, кроме описаний (-0x10): Probe port нашёл по «+0x0 описания = tid предмета».
  // Сверено: банки HP 160/270/410/580 и MP 330/730 с уровнями 12..40, корм — верность 10 и 20
  "inventory": {
    "items": "0xC",
    "size": "0x10",
    "itemCategory": "0x8",
    "itemTid": "0xC",
    "itemCount": "0x14",
    "itemMaxCount": "0x18",
    "itemEssence": "0x60",
    "foodEssence": "0x58",
    "categoryPotion": 9,
    "categoryPetFood": 27
  },

  "potion": {
    "requiredLevel": "0x14C",
    "hp": "0x154",
    "hpSeconds": "0x158",
    "mp": "0x15C",
    "mpSeconds": "0x160"
  },

  // Описание корма в справочнике игры (на него указывает foodEssence предмета): +0x0 tid корма, +0x4 название (UTF-16,
  // 32 символа), +0x148 верность — сколько даёт корм («Чистая вода» 10, «Зеленая трава» 20). Как найти: корм в сумке →
  // описание; название — строка сразу за tid, верность — число из подсказки корма в игре
  "petFood": {
    "loyalty": "0x148",
    "name": "0x4"
  },

  "skill": {
    "id": "0x8",
    "level": "0xC",
    "cooldownLeft": "0x10",
    "cooldownFull": "0x14",
    "flags": "0x18"
  },

  // Макросы персонажа: в настройках игры с +0x129, 8 штук по 0x11 байт — байт иконки (0 — макроса нет) и 8 скиллов по 2 байта
  // (-1 — обычная атака, -2 — повтор). Как найти: функция, которую зовёт запуск макроса, проверяет номер ≤ 7 и копирует
  // [настройки + номер×0x11 + 0x129] — 16 байт и ещё один
  "macros": { "list": "0x129", "size": "0x11", "count": 8 },

  // Данные сервера — те же у pwclassic136 и comeback136
  "gatherTools": [ 3073 ],

  // Копает ли — по работе «сбор» (тип 0xB, байт +0x28 = 1): её заводит обработчик «начало сбора»
  // (0x3CF940: workCreate(0xB), [работа+0x28] = 1, StartWork(1, …)), снимает «конец сбора» (0x7F). Работы у менеджера —
  // списками по уровням: [+0x38] — уровень, у уровня L массив [+L×0x10+8] и число [+L×0x10+0x14] (см. 0x3F1F60). Копание — уровень 1.
  // Живой клиент 08.10: копает — уровень 1, в списке 1 работа типа 0xB с байтом 1; не копает — список пуст
  "gatherWork": { "current": "0x18", "currentCount": "0x24", "type": "0x4", "gather": "0xB", "flag": "0x28" },

  "moveTypes": { "direct": 0, "smart": 5, "fly": 1 },

  "skills": {
    "healPet": 330,
    "revivePet": 329,
    "defaultAttack": 299,
    "notAttack": [ 167, 329, 330 ]
  },

  // Probe port 08.10: название и расстояние +4 от comeback136 — «Каменная шахта», «Агератум», «Молочай», «Монета»;
  // расстояние в памяти = расчёт по координатам
  "groundItem": {
    "id": "0x110",
    "tid": "0x114",
    // Вид — байт: 1 предмет, 2 ресурс, 3 монеты. Следующий байт — что-то другое: у «☆Короны с перьями» и «☆Величественного
    // ожерелья» там 1 (поле целиком 0x101), у остальных вещей 0. Как найти: байт, где у руды 2, у монеты 3, у вещей 1
    "kind": "0x150",
    "distance": "0x15C",
    "namePointer": "0x16C",
    "location": "0x3C"
  },

  // Запись ресурса — без лишних 64 байт Comeback. Сверено на живом клиенте 08.10:
  // «Железная руда» 3079 — кирка 3073, даёт 800, количество 1 (90 %) или 2 (10 %) на +0x168, квеста нет, уровень 1
  "mineEssence": {
    "nameInRecord": "0x8",
    "size": "0x180",
    "id": "0x0",
    "tool": "0x50",
    "materials": "0xE8",
    "materialSlots": 16,
    "amounts": "0x168",
    "quest": "0x178",
    "levelRequired": "0x4C"
  },

  // Записи предметов в справочнике (elements.data), в которых есть тип: указатель на название у предмета на земле
  // (groundItem.namePointer) ведёт внутрь записи, перед названием — tid и тип. Две раскладки: оружие, броня, украшения, банки,
  // материалы — +0x0 tid, +0x4 тип, +0x8 подтип, +0xC название; снаряды — +0x0 tid, +0x4 тип, +0x8 название. Бот пробует обе:
  // годится та, где на месте tid — tid предмета (у другой там чужое число). Сверено на живом клиенте 27.10 — все группы по типу,
  // кроме оружия: «Бивень» 8099 — тип 8077 (материал), «Железная пуля» 1041 — тип 8548 (снаряд), «☆Корона с перьями» — 316.
  // Как найти на другом клиенте:
  // 1. Выложить на землю вещь с типом (оружие, броню или банку) и снаряд. Probe snapshot — их tid в строке «Лут».
  // 2. В elements.data (у Comeback он внутри gamedata.pck, ключи — gameFiles.pck) найти 4 байта tid, за которыми через 8 байт (у
  //    снаряда — через 4) идёт название предмета в UTF-16. Сдвиг названия от tid — nameInRecord, 4 байта сразу за tid — тип. В
  //    памяти клиента запись лежит так же, как в файле.
  // 3. Тип сверить со списками типов (как их найти — у lootGroups): например, 1 — «Мечи», 8548 — «Пуля».
  // 4. После правки Probe snapshot пишет у предмета на земле [группу]. Нет её у предмета из группы — раскладка не та.
  "itemEssences": [
    { "nameInRecord": "0xC", "id": "0x0", "type": "0x4" },
    { "nameInRecord": "0x8", "id": "0x0", "type": "0x4" }
  ],

  // Группы лута — по типу предмета в справочнике (тип читается по itemEssences). Данные игры, одинаковы на трёх серверах.
  // Оружие: мечи, копья, топоры/молоты, дальнобойное, кастеты, бичи, магическое, кинжалы, сферы, сабли, косы (сабли и косы есть
  // только на Comeback). Броня: верх, низ, обувь, голова, наручи, накидка. Украшения: ожерелье, пояс, кольцо. Банки: ЖС, МЭ,
  // ЖС и МЭ, детоксикатор, мгновенное противоядие. Снаряды: стрела, болт, пуля. Предметы ДК — тип материала 8077: подтипы
  // «Особые товары ур.1…10» по 10 предметов (с мобов падают 6), ур.2…9 — квесты «Искатель драконов» 20…91 по описанию предметов
  // (configs.pck → item_ext_desc.txt).
  // Как найти номера типов на другом клиенте: в elements.data списки типов — записи подряд по 68 байт (+0x0 id, +0x4 название
  // UTF-16, 32 символа); у оружия, брони, украшений и банок 4 байта перед первой записью — число записей. Найти в UTF-16 название
  // первой записи, id — 4 байта перед ним: оружие — 1 «Мечи», броня — 125 «Верх», украшения — 171 «Ожерелье», банки — 1794
  // «Восстанавливается ЖС», снаряды — 8546 «Стрела» (на Comeback — «Лук»). Новый тип на сервере — новая запись в том же списке
  // (так нашлись сабля 44878 и коса 44879 на Comeback). Тип ДК — 4 байта за tid в записи любого предмета ДК («Бивень» 8099); в
  // списке типов материалов он называется «Деньги дешевеют, цены падают».
  // Корм пета — списком tid: в его записи типа нет (+0x0 tid, +0x4 название, +0x148 верность, как в petFood; запись 0x168 байт),
  // 16 предметов, одни на трёх серверах. Как найти: в elements.data найти tid 8796, за которым сразу «Чистая вода» в UTF-16, — это
  // первая запись списка корма; 4 байта перед ней — число записей (16), дальше записи подряд по 0x168 байт, tid — первые 4 байта
  // каждой. Проверка: Probe snapshot показывает корм в сумке строкой «корм … (tid …)», на земле — с [Корм пета].
  // Название группы хранится в настройках персонажа — не переименовывать
  "lootGroups": [
    { "name": "Оружие", "types": [ 1, 5, 9, 13, 182, 291, 292, 23749, 25333, 44878, 44879 ] },
    { "name": "Броня", "types": [ 125, 150, 216, 316, 346, 369 ] },
    { "name": "Украшения", "types": [ 171, 234, 247 ] },
    { "name": "Банки", "types": [ 1794, 1802, 1810, 1815, 2038 ] },
    { "name": "Снаряды", "types": [ 8546, 8547, 8548 ] },
    { "name": "Предметы ДК", "types": [ 8077 ] },
    { "name": "Корм пета", "tids": [ 8796, 9757, 9758, 9759, 9760, 9761, 11550, 11551, 11552, 11553, 11554, 11580, 11581, 12842, 18251, 26977 ] }
  ],

  // Как в comeback136, проверено на живом клиенте 08.10: агрессивные 1 (Царь черных гадюк, Нефритовый призрак), мирные 0;
  // радиус 5..6 м. Сопоставление предлагало радиус +0x268 — там 37/33/9, не радиус
  "monsterEssence": {
    "aggressive": "0x2B8",
    "aggroRadius": "0x260"
  },

  // Функции — сигнатуры comeback136 (совпали ровно в одном месте), остальные найдены по коду (08.10, ниже — как).
  // В скобках — адрес в comeback136. Все с тем же числом аргументов, что там
  "functions": {
    // (0x330000) c2s 0x03 — по коду отправки «mov eax, 3 … mov word [esi], ax»; одно место в exe
    "normalAttack": { "rva": "0x3FC8C0", "convention": "stdcall",
                      "signature": "55 8B EC 51 56 68 ?? ?? ?? ?? FF 15 ?? ?? ?? ?? 83 3D ?? ??" },
    // (0x31A720) — сопоставление кода; тот же код, флаги перса +0x74C (там +0x80C), работы +0x14D8
    "hostPickupObject": { "rva": "0x3E5150", "convention": "thiscall", "this": "host",
                          "signature": "55 8B EC 51 53 56 57 8B F9 8B 87 4C" },
