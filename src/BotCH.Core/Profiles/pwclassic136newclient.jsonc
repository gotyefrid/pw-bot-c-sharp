/*
  PW Classic 1.3.6 — новый клиент client.exe (сборка мая 2026)

  Сервер тот же, что pwclassic136.jsonc, но клиент новый — ветки Comeback, не старого PW Classic: из 16 сигнатур
  pwclassic136 не нашлась ни одна, из 15 функций comeback136 9 нашлись ровно в одном месте. Поэтому образец —
  comeback136.jsonc (там подробно, что каждое поле значит). Старый elementclient.exe — профиль pwclassic136.

  Как переносили (08.10.2026):
    1) функции — по сигнатурам comeback136 (Probe sigcheck --server comeback136);
    2) поля — сопоставлением кода с ElementClient.exe Comeback 1.3.6: функции, одинаковые с точностью до чисел, дают пары
       «старое смещение → новое» (1348 пар функций). В комментарии — «было» в comeback136 и сколько инструкций за это;
    3) каждое поле проверяет Probe port --server pwclassic136newclient: читает живой клиент, где нужно — просит сделать
       действие в игре и смотрит, что изменилось. Что ещё не проверено — помечено «не проверено».

  Проверено на живом клиенте 08.10: всё чтение (перс, мир, сумка, скиллы, пет, каст, копание, корм, полёт, бой мобов),
  все 15 функций найдены по сигнатурам, запрещённые — по коду отправки. НЕ проверено: вызовы функций в игре (Probe act),
  цель каста моба (не найдена — мобы не кастовали), типы хода moveTypes, работа свёрнутым и память за долгий фарм.

  exe грузится всегда с 0x400000 (без ASLR), флаг LAA (4 ГБ) стоит. Архивы .pck — стандартные ключи (раздел gameFiles
  не нужен). Античита в процессе нет.
*/
{
  "id": "pwclassic136newclient",
  "name": "PW Classic 1.3.6 (client.exe)",

  "base": {
    // В comeback136 0x8AE5CC: 249 инструкций [0xCAE5CC] → [0xE45740] (база exe 0x400000); его же читает «выход» (0x510550)
    "basePointer": "0xA45740",
    "game": "0x1C",
    // Как у Comeback: работа в фоне своя
    "unfreeze": "0x0",
    // Связь с сервером: «выход» берёт ecx = [[база] + 0x20] перед SendGameData
    "session": "0x20"
  },

  "host": {
    // 0x28 → 0x2C (112 инструкций; 0x28 — 215, но там не перс: vtable 0x100). Ник, уровень 22, HP/MP читаются
    "struct": "0x2C",
    // Ник — как на экране. 0x780 → 0x6C0 (5 инструкций)
    "namePointer": "0x6C0",
    // Байт «кастует» — как в comeback136: запись Probe port 08.10 — 0 → 1 на время каста «Жалящего роя», потом 0
    "castFlag": "0xB8",
    // Весь блок уровень/HP/MP сдвинут на -0x10 (0x4AC → 0x49C, 25 инструкций). Сверено со скриншотом: ур. 22, HP 1001/1001,
    // MP 1068/1068; после каста MP 988 при максимуме 1068 — MP и максимум различены. HP и его максимум (оба 1001) — пока только
    // по сопоставлению. WID 0x15A420 — правдоподобен, не проверен
    "wid": "0x49C",
    "level": "0x4A8",
    "hp": "0x4B0",
    "mp": "0x4B4",
    // 0x524 → 0x4FC (2)
    "maxHp": "0x4FC",
    "maxMp": "0x500",
    // Цель: 0x5A8 → 0x580 (9). Probe port 08.10: выбрал «Шамана пламени» — его WID, снял цель — 0
    "targetId": "0x580",
    // Перезарядка корма, мс: Probe port 08.10 — покормил, скачок вверх и убывает как часы (в comeback136 +0xC84)
    "petFoodCooldown": "0xBC4",
    // Координаты: в памяти (1584.8; 637.9; h 219.6) = на экране 558, 613, высота 21 (карта = (x + 4000) / 10, (y + 5500) / 10)
    "location": "0x3C",
    // Объект кастуемого скилла (там +0x8 = 299), рядом +0x7B0 — цель каста; в конце 0. 0x878 → 0x7AC (сопоставление, 2)
    // и запись Probe port 08.10
    "castingSkill": "0x7AC",
    // Копание — запись Probe port 08.10 (шахта крупного угля, 5 с): «прошло» +0xB1C растёт 0 → 5000 вместе с часами,
    // «всего» +0xB20 = 5000 с начала (оба -0xC0 от comeback136, как и корм); после конца остаются последними.
    // Id ресурса нет: обработчик «начало сбора» (0x3CF940, сообщение 0x7E) пишет его в +0x7C8 только в редкой ветке, обычно
    // заводит работу «сбор» — копает ли, смотрим по ней (gatherWork). +0xE64 — не копание: там то, к чему подходит (моб, монета)
    "gatherTarget": "0x0",
    "gatherElapsed": "0xB1C",
    "gatherTotal": "0xB20",
    // Менеджер петов: 0x1948 → 0x14F0 (4). Probe port: призыв/отзыв видны (клетка и WID пета)
    "petManager": "0x14F0",
    // Менеджер работ: 0x1930 → 0x14D8 (24); его же берёт hostPickupObject (0x3E5150: mov ecx, [edi+0x14D8])
    "workMan": "0x14D8",
    // Сумка: 0x1090 → 0x1078 (33). Probe port: 26 предметов, банки и корм на местах, кирка 3073
    "inventory": "0x1078",
    // Сопоставление не дало; у comeback136 скиллы на +0x14 от менеджера петов — так же и здесь. Проверено: 299 «Жалящий рой»,
    // 328, 329, 330, 167 — названия из configs.pck
    "skills": "0x1504",
    "skillsCount": "0x1508",
    // Где персонаж: 0x790 → 0x6D0 (6). Probe port 08.10: взлёт — 0 → 2
    "moveEnv": "0x6D0"
  },

  // Как в comeback136. Probe port 08.10: призыв — клетка и WID пета, отзыв — обратно
  "petManager": {
    "activeCage": "0x8",
    "cages": "0x10",
    "cageCount": 20,
    "activePetWid": "0x64"
  },

  "pet": {
    "hpRatio": "0x1C",
    "hunger": "0x8",
    "tid": "0xC",
    "essence": "0x190",
    "essenceName": "0x8",
    // Где живёт питомец (0 земля, 1 вода, 2 воздух): живой клиент 08.10 — скорпион 10492 = 0, пчела 10521 = 2; +0x1DC — то же.
    // В comeback136 +0x1E8 — здесь там указатели (без этого поля окно не знает среду и просит номер клетки)
    "essenceInhabit": "0x1D8"
  },

  // Probe port 08.10: мир — game +0x18 (в comeback136 +0x14); в мире менеджеры сдвинуты на +4: мобы +0x24 (в +0x20 здесь
  // игроки), предметы +0x28. Проверено: обход слотов дал ровно счётчик, все объекты рядом с персом, у мобов тип 6/7/9
  "world": {
    "world": "0x18",
    "slotCount": 769,
    "objectInSlot": "0x4",
    "npcs": { "manager": "0x24", "slotArray": "0x20", "count": "0x18" },
    "groundItems": { "manager": "0x28", "slotArray": "0x1C", "count": "0x14" }
  },

  // Probe port 08.10: название (+0x244), расстояние (+0x26C) и запись справочника (+0x384) — сдвиг -0x20..-0x28 от comeback136;
  // названия и уровни как на экране (скриншот владельца). HP (+0x128) — только у цели, у пета 386.
  // Бой — запись 08.10 (все мобы раз в 0,25 с, 200 с), владелец дрался с агрессивными мобами и увёл одного полётом.
  // Сопоставление здесь ошиблось (state +0x31C, цели +0x338/+0x33C — там float)
  "npc": {
    "wid": "0x114",
    "type": "0xB4",
    // Состояние: 1 стоит, 5 идёт, 2 бьёт, 4 мёртв — все четыре видны в записи боя (в comeback136 +0x2DC)
    "state": "0x2B8",
    "hp": "0x128",
    // Общего поля «цель» нет: +0x210 (как в comeback136) всё время боя 0. Бот берёт цель удара
    "target": "0x0",
    // Цель каста не найдена: в записи мобы не кастовали
    "castTarget": "0x0",
    // Кого бьёт: WID перса (или пета), пока моб бьёт; после отагра остаётся. Рядом +0x2D0 — мс до удара. В comeback136 +0x2F8
    "attackTarget": "0x2D4",
    // У пета — на кого идёт по приказу: живой клиент 08.10, пет в бою — WID моба 102 раза из 148 снимков (+0x2D4 — 67, когда бьёт).
    // У мобов здесь не WID (числа вида 0x16D016C) — поэтому только у петов
    "petTarget": "0x2D8",
    "level": "0x120",
    "distance": "0x26C",
    "namePointer": "0x244",
    "location": "0x3C",
    // Указатель на запись справочника: +0x0 — id вида (он же в мобе +0x118)
    "essence": "0x384",
    // «Возвращается»: бит 0x20000 встал, когда перс взлетел на 18 м над мобом (через 4 с), снялся, когда моб ушёл; у мобов,
    // не бивших перса, бит никогда не стоит. +0x224 — копия. В comeback136 +0x22C
    "returning": "0x214",
    "returningFlag": "0x20000"
  },

  // Сумка — как в comeback136, кроме описаний (-0x10): Probe port нашёл по «+0x0 описания = tid предмета».
  // Сверено: банки HP 160/270/410/580 и MP 330/730 с уровнями 12..40, корм — верность 10 и 20
  "inventory": {
    "items": "0xC",
    "size": "0x10",
    "itemCategory": "0x8",
    "itemTid": "0xC",
    "itemCount": "0x14",
    "itemMaxCount": "0x18",
    "itemEssence": "0x60",
    "foodEssence": "0x58",
    "categoryPotion": 9,
    "categoryPetFood": 27
  },

  "potion": {
    "requiredLevel": "0x14C",
    "hp": "0x154",
    "hpSeconds": "0x158",
    "mp": "0x15C",
    "mpSeconds": "0x160"
  },

  "petFood": {
    "loyalty": "0x148"
  },

  "skill": {
    "id": "0x8",
    "level": "0xC",
    "cooldownLeft": "0x10",
    "cooldownFull": "0x14",
    "flags": "0x18"
  },

  // Данные сервера — те же у pwclassic136 и comeback136
  "gatherTools": [ 3073 ],

  // Копает ли — как в старом PW Classic, по работе «сбор» (тип 0xB, байт +0x28 = 1): её заводит обработчик «начало сбора»
  // (0x3CF940: workCreate(0xB), [работа+0x28] = 1, StartWork(1, …)), снимает «конец сбора» (0x7F). Работы у менеджера —
  // списками по уровням: [+0x38] — уровень, у уровня L массив [+L×0x10+8] и число [+L×0x10+0x14] (см. 0x3F1F60). Копание — уровень 1.
  // Живой клиент 08.10: копает — уровень 1, в списке 1 работа типа 0xB с байтом 1; не копает — список пуст
  "gatherWork": { "current": "0x18", "currentCount": "0x24", "type": "0x4", "gather": "0xB", "flag": "0x28" },

  "moveTypes": { "direct": 0, "smart": 5, "fly": 1 },

  "skills": {
    "healPet": 330,
    "revivePet": 329,
    "defaultAttack": 299,
    "notAttack": [ 167, 329, 330 ]
  },

  // Probe port 08.10: название и расстояние +4 от comeback136 — «Каменная шахта», «Агератум», «Молочай», «Монета»;
  // расстояние в памяти = расчёт по координатам
  "groundItem": {
    "id": "0x110",
    "tid": "0x114",
    "kind": "0x150",
    "distance": "0x15C",
    "namePointer": "0x16C",
    "location": "0x3C"
  },

  // Запись ресурса — как в старом PW Classic (pwclassic136), без лишних 64 байт Comeback. Сверено на живом клиенте 08.10:
  // «Железная руда» 3079 — кирка 3073, даёт 800, количество 1 (90 %) или 2 (10 %) на +0x168, квеста нет, уровень 1
  "mineEssence": {
    "nameInRecord": "0x8",
    "size": "0x180",
    "id": "0x0",
    "tool": "0x50",
    "materials": "0xE8",
    "materialSlots": 16,
    "amounts": "0x168",
    "quest": "0x178",
    "levelRequired": "0x4C"
  },

  // Как в comeback136, проверено на живом клиенте 08.10: агрессивные 1 (Царь черных гадюк, Нефритовый призрак), мирные 0;
  // радиус 5..6 м. Сопоставление предлагало радиус +0x268 — там 37/33/9, не радиус
  "monsterEssence": {
    "aggressive": "0x2B8",
    "aggroRadius": "0x260"
  },

  // НИКОГДА не вызывать. Найдено по коду отправки «mov eax, N … mov word [esi], ax» (как в comeback136, только SendGameData
  // здесь rva 0x509480 и с лишними push 0xAF / 0xA9): других мест с 0x01 и 0x66 в exe нет
  "forbiddenFunctions": {
    // c2s 0x01 — выход из игры (в comeback136 0x419D30); читает [0xE45740] — тот же basePointer
    "logout": "0x510550",
    // c2s 0x66 — отпустить пета навсегда (в comeback136 0x2B8810)
    "releasePet": "0x375310"
  },

  // Функции — сигнатуры comeback136 (совпали ровно в одном месте), остальные найдены по коду (08.10, ниже — как).
  // В скобках — адрес в comeback136. Все с тем же числом аргументов, что там
  "functions": {
    // (0x330000) c2s 0x03 — по коду отправки «mov eax, 3 … mov word [esi], ax»; одно место в exe
    "normalAttack": { "rva": "0x3FC8C0", "convention": "stdcall",
                      "signature": "55 8B EC 51 56 68 ?? ?? ?? ?? FF 15 ?? ?? ?? ?? 83 3D ?? ??" },
    // (0x31A720) — сопоставление кода; тот же код, флаги перса +0x74C (там +0x80C), работы +0x14D8
    "hostPickupObject": { "rva": "0x3E5150", "convention": "thiscall", "this": "host",
                          "signature": "55 8B EC 51 53 56 57 8B F9 8B 87 4C" },
    // (0x3CD940) c2s 0x28, cl = где, dl = ячейка — второе место с 0x28 (первое, 0x1B0010, шлёт без аргументов)
    "useItem": { "rva": "0x4B0F30", "convention": "cdecl", "args": [ "tid", "count" ],
                 "registers": { "ecx": "where", "edx": "slot" },
                 "signature": "55 8B EC 53 56 8A F9 8A DA 6A 0A B9" },
    // (0x31E670) c2s 0x64 — функция прямо перед recallPet, начало как там (перс +0x17E4)
    "summonPet": { "rva": "0x3E9120", "convention": "thiscall", "this": "host",
                   "signature": "55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 00 00 00 00 50 51 53 56 57 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3 00 00 00 00 8B F1 8B 8E E4 17" },
    // (0x31E820) c2s 0x65 — сопоставление кода
    "recallPet": { "rva": "0x3E92E0", "convention": "thiscall", "this": "host",
                   "signature": "56 8B F1 8B 8E E4 17 00 00 85 C9 74" },
    // (0x2EF6F0) кнопка «Полёт» — сигнатура comeback136 с +0x17E4 вместо +0x1C04, одно место
    "hostFly": { "rva": "0x3B6B30", "convention": "thiscall", "this": "host", "args": [ "force" ],
                 "signature": "56 8B F1 57 8B 8E E4 17 00 00 85 C9" },
    // (0x31FB40)
    "selectTarget": { "rva": "0x3EA9B0", "convention": "thiscall", "this": "host", "args": [ "wid" ],
                      "signature": "55 8B EC 83 EC 08 53 56 57 6A 12 8B" },
    "unselect": { "rva": "0x3EA9B0", "convention": "thiscall", "this": "host", "args": [ "0" ],
                  "signature": "55 8B EC 83 EC 08 53 56 57 6A 12 8B" },
    // (0x311630)
    "hostApplySkill": { "rva": "0x3DBB90", "convention": "thiscall", "this": "host",
                        "signature": "55 8B EC 83 EC 0C 53 56 57 68 ?? ?? ?? ?? 8B F9" },
    // (0x30A9E0) c2s 0x29
    "castSkill": { "rva": "0x317170", "convention": "thiscall", "this": "session",
                   "signature": "55 8B EC 51 56 8D 45 FC C7 45 FC 29" },
    // (0x1200E0) c2s 0x2A
    "cancelAction": { "rva": "0x14D540", "convention": "thiscall", "this": "session",
                      "signature": "55 8B EC 51 56 8D 45 FC C7 45 FC 2A 00 00 00" },
    // (0x1CDFD0) c2s 0x67
    "petCtrl": { "rva": "0x234BC0", "convention": "thiscall", "this": "session",
                 "signature": "55 8B EC 51 53 56 57 8D 45 FC C7 45" },
    // (0x325F70)
    "workCreate": { "rva": "0x3F0DF0", "convention": "thiscall", "signature": "55 8B EC 8B 45 08 56 8B F1 83 F8 13" },
    // (0x32C070)
    "workMoveSetDestination": { "rva": "0x3F7970", "convention": "thiscall", "args": [ "type", "data" ],
                                "signature": "55 8B EC 83 EC 10 56 8B F1 8B 4D 0C 57 8B 7D 08" },
    // (0x326850)
    "workStart": { "rva": "0x3F1980", "convention": "thiscall", "args": [ "1", "work", "0" ],
                   "signature": "55 8B EC 53 56 57 8B 7D 0C 8B F1 85 FF 74 10 8B" }
  }
}
