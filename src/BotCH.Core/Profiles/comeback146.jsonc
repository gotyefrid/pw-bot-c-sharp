/*
  Comeback PW 1.4.6 — https://comeback.pw/ (свой сервер-аналог, клиент D:\Torrent\Comeback146.pw\element\elementclient.exe)

  Сборка клиента новая (метка в exe — сентябрь 2026), старые смещения Comeback146X.cs из ветки master подходят лишь частично.
  Найдено 02.10.2026 чтением памяти живого клиента (ничего не писалось и не вызывалось). Как искать — см. pwclassic136.jsonc.

  Особенности клиента:
    - exe грузится по случайному адресу (ASLR, видели 0x540000) — все адреса здесь от начала модуля, это не мешает;
    - в exe уже стоит флаг LAA: клиенту доступно 4 ГБ адресов, а не 2, как у PW Classic.

  0 = «ещё не найдено»: поле не читается. Функций пока нет — бот только смотрит, действовать не может.
*/
{
  "id": "comeback146",
  "name": "Comeback 1.4.6",
  "clientProcessName": "elementclient",

  // Архивы .pck (configs.pck → названия скиллов) зашифрованы своими ключами. Найдено в загрузчике .pck клиента (0x9A46E2):
  // ключи лежат в .data (VA 0xCA2468..0xCA2478), версия формата 5 → смещение оглавления ^ 0x9A4E1CB0, хвост за 0x9E82 байт
  // до конца архива. Конец архива записан в заголовке файла — дальше клиент дописывает своё (это читатель .pck учитывает сам)
  "gameFiles": {
    "pck": { "key1": "0x1597270A", "key2": "0x604E0ECB", "offsetKey": "0x9A4E1CB0", "tailSize": "0x9E82" }
  },

  "base": {
    // Найдено перебором .data: [модуль + P] → +0x1C → +0x28 даёт персонажа с ником и координатами. Совпадение одно,
    // проверено после перезапуска клиента. В старом боте было 0x860380 — в этой сборке там уже не указатель
    "basePointer": "0x8EBC1C",
    "game": "0x1C",
    // Не нужен: в настройках клиента есть своя «работа в фоне». Флаг, похоже, +0x4E8 (как в старом 146), но не проверен
    "unfreeze": "0x0",
    // Объект связи с сервером: в нём SendGameData (ecx = [[база]+0x20]) и ограничитель частоты команд (+0x104)
    "session": "0x20"
  },

  "host": {
    "struct": "0x28",
    // Указатель на ник (UTF-16). Старое 0x6F8 — не оно
    "namePointer": "0x788",
    // Байт «персонаж кастует»: два «Исцеления питомца» — дважды 1 на ~2.5 с, и каждый раз MP 130 → 126
    "castFlag": "0xB8",
    // WID: моб, который бьёт персонажа, хранит это число в «цели» (+0x210). После перезахода то же (0x130ECE0).
    // (+0x4C0 рядом — не WID: меняется при перезаходе и не встречается у моба)
    "wid": "0x4B8",
    // Было 2, после роста HP 84 → 108 стало 3 — уровень. Подтвердить по окну игры
    "level": "0x4C4",
    // HP/MP и максимумы: при полной мане MP (+0x4D0) = максимум (+0x534) = 96, HP = максимум = 84
    "hp": "0x4CC",
    "mp": "0x4D0",
    "maxHp": "0x530",
    "maxMp": "0x534",
    // WID выбранного моба: выбрал «Сумеречного жука» — здесь его WID, снял цель — 0
    "targetId": "0x5B4",
    // Перезарядка корма пета, мс осталось: после кормления 0 → ~52500 и убывает 1000/с (найдено сравнением до/после кормления)
    "petFoodCooldown": "0xCB4",
    "location": "0x3C",
    // Найдено по коду клиента: кнопка «призвать/отозвать» (0x33FD20, шлёт c2s 0x64/0x65) берёт пета из [перс + 0x1980].
    // (+0x95C тоже хранит WID пета, но после отзыва не обнуляется — не годится)
    "petManager": "0x1980",
    // CECHPWorkMan — менеджер «работ» (идти, подойти к цели): PickupObject берёт его из [перс + 0x1968]
    "workMan": "0x1968",
    // Сумка: массив указателей на объекты-предметы (у каждого первым полем vtable из .rdata), 32 ячейки, как в 1.3.6.
    // Рядом +0x10C8 — 38 ячеек (похоже, экипировка)
    "inventory": "0x10C4",
    // Массив указателей на объекты скиллов (один класс) и их число: 167, 299, 329, 330 — как у друида в 1.3.6
    "skills": "0x1994",
    "skillsCount": "0x1998"
  },

  // Менеджер петов: [перс + 0x1980]. Проверено призывом/отзывом: призван — +0x8 = 0 и +0x64 = WID (как в игре по d_npcid),
  // отозван — -1 и 0
  "petManager": {
    "activeCage": "0x8",
    // Пет клетки N: [менеджер + 0x10 + (N-1)*4]. Клиент допускает индекс до 20 (cmp ebx, 0x14), берём 20 клеток
    "cages": "0x10",
    "cageCount": 20,
    "activePetWid": "0x64"
  },

  // Пет в клетке. HP — float 0..1: клиент сравнивает его с нулём перед призывом (мёртвого не призывает).
  // Сытость — как в 1.3.6, не сверено (у сытого волка 3)
  "pet": {
    "hpRatio": "0x1C",
    "hunger": "0x8"
  },

  // Мир: [game + 0x14]. Хэш-таблицы как у 1.3.6 (769 ячеек, узел {+0x0 следующий, +0x4 объект, +0x8 id}),
  // но у менеджера мобов всё сдвинуто на 4: счётчик +0x18, число ячеек +0x1C, массив +0x20.
  // У менеджера предметов как у 1.3.6: счётчик +0x14, число ячеек +0x18, массив +0x1C. Обход совпал со счётчиками (75 и 16)
  "world": {
    "world": "0x14",
    "slotCount": 769,
    "objectInSlot": "0x4",
    "npcs": { "manager": "0x20", "slotArray": "0x20", "count": "0x18" },
    "groundItems": { "manager": "0x24", "slotArray": "0x1C", "count": "0x14" }
  },

  // Моб / NPC / пет. Состояние, цель и HP найдены 02.10.2026 в бою: запись полей цели 10 раз в секунду до исчезновения трупа
  "npc": {
    "wid": "0x114",
    // 6 моб, 7 NPC, 9 пет
    "type": "0xB4",
    // Как у 1.3.6: 1 стоит, 5 идёт, 2 бьёт, 4 мёртв (держится ~5 с, пока лежит труп). У живых других мобов 1.
    // Рядом +0x2D4 (старое значение) ведёт себя похоже, но у стоящих мобов там 0
    "state": "0x2DC",
    // Только у выбранной цели: шло 71 → 48 → 25 → 8. По +0x18C лежит максимум (71)
    "hp": "0x128",
    // WID того, кого бьёт моб: сначала персонаж, потом переключился на пета
    "target": "0x210",
    // Заклинатели (Шаман пламени) пока кастуют держат в +0x210 «никого» (-1), а цель каста — здесь: 30 из 30 замеров
    // WID пета, пока шаман кастовал в него. Без этого «сначала тех, кто бьёт меня или пета» шамана не видел
    "castTarget": "0x2FC",
    // Уровень: единственное поле 1..150, одинаковое у мобов одного вида и разное у разных
    // (Сумеречный жук 2, Малая росянка 1, Коза 1, Ястреб 80, Король небесных волков 40)
    "level": "0x120",
    // Сверено с координатами (старое 0x290 у части мобов расходится)
    "distance": "0x294",
    // «Почтовый ящик», «Малая росянка», «Летяга-разбойница»
    "namePointer": "0x26C",
    "location": "0x3C"
  },

  // Сумка: [перс + 0x10C4], +0xC массив, +0x10 число ячеек — как в 1.3.6. Предмет сдвинут на +4:
  // категория 9 — «Малая микстура бодрости» ×5, 27 — корм «Родниковая вода» ×200 (максимум в стопке 1000)
  "inventory": {
    "items": "0xC",
    "size": "0x10",
    "itemCategory": "0x8",
    "itemTid": "0xC",
    "itemCount": "0x14",
    "itemMaxCount": "0x18",
    // Указатель на описание (в нём +0x0 тот же tid). У банки и у корма разные классы предметов
    "itemEssence": "0x78",
    "foodEssence": "0x70",
    "categoryPotion": 9,
    "categoryPetFood": 27
  },

  // Описание банки — как в 1.3.6. Сверено на «Малой микстуре бодрости»: MP 40 за 10 с, HP 0.
  // Поля HP взяты по аналогии (у банки маны там 0) — сверить на банке HP
  "potion": {
    "requiredLevel": "0x14C",
    "hp": "0x154",
    "hpSeconds": "0x158",
    "mp": "0x15C",
    "mpSeconds": "0x160"
  },

  // Описание корма — как в 1.3.6: «Родниковая вода» +0x148 = 10, рядом +0x150 = 16 (вид корма «вода»)
  "petFood": {
    "loyalty": "0x148"
  },

  // Объект скилла — как в 1.3.6. Сверено на «Оживлении питомца»: перезарядка 1000 мс, +0x10 шло 916 → 0, +0x18 = 1 пока идёт
  "skill": {
    "id": "0x8",
    "level": "0xC",
    "cooldownLeft": "0x10",
    "cooldownFull": "0x14",
    "flags": "0x18"
  },

  // ID скиллов друида — те же, что в 1.3.6 (167 «Городской портал»)
  "skills": {
    "healPet": 330,
    "revivePet": 329,
    "defaultAttack": 299,
    "notAttack": [ 167, 329, 330 ]
  },

  // НИКОГДА не вызывать. Вызов по этим адресам блокируется в коде (GameCaller), даже если адрес попадёт в functions.
  // Найдено по таблице отправок: все вызовы SendGameData (rva 0x43E5E0, ecx = [[база]+0x20]) с номером команды перед ними.
  // Других мест, отправляющих 0x01 и 0x66, в exe нет
  "forbiddenFunctions": {
    // c2s 0x01, пакет 6 байт — выход из игры (logout)
    "logout": "0x445A20",
    // c2s 0x66, пакет 6 байт — отпустить пета (пет пропадёт навсегда)
    "releasePet": "0x2D4EB0"
  },

  // Предмет на земле: как у 1.3.6, сдвинуто на +4. Сверено на руде (вид 2), угле (2) и жезле (1)
  "groundItem": {
    "id": "0x110",
    "tid": "0x114",
    "kind": "0x150",
    "distance": "0x158",
    "namePointer": "0x168",
    "location": "0x3C"
  },

  // Функции клиента. Здесь они собраны иначе, чем в 1.3.6: аргументы снимает сама функция (ret N), многие команды
  // отправляются прямо из логики клиента, а не из отдельных c2s_SendCmd*. Номер команды пишется «mov eax, N; mov word [esi], ax».
  // Таблица «команда → откуда отправляется» — по всем вызовам SendGameData (rva 0x43E5E0)
  "functions": {
    // CECHostPlayer::SelectTarget(int id) — то, что делает клик по мобу (this = перс, ret 4). Сама пишет цель в перс +0x5B4
    // и отправляет c2s 0x02 (6 байт); повтор той же цели не шлёт. Перед этим проверяет, можно ли сейчас выбирать (0x73C4F0(0x12))
    "selectTarget": { "rva": "0x3411F0", "convention": "thiscall", "this": "host", "args": [ "wid" ],
                      "signature": "55 8B EC 83 EC 08 53 56 57 6A 12 8B" },
    // Та же функция с id 0 — отправляет c2s 0x08 (снять цель), отдельной функции в клиенте нет
    "unselect": { "rva": "0x3411F0", "convention": "thiscall", "this": "host", "args": [ "0" ],
                  "signature": "55 8B EC 83 EC 08 53 56 57 6A 12 8B" },

    // c2s_SendCmdNormalAttack(byte pvpMask), команда 0x03, пакет 3 байта — как в 1.3.6, только ret 4.
    // Единственное место в exe, где отправляется 0x03. Перед отправкой — критическая секция и необязательный обработчик клиента
    "normalAttack": { "rva": "0x351D30", "convention": "stdcall",
                      "signature": "55 8B EC 83 EC 08 56 68 ?? ?? ?? ?? FF 15 ?? ??" },

    // Отдельной функции «подобрать» (c2s 0x06) в 1.4.6 нет: пакет шлёт работа «подойти к предмету» (CECTracedMatter, vtable[3]
    // @0x353AB0), когда персонаж дошёл. Поэтому подбор — только «как мышкой».
    // CECHostPlayer::PickupObject(int id, bool gather) — this = перс, ret 8. Проверяет id 0xC..., что вид предмета (+0x150, 2 = ресурс)
    // совпадает с gather, и через фабрику работ 0x353180 создаёт «подойти» с причиной 1 (подобрать) или 4 (собрать).
    // Найдено: CECTracedMatter → конструктор/фабрика 0x353180 → её вызывающие с причиной 1/4
    "hostPickupObject": { "rva": "0x33BE00", "convention": "thiscall", "this": "host",
                          "signature": "55 8B EC 51 53 56 57 8B F9 8B 87 14" },

    // CECHostPlayer::ApplySkill(int id, bool, int target, int pvp) — нажатие кнопки скилла, this = перс, ret 0x10.
    // Та же фабрика 0x353180 с причиной 3 (скилл), внутри особая проверка на ID 167 (0xA7, «Городской портал») — как в 1.3.6
    "hostApplySkill": { "rva": "0x3324F0", "convention": "thiscall", "this": "host",
                        "signature": "55 8B EC 83 EC 0C 53 56 57 68 ?? ?? ?? ?? 8B F9" },

    // c2s_SendCmdUseItem, команда 0x28, пакет 10 байт [0x28][where][count][index:2][tid:4] — как в 1.3.6, но часть аргументов
    // в регистрах: cl = where (0 — сумка), dl = ячейка, в стеке tid и count, стек чистит вызывающий (так вызывает клиент: add esp, 8)
    "useItem": { "rva": "0x3F6FD0", "convention": "cdecl", "args": [ "tid", "count" ],
                 "registers": { "ecx": "where", "edx": "slot" },
                 "signature": "55 8B EC 53 56 6A 0A 8A DA 8A F9 FF" },

    // Скилл пакетом, команда 0x29: метод объекта связи (this = [[база]+0x20], ret 0x10), args (skill, pvpMask, —, &цель).
    // Число целей в пакете клиент всегда пишет 1 (третий аргумент не читает), цель — *&цель. Перед отправкой — ограничитель частоты.
    // Вызывают: ApplySkill (особые 167 и 0x720) и логика скилла 0x33B000
    "castSkill": { "rva": "0x32B160", "convention": "thiscall", "this": "session",
                   "signature": "55 8B EC 51 56 8D 45 FC C7 45 FC 29" },

    // c2s_SendCmdPetCtrl(int target, int cmd, void* data, int size), команда 0x67, пакет 10 + size — как в 1.3.6, но метод объекта
    // связи (this = [[база]+0x20], ret 0x10) с ограничителем частоты. Рядом 0x1E3BA0… — готовые приказы с постоянными данными
    "petCtrl": { "rva": "0x1E3820", "convention": "thiscall", "this": "session",
                 "signature": "55 8B EC 51 53 56 57 8D 45 FC C7 45" },

    // Кнопка «призвать пета»: CECHostPlayer::SummonPet(int index), this = перс, ret 4. Пет — [менеджер петов + 0x10 + index*4]
    // (по ней и нашли менеджер). Не призывает мёртвого и неподходящего по уровню, шлёт c2s 0x64.
    // Отзыв (0x65) — отдельная функция 0x33FED0, сюда не входит
    "summonPet": { "rva": "0x33FD20", "convention": "thiscall", "this": "host",
                   "signature": "55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 00 00 00 00 50 53 56 57 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3 00 00 00 00 8B F1 8B 8E 64 1C 00" },

    // Идти в точку — как в 1.3.6: work = WorkMan->CreateWork(1); work->SetDestination(0, &point); WorkMan->StartWork(1, work, 0).
    // Так клиент делает ход с клавиатуры (0x3358D0, там тип 2 — направление); клик по земле (0x31BAC6) — то же, но SetDestination
    // вписан прямо в код. Отличие от 1.3.6 — у StartWork на один аргумент меньше (ret 0xC).
    // CreateWork(type) — switch по 0..0x14, тип 1 = CECHPWorkMove (vtable 0xBFC9DC), ret 4
    "workCreate": { "rva": "0x347A70", "convention": "thiscall", "signature": "55 8B EC 8B 45 08 56 8B F1 83 F8 14 0F 87" },
    // SetDestination(type, &point): пишет точку в +0x20, тип в +0x2C, направление в +0x34 (нормированное), ret 8.
    // Тип 5 — автопуть, как клик по карте (0x31BE0A): работа при первом шаге (0x34E110) строит маршрут от перса до точки
    // (0x357F60, объект маршрута 0xCB9A10) и бежит по нему, обходя препятствия; маршрут не нашёлся — бежит по прямой (тип 0)
    "workMoveSetDestination": { "rva": "0x34DDF0", "convention": "thiscall", "args": [ "5", "data" ],
                                "signature": "55 8B EC 83 EC 10 56 8B F1 8B 4D 0C 57 8B 7D 08" },
    "workStart": { "rva": "0x3484D0", "convention": "thiscall", "args": [ "1", "work", "0" ],
                   "signature": "55 8B EC 53 56 57 8B 7D 0C 8B F1 85 FF 74 10 8B" }
  }
}
