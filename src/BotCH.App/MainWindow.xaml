<Window x:Class="BotCH.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:log="clr-namespace:BotCH.Core.Logging;assembly=BotCH.Core"
        Title="BotCH" Width="440" Height="720" MinWidth="380" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Шапка -->
    <DockPanel Margin="2,0,2,12">
      <Border DockPanel.Dock="Right" VerticalAlignment="Center">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource Chip}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsConnected}" Value="True">
                <Setter Property="Background" Value="#E6F6EE" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="{StaticResource Bad}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource Good}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock Text="{Binding ConnectionText}" FontSize="12" FontWeight="SemiBold" MaxWidth="200" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="BotCH" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="  PW бот" FontSize="13" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
      </StackPanel>
    </DockPanel>

    <!-- Подключение -->
    <Border Grid.Row="1" Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="ПОДКЛЮЧЕНИЕ" Style="{StaticResource CardTitle}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Text="Сервер" Style="{StaticResource Muted}" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" DisplayMemberPath="Name" />

          <TextBlock Grid.Row="2" Text="Клиент" Style="{StaticResource Muted}" VerticalAlignment="Center" />
          <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}" DisplayMemberPath="Display" />
          <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource IconButton}" Margin="6,0,0,0" Content="&#xE72C;"
                  Command="{Binding RefreshCommand}" ToolTip="Обновить список клиентов" />
        </Grid>
        <WrapPanel Margin="0,10,0,0">
          <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RenameWindows}" Content="Окна игры «Ник PID»" Margin="0,4,18,4"
                    ToolTip="Переименовывать окна клиентов в ник персонажа и PID — видно, где кто" />
          <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Unfreeze}" Content="Unfreeze"
                    ToolTip="Клиент не «засыпает», когда окно не в фокусе (раз в секунду пишет флаг в память игры)" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- Персонаж, цель, пет -->
    <Border Grid.Row="2" Style="{StaticResource Card}">
      <StackPanel>
        <DockPanel Margin="0,0,0,8">
          <TextBlock DockPanel.Dock="Right" Text="{Binding HostDetails}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding HostName}" FontSize="15" FontWeight="SemiBold" />
        </DockPanel>

        <Grid Margin="0,0,0,6">
          <ProgressBar Style="{StaticResource Bar}" Foreground="{StaticResource HpBrush}" Value="{Binding HpPercent, Mode=OneWay}" />
          <TextBlock Style="{StaticResource BarText}" Text="{Binding HpText, StringFormat=HP  {0}}" />
        </Grid>
        <Grid>
          <ProgressBar Style="{StaticResource Bar}" Foreground="{StaticResource MpBrush}" Value="{Binding MpPercent, Mode=OneWay}" />
          <TextBlock Style="{StaticResource BarText}" Text="{Binding MpText, StringFormat=MP  {0}}" />
        </Grid>

        <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,12" />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel>
            <TextBlock Text="ЦЕЛЬ" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasTarget}" Value="False">
                      <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding TargetDetails}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Text="ПЕТ" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding PetTitle}" FontWeight="SemiBold" Margin="0,0,0,4">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasPet}" Value="False">
                      <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Grid Visibility="{Binding HasPet, Converter={StaticResource Visible}}">
              <ProgressBar Style="{StaticResource Bar}" Height="16" Foreground="{StaticResource PetBrush}" Value="{Binding PetHpPercent, Mode=OneWay}" />
              <TextBlock Style="{StaticResource BarText}" FontSize="11" Text="{Binding PetHpText}" />
            </Grid>
            <TextBlock Text="{Binding PetDetails}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Бот -->
    <Border Grid.Row="3" Style="{StaticResource Card}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource PrimaryButton}" Content="▶  Старт" Command="{Binding StartCommand}" ToolTip="Ctrl+Alt+Num1" />
          <Button Style="{StaticResource ButtonBase}" Content="■  Стоп" Margin="6,0,0,0" Command="{Binding StopCommand}" ToolTip="Ctrl+Alt+Num0" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
          <TextBlock Text="БОТ" Style="{StaticResource CardTitle}" Margin="0,0,0,2" />
          <TextBlock Text="{Binding BotState}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SnapshotInfo}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Лог -->
    <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0" Padding="0">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="14,10,10,4">
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="26" Height="26" Content="&#xE74D;"
                  Command="{Binding ClearLogCommand}" ToolTip="Очистить лог в окне (файл не трогается)" Background="Transparent" />
          <TextBlock Text="ЛОГ" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
        </DockPanel>
        <ListBox x:Name="LogList" ItemsSource="{Binding Log}" BorderThickness="0" Background="Transparent" Margin="6,0,6,8"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="8,1" />
              <Setter Property="Focusable" Value="False" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type log:LogEntry}">
              <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5">
                <Run Text="{Binding Time, StringFormat=HH:mm:ss, Mode=OneWay}" Foreground="{StaticResource MutedText}" />
                <Run Text="{Binding Source, Mode=OneWay, StringFormat=[{0}]}" Foreground="{StaticResource MutedText}" />
                <Run Text="{Binding Message, Mode=OneWay}">
                  <Run.Style>
                    <Style TargetType="Run">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Level}" Value="Warning">
                          <Setter Property="Foreground" Value="{StaticResource Warn}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="Error">
                          <Setter Property="Foreground" Value="{StaticResource Bad}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="Debug">
                          <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Run.Style>
                </Run>
              </TextBlock>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </Grid>
</Window>
