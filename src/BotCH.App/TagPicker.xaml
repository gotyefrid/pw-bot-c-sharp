<UserControl x:Class="BotCH.App.TagPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <Grid>
    <!-- Выбранное: «чипсы» с крестиком + кнопка «Добавить» -->
    <Border x:Name="Box" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="3" MinHeight="32" Background="White">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource ButtonBase}" Padding="8,3" Margin="3,0,0,0" VerticalAlignment="Top"
                Content="＋ Добавить" Click="OpenDropDown" />
        <Button x:Name="ClearButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="26" Height="26" Margin="3,0,0,0"
                VerticalAlignment="Top" Background="Transparent" Content="&#xE74D;" Click="ClearAll" ToolTip="Убрать всё" Visibility="Collapsed" />
        <Grid>
          <TextBlock x:Name="EmptyHint" Text="{Binding Placeholder, ElementName=Root}" Style="{StaticResource Muted}"
                     VerticalAlignment="Center" Margin="6,0" />
          <ItemsControl x:Name="Chips" ItemsSource="{Binding Selected, ElementName=Root}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="#E8ECFD" CornerRadius="11" Padding="9,2,3,2" Margin="2">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#2A3A8F" />
                    <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9" Width="18" Height="18" Margin="4,0,0,0"
                            Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="#2A3A8F"
                            Tag="{Binding}" Click="RemoveChip" ToolTip="Убрать">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="Body" CornerRadius="9" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Body" Property="Background" Value="#CBD3F7" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </DockPanel>
    </Border>

    <!-- Выпадающий список с поиском -->
    <Popup x:Name="DropDown" PlacementTarget="{Binding ElementName=Box}" Placement="Bottom" StaysOpen="False"
           AllowsTransparency="True" PopupAnimation="Fade" Width="{Binding ActualWidth, ElementName=Box}">
      <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,4,0,8">
        <Border.Effect>
          <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" />
        </Border.Effect>
        <StackPanel>
          <Grid>
            <TextBox x:Name="Search" TextChanged="SearchChanged" PreviewKeyDown="SearchKeyDown" />
            <TextBlock Text="Поиск…" Style="{StaticResource Muted}" Margin="8,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       x:Name="SearchHint" />
          </Grid>
          <ListBox x:Name="OptionList" MaxHeight="240" Margin="0,6,0,0" BorderThickness="0" DisplayMemberPath="Text"
                   PreviewMouseLeftButtonUp="OptionClicked" PreviewKeyDown="OptionsKeyDown" />
          <TextBlock x:Name="NothingHint" Style="{StaticResource Muted}" Margin="6,4" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
