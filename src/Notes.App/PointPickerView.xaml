<UserControl x:Class="Notes.App.PointPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Список сохранённых точек и три кнопки: добавить, изменить, удалить. DataContext — Panels.PointPicker -->
  <StackPanel Orientation="Horizontal">
    <ComboBox Width="150" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" />
    <Button Style="{StaticResource IconButton}" Width="26" Height="26" Margin="6,0,0,0" Content="&#xE710;"
            Command="{Binding AddCommand}" ToolTip="{Binding AddHint}" />
    <Button Style="{StaticResource IconButton}" Width="26" Height="26" Margin="6,0,0,0" Content="&#xE70F;"
            Command="{Binding EditCommand}" ToolTip="Изменить выбранную точку: название и координаты" />
    <Button Style="{StaticResource IconButton}" Width="26" Height="26" Margin="6,0,0,0" Content="&#xE74D;"
            Command="{Binding RemoveCommand}" ToolTip="Удалить выбранную точку" />
  </StackPanel>
</UserControl>
