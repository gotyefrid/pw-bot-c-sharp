<Window x:Class="Notes.App.ComboRowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
  <!-- Правка строки связки скиллов: DataContext — Panels.ComboRowDraft. В строку и файл связок уходит только по «Сохранить» -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ComboTemplates.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="Visible" />
    </ResourceDictionary>
  </Window.Resources>

  <Border Style="{StaticResource Card}" Margin="12">
    <StackPanel>
      <DockPanel Style="{StaticResource SettingRow}">
        <TextBlock Text="Скилл" VerticalAlignment="Center" />
        <ComboBox DockPanel.Dock="Right" Width="300" ItemsSource="{Binding SkillChoices}"
                  SelectedValuePath="Id" SelectedValue="{Binding SelectedSkillId}" ItemTemplate="{StaticResource SkillItem}"
                  ToolTip="Какой скилл жать. Атакующие изученные скиллы персонажа, как в «Атаке»" />
      </DockPanel>

      <TextBlock Text="Условия" Margin="0,6,0,2" />
      <TextBlock Text="Строка подходит, когда выполнены все условия. Нет условий — всегда."
                 TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4" />
      <ItemsControl ItemsSource="{Binding Conditions}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <ComboBox Width="180" ItemsSource="{Binding Checks}" DisplayMemberPath="Title"
                        SelectedValuePath="Check" SelectedValue="{Binding Check}" ToolTip="Что проверяем" />
              <ComboBox Width="50" Margin="6,0,0,0" ItemsSource="{Binding Ops}" DisplayMemberPath="Title"
                        SelectedValuePath="Below" SelectedValue="{Binding Below}"
                        Visibility="{Binding AboutNumber, Converter={StaticResource Visible}}"
                        ToolTip="Меньше или больше числа" />
              <TextBox Style="{StaticResource Number}" Width="60" Margin="6,0,0,0"
                       Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                       Visibility="{Binding AboutNumber, Converter={StaticResource Visible}}"
                       ToolTip="Проценты (HP, MP), метры до моба или секунды боя" />
              <ComboBox Width="232" Margin="6,0,0,0" ItemsSource="{Binding Skills}" ItemTemplate="{StaticResource SkillItem}"
                        SelectedValuePath="Id" SelectedValue="{Binding SkillId}"
                        Visibility="{Binding AboutSkill, Converter={StaticResource Visible}}"
                        ToolTip="Про какой скилл условие" />
              <Button Style="{StaticResource IconButton}" Width="26" Height="26" Margin="6,0,0,0" Content="&#xE711;"
                      Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}" ToolTip="Удалить условие" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Style="{StaticResource ButtonBase}" Content="+ условие" HorizontalAlignment="Left" Margin="0,2,0,0"
              Command="{Binding AddConditionCommand}" ToolTip="Ещё одно условие: строка подойдёт, только когда выполнены все" />

      <CheckBox Style="{StaticResource Switch}" Content="Ждать, если на перезарядке" IsChecked="{Binding WaitReady}" Margin="0,10,0,0">
        <CheckBox.ToolTip>
          <TextBlock MaxWidth="320" TextWrapping="Wrap"
                     Text="Включено — строка в очереди: строки с «ждать» бот жмёт по одной по кругу (1 → 2 → 3 → снова 1). Пока следующая по очереди на перезарядке — ждёт её. Не выполнены её условия — очередь переходит к следующей.&#10;&#10;Выключено — строка жмётся, как только готова и выполнены условия (выше — важнее)." />
        </CheckBox.ToolTip>
      </CheckBox>
      <DockPanel Style="{StaticResource SettingRow}">
        <TextBlock Text="Как часто" VerticalAlignment="Center" />
        <TextBox DockPanel.Dock="Right" Style="{StaticResource Number}" Width="60" Margin="6,0,0,0"
                 Text="{Binding IntervalSeconds, UpdateSourceTrigger=PropertyChanged}"
                 Visibility="{Binding IsInterval, Converter={StaticResource Visible}}"
                 ToolTip="Не чаще раза в столько секунд — и между боями тоже. 1–3600" />
        <ComboBox DockPanel.Dock="Right" Width="140" ItemsSource="{Binding Repeats}" DisplayMemberPath="Title"
                  SelectedValuePath="Repeat" SelectedValue="{Binding SelectedRepeat}"
                  ToolTip="Каждый раз, как дойдёт очередь; один раз за бой с мобом; или не чаще раза в N секунд" />
        <Grid />
      </DockPanel>

      <TextBlock Text="{Binding Error}" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,4,0,0">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Error}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
        <Button Style="{StaticResource ButtonBase}" Content="Отмена" IsCancel="True" Margin="0,0,8,0" />
        <Button Style="{StaticResource PrimaryButton}" Content="Сохранить" IsDefault="True" Click="Save" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
