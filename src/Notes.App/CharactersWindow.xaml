<Window x:Class="Notes.App.CharactersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Персонажи" Width="760" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </Window.Resources>
  <!-- Список персонажей: DataContext — Panels.CharactersPanel. «Открыть» запускает клиент, входит и подключает бота -->
  <Border Style="{StaticResource Card}" Margin="12">
    <StackPanel>
      <TextBlock Text="ПЕРСОНАЖИ" Style="{StaticResource CardTitle}" />
      <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="«Открыть» запускает клиент, входит персонажем и подключает к нему бота. Класс и уровень — какими бот видел персонажа последний раз." />
      <ListView Height="240" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent"
                MouseDoubleClick="OpenRow" KeyDown="RowKey">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="ToolTip" Value="{Binding Hint}" />
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.View>
          <GridView>
            <GridViewColumn Header="Сервер" Width="150" DisplayMemberBinding="{Binding ServerName}" />
            <GridViewColumn Header="Ник" Width="150" DisplayMemberBinding="{Binding Nick}" />
            <GridViewColumn Header="Класс" Width="90" DisplayMemberBinding="{Binding ClassText}" />
            <GridViewColumn Header="Ур." Width="44" DisplayMemberBinding="{Binding LevelText}" />
            <GridViewColumn Header="Комментарий" Width="250">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding CommentLine}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>
      <TextBlock Text="Список пуст — нажмите «Добавить»." Style="{StaticResource Muted}" Margin="0,6,0,0"
                 Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
      <DockPanel Margin="0,10,0,0">
        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Открыть" Margin="6,0,0,0"
                Command="{Binding OpenCommand}" ToolTip="Запустить клиент, войти этим персонажем и подключить бота" />
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource ButtonBase}" Content="Добавить" Command="{Binding AddCommand}" />
          <Button Style="{StaticResource ButtonBase}" Content="Изменить" Margin="6,0,0,0" Command="{Binding EditCommand}" />
          <Button Style="{StaticResource ButtonBase}" Content="Удалить" Margin="6,0,0,0" Command="{Binding RemoveCommand}" />
        </StackPanel>
      </DockPanel>
    </StackPanel>
  </Border>
</Window>
