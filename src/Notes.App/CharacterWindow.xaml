<Window x:Class="Notes.App.CharacterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Notes.App"
        Title="{Binding Title}" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
  <Window.Resources>
    <!-- Подсказка про пароль — только у старого персонажа (у нового пароль обязателен) -->
    <local:InverseVisibilityConverter x:Key="Hidden" />
  </Window.Resources>
  <!-- Правка персонажа: DataContext — Panels.CharacterDraft. В список уходит только по «Сохранить» -->
  <Border Style="{StaticResource Card}" Margin="12">
    <StackPanel>
      <DockPanel Style="{StaticResource SettingRow}">
        <TextBlock Text="Сервер" VerticalAlignment="Center" />
        <ComboBox DockPanel.Dock="Right" Width="260" ItemsSource="{Binding Servers}" SelectedItem="{Binding Server}"
                  DisplayMemberPath="Name" />
      </DockPanel>
      <DockPanel Style="{StaticResource SettingRow}">
        <TextBlock Text="Клиент" VerticalAlignment="Center" />
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Margin="6,0,0,0"
                Command="{Binding ClearExeCommand}" ToolTip="Запускать «Игру» сервера" />
        <Button DockPanel.Dock="Right" Style="{StaticResource ButtonBase}" Content="Выбрать…" Margin="6,0,0,0" Click="ChooseExe"
                ToolTip="Exe клиента для этого персонажа, если не «Игра» сервера" />
        <TextBlock Text="{Binding ExeText}" ToolTip="{Binding ExeText}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Margin="10,0,0,0" />
      </DockPanel>
      <DockPanel Style="{StaticResource SettingRow}">
        <TextBlock Text="Логин" VerticalAlignment="Center" />
        <TextBox DockPanel.Dock="Right" Width="260" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />
      </DockPanel>
      <DockPanel Style="{StaticResource SettingRow}">
        <TextBlock Text="Пароль" VerticalAlignment="Center" />
        <PasswordBox x:Name="PasswordInput" DockPanel.Dock="Right" Width="260" PasswordChanged="PasswordEdited" Height="28"
                     Padding="6,0" VerticalContentAlignment="Center" BorderBrush="{StaticResource CardBorder}" />
      </DockPanel>
      <TextBlock Text="{Binding PasswordHint}" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" Margin="0,-2,0,2"
                 Visibility="{Binding IsNew, Converter={StaticResource Hidden}}" />
      <DockPanel Style="{StaticResource SettingRow}">
        <TextBlock Text="Ник" VerticalAlignment="Center" />
        <TextBox DockPanel.Dock="Right" Width="260" Text="{Binding Nick, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Как в игре: им клиент входит и по нему бот узнаёт персонажа" />
      </DockPanel>
      <TextBlock Text="Комментарий" Margin="0,4,0,4" />
      <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
               Height="64" Padding="4" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" ToolTip="Что угодно о персонаже — для себя" />
      <TextBlock Text="Пароль хранится зашифрованным: прочитать его можно только под вашей учётной записью Windows."
                 Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
      <TextBlock Text="{Binding Error}" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,6,0,0">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Error}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
        <Button Style="{StaticResource ButtonBase}" Content="Отмена" IsCancel="True" />
        <Button Style="{StaticResource PrimaryButton}" Content="Сохранить" Margin="6,0,0,0" IsDefault="True" Click="SaveClick" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
