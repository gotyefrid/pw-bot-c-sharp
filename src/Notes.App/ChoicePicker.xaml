<UserControl x:Class="Notes.App.ChoicePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <Grid>
    <!-- Выбранное — как у выпадающего списка: щелчок или начать печатать — список с поиском -->
    <Button x:Name="Box" Height="30" Cursor="Hand" FocusVisualStyle="{x:Null}" Click="BoxClicked" PreviewKeyDown="BoxKeyDown"
            PreviewTextInput="BoxTextInput">
      <Button.Template>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Body" Background="White" BorderBrush="#ACACAC" BorderThickness="1" Padding="8,0,6,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="6,0,0,0"
                         VerticalAlignment="Center" Foreground="{StaticResource MutedText}" />
              <ContentPresenter VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource Accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Button.Template>
      <TextBlock x:Name="Shown" TextTrimming="CharacterEllipsis" />
    </Button>

    <Popup x:Name="DropDown" PlacementTarget="{Binding ElementName=Box}" Placement="Bottom" StaysOpen="False"
           AllowsTransparency="True" PopupAnimation="Fade" MinWidth="{Binding ActualWidth, ElementName=Box}"
           Opened="DropDownOpened" Closed="DropDownClosed">
      <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,4,0,8">
        <Border.Effect>
          <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" />
        </Border.Effect>
        <StackPanel>
          <Grid>
            <TextBox x:Name="Search" TextChanged="SearchChanged" PreviewKeyDown="SearchKeyDown" />
            <TextBlock x:Name="SearchHint" Text="Поиск…" Style="{StaticResource Muted}" Margin="8,0" VerticalAlignment="Center"
                       IsHitTestVisible="False" />
          </Grid>
          <ListBox x:Name="OptionList" MaxHeight="300" Margin="0,6,0,0" BorderThickness="0" DisplayMemberPath="Text"
                   PreviewMouseLeftButtonUp="OptionClicked" PreviewKeyDown="OptionsKeyDown" />
          <TextBlock x:Name="NothingHint" Text="Ничего не найдено" Style="{StaticResource Muted}" Margin="6,4" Visibility="Collapsed" />
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
