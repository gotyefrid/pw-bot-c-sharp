<Window x:Class="Notes.App.LogFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фильтры лога" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
  <!-- Что показывать в логе окна: DataContext — LogPanel. Переключили — лог сразу перестраивается и выбор сохраняется -->
  <Border Style="{StaticResource Card}" Margin="12">
    <StackPanel>
      <TextBlock Text="ЧТО ПОКАЗЫВАТЬ В ЛОГЕ" Style="{StaticResource CardTitle}" />
      <CheckBox Style="{StaticResource Switch}" Content="Только важное" IsChecked="{Binding OnlyImportantLog}" Margin="0,0,0,10"
                ToolTip="Только предупреждения и ошибки — из тех, что включены ниже" />
      <ItemsControl ItemsSource="{Binding Sources}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,6">
              <CheckBox Style="{StaticResource Switch}" Content="{Binding Title}" IsChecked="{Binding Shown}" />
              <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="В файл лога пишется всё." Style="{StaticResource Muted}" Margin="0,4,0,0" />
      <Button Style="{StaticResource PrimaryButton}" Content="Готово" HorizontalAlignment="Right" Margin="0,10,0,0"
              IsCancel="True" Click="Done" ToolTip="Выбор уже сохранён — просто закрыть" />
    </StackPanel>
  </Border>
</Window>
