<Window x:Class="Notes.App.ComboWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Связка скиллов" Width="820" Height="560" MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
  <!-- Связка скиллов: DataContext — Panels.ComboPanel. Строка правится в своём окне (ComboRowWindow) — двойной щелчок или
       карандаш. Правки сразу уходят в общий файл связок и персонажу — «Готово» только закрывает -->
  <Window.Resources>
    <ResourceDictionary Source="ComboTemplates.xaml" />
  </Window.Resources>

  <Border Style="{StaticResource Card}" Margin="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,8"
                 Text="Бот смотрит строки сверху вниз и жмёт первую, у которой выполнены все условия. Выключенные строки и не изученные скиллы пропускаются. Двойной щелчок по строке или карандаш — правка: скилл, условия, «ждать», как часто. Связки общие: их видят все персонажи во всех копиях бота." />
      <DockPanel Grid.Row="1" Margin="0,0,0,8">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <ComboBox Width="240" ItemsSource="{Binding Combos}" SelectedItem="{Binding SelectedCombo}"
                    ToolTip="Какой связкой бьёт этот персонаж. В скобках — сколько строк" />
          <Button Style="{StaticResource IconButton}" Width="26" Height="26" Margin="6,0,0,0" Content="&#xE710;"
                  Command="{Binding AddComboCommand}" ToolTip="Новая пустая связка — сразу выбирается" />
          <Button Style="{StaticResource IconButton}" Width="26" Height="26" Margin="6,0,0,0" Content="&#xE8C8;"
                  Command="{Binding CopyComboCommand}" ToolTip="Копия выбранной связки — сразу выбирается, её можно менять, не трогая исходную" />
          <Button Style="{StaticResource IconButton}" Width="26" Height="26" Margin="6,0,0,0" Content="&#xE70F;"
                  Command="{Binding RenameComboCommand}" ToolTip="Переименовать выбранную связку" />
          <Button Style="{StaticResource IconButton}" Width="26" Height="26" Margin="6,0,0,0" Content="&#xE74D;"
                  Command="{Binding RemoveComboCommand}" ToolTip="Удалить выбранную связку — у всех персонажей (бот сначала спросит)" />
        </StackPanel>
        <TextBlock Text="Связка" VerticalAlignment="Center" />
      </DockPanel>

      <ListView x:Name="Table" Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="EditRow" SizeChanged="TableSized"
                BorderThickness="0" Background="Transparent">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Missing}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource MutedText}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Enabled}" Value="False">
                <Setter Property="Foreground" Value="{StaticResource MutedText}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.View>
          <GridView>
            <GridViewColumn Header="№" Width="34" DisplayMemberBinding="{Binding Number}" />
            <GridViewColumn Header="Вкл" Width="40">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding Enabled}" ToolTip="Выключенную строку бот пропускает, как будто её нет" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Скилл" Width="200">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding Icon}" Style="{StaticResource SkillIcon}" />
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                  </StackPanel>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <!-- Ширина — всё, что осталось от других колонок (TableSized); длинные условия переносятся -->
            <GridViewColumn x:Name="WhenColumn" Header="Когда" Width="300">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding When}" TextWrapping="Wrap" VerticalAlignment="Center" ToolTip="{Binding When}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Как часто" Width="100" DisplayMemberBinding="{Binding RepeatText}" />
            <GridViewColumn Header="Ждать" Width="55">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding WaitText}"
                             ToolTip="«да» — условия выполнены, а скилл на перезарядке: бот ждёт его и строки ниже не смотрит" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>
      <DockPanel Grid.Row="3" Margin="0,8,0,0">
        <Button DockPanel.Dock="Right" Style="{StaticResource ButtonBase}" Content="Удалить" Margin="6,0,0,0"
                Command="{Binding RemoveRowCommand}" ToolTip="Удалить выбранную строку" />
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE70F;" Margin="6,0,0,0"
                Command="{Binding EditRowCommand}" ToolTip="Изменить выбранную строку: скилл, условия, «ждать», как часто" />
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE70D;" Margin="6,0,0,0"
                Command="{Binding RowDownCommand}" ToolTip="Ниже: бот проверит строку позже" />
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE70E;" Margin="6,0,0,0"
                Command="{Binding RowUpCommand}" ToolTip="Выше: бот проверит строку раньше" />
        <Button Style="{StaticResource ButtonBase}" Content="+ скилл" HorizontalAlignment="Left"
                Command="{Binding AddRowCommand}"
                ToolTip="Новая строка в конце связки. Скиллы — изученные у персонажа; не в игре — только те, что уже есть в связке" />
      </DockPanel>

      <Button Grid.Row="4" Style="{StaticResource PrimaryButton}" Content="Готово" HorizontalAlignment="Right" Margin="0,12,0,0"
              IsCancel="True" Click="Done" ToolTip="Правки уже сохранены — просто закрыть" />
    </Grid>
  </Border>
</Window>
