<Window x:Class="Notes.App.NameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
  <!-- Ввести название (маршрута): «Сохранить» — название, «Отмена» — ничего -->
  <Border Style="{StaticResource Card}" Margin="12">
    <StackPanel>
      <DockPanel Style="{StaticResource SettingRow}">
        <TextBlock Text="Название" VerticalAlignment="Center" />
        <TextBox x:Name="NameBox" DockPanel.Dock="Right" Width="200" />
      </DockPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
        <Button Style="{StaticResource ButtonBase}" Content="Отмена" IsCancel="True" Margin="0,0,8,0" />
        <Button Style="{StaticResource PrimaryButton}" Content="Сохранить" IsDefault="True" Click="Save" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
