<Project Sdk="Microsoft.NET.Sdk">
  <!-- Окно бота (WPF). Только отображение состояния и редактирование настроек -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>Notes.App</RootNamespace>
    <AssemblyName>Notes</AssemblyName>
    <!-- Свой Main: сначала загрузчик вшитых dll, потом WPF -->
    <StartupObject>Notes.App.Program</StartupObject>
    <!-- Иконка exe и окна: синяя «B» с оранжевой точкой -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Notes.Core\Notes.Core.csproj" />
  </ItemGroup>

  <!--
    Один exe: dll-зависимости (Notes.Core, Newtonsoft.Json) вшиваются ресурсами и рядом не копируются.
    Загружает их EmbeddedAssemblies. Без Fody/Costura.
  -->
  <Target Name="EmbedReferencedAssemblies" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_BotDependency Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll'" />
      <EmbeddedResource Include="@(_BotDependency)">
        <LogicalName>%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" />
    </ItemGroup>
  </Target>

  <!--
    Флаг «большие адреса» (IMAGE_FILE_LARGE_ADDRESS_AWARE, 0x20 в Characteristics заголовка COFF): 32-битному процессу в 64-битной
    Windows дают 4 ГБ адресов вместо 2. Вкладки — несколько персонажей в одном процессе: снимки, иконки, логи каждого.
    Без editbin (его нет без Visual Studio): ставим бит сами, в exe в obj — до копирования в bin. Уже стоит — файл не трогаем.
  -->
  <UsingTask TaskName="SetLargeAddressAware" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <File ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var bytes = System.IO.File.ReadAllBytes(File);
        var pe = System.BitConverter.ToInt32(bytes, 0x3C);
        if (bytes[pe] != (byte)'P' || bytes[pe + 1] != (byte)'E')
        {
            Log.LogError("Не PE-файл: " + File);
            return false;
        }
        // Сигнатура «PE\0\0» (4) + Machine, NumberOfSections, TimeDateStamp, PointerToSymbolTable, NumberOfSymbols,
        // SizeOfOptionalHeader (2+2+4+4+4+2 = 18) — дальше Characteristics
        var characteristics = pe + 4 + 18;
        if ((bytes[characteristics] & 0x20) == 0)
        {
            bytes[characteristics] |= 0x20;
            System.IO.File.WriteAllBytes(File, bytes);
            Log.LogMessage(MessageImportance.Normal, "LargeAddressAware: " + File);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="LargeAddressAware" AfterTargets="CoreCompile" Condition="Exists('@(IntermediateAssembly)')">
    <SetLargeAddressAware File="@(IntermediateAssembly->'%(FullPath)')" />
  </Target>
</Project>
