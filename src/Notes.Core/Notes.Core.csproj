<Project Sdk="Microsoft.NET.Sdk">
  <!-- Вся логика бота без интерфейса: память, профили серверов, снимок мира, действия, мозг, настройки, лог -->
  <PropertyGroup>
    <RootNamespace>Notes.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Notes.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Профили серверов вшиваются в сборку: бот — один exe -->
    <EmbeddedResource Include="Profiles\*.jsonc" />
    <!-- Свой справочник мест мобов, NPC и ресурсов (coord_data.txt Comeback 1.4.6, gzip) — на случай, когда в клиенте его нет -->
    <EmbeddedResource Include="GameFiles\Data\coord_data.txt.gz" LogicalName="Notes.Core.GameFiles.coord_data.txt.gz" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Шифрование паролей персонажей средствами Windows (ProtectedData) -->
    <Reference Include="System.Security" />
  </ItemGroup>
</Project>
