  "base": {
    // game = [база + 0x1C]. Саму базу бот находит в коде клиента (самая читаемая переменная) — в профиле её нет
    "game": "0x1C",
    // Связь с сервером: перед SendGameData код берёт ecx = [[база] + 0x20]
    "session": "0x20",
    // Настройки игры (в них макросы): запуск макроса (hostApplyComboSkill) зовёт разбор макроса, тот читает [[база] + 0x18]
    "configs": "0x18"
  },

  "host": {
    // 0x28 → 0x2C (112 инструкций; 0x28 — 215, но там не перс: vtable 0x100). Ник, уровень 22, HP/MP читаются
    "struct": "0x2C",
    // Ник — как на экране. 0x780 → 0x6C0 (5 инструкций)
    "namePointer": "0x6C0",
    // Байт «кастует» — как в comeback136: запись Probe port 08.10 — 0 → 1 на время каста «Жалящего роя», потом 0.
    // При касте пакетом (castSkill) остаётся 0: Probe act pet-revive — весь каст 0, а castingSkill = 329
    "castFlag": "0xB8",
    // Весь блок уровень/HP/MP сдвинут на -0x10 (0x4AC → 0x49C, 25 инструкций). Сверено со скриншотом: ур. 22, HP 1001/1001,
    // MP 1068/1068; после каста MP 988 при максимуме 1068 — MP и максимум различены. HP и его максимум (оба 1001) — пока только
    // по сопоставлению. WID 0x15A420 — правдоподобен, не проверен
    "wid": "0x49C",
    "level": "0x4A8",
    "hp": "0x4B0",
    "mp": "0x4B4",
    // 0x524 → 0x4FC (2)
    "maxHp": "0x4FC",
    "maxMp": "0x500",
    // Опыт на текущем уровне (int) — сразу за MP, как в Comeback (как найти — в comeback146.jsonc). Проверено 03.11: перс 46 ур.
    // убил моба — 55628 → 55824, как в окне игры
    "exp": "0x4B8",
    // Таблица «опыт до следующего уровня» — тот же код окна персонажа, что в Comeback, с уровнем перса +0x4A8; одно место в exe.
    // Проверено 03.11: в таблице 0, 55, 220, 495, 880, 1400…, для 46 ур. — 194350
    "expTableFind": "8B 86 A8 04 00 00 FF 34 85 ?? ?? ?? ?? 8D 85 F0 FB FF FF",
    "expTableAt": "0x9",
    // Цель: 0x5A8 → 0x580 (9). Probe port 08.10: выбрал «Шамана пламени» — его WID, снял цель — 0
    "targetId": "0x580",
    // Перезарядка корма, мс: Probe port 08.10 — покормил, скачок вверх и убывает как часы (в comeback136 +0xC84)
    "petFoodCooldown": "0xBC4",
    // Координаты: в памяти (1584.8; 637.9; h 219.6) = на экране 558, 613, высота 21 (карта = (x + 4000) / 10, (y + 5500) / 10)
    "location": "0x3C",
    // Объект кастуемого скилла (там +0x8 = 299), рядом +0x7B0 — цель каста; в конце 0. 0x878 → 0x7AC (сопоставление, 2)
    // и запись Probe port 08.10
    "castingSkill": "0x7AC",
    // Копание — запись Probe port 08.10 (шахта крупного угля, 5 с): «прошло» +0xB1C растёт 0 → 5000 вместе с часами,
    // «всего» +0xB20 = 5000 с начала (оба -0xC0 от comeback136, как и корм); после конца остаются последними.
    // Id ресурса нет: обработчик «начало сбора» (0x3CF940, сообщение 0x7E) пишет его в +0x7C8 только в редкой ветке, обычно
    // заводит работу «сбор» — копает ли, смотрим по ней (gatherWork). +0xE64 — не копание: там то, к чему подходит (моб, монета)
    "gatherTarget": "0x0",
    "gatherElapsed": "0xB1C",
    "gatherTotal": "0xB20",
    // Менеджер петов: 0x1948 → 0x14F0 (4). Probe port: призыв/отзыв видны (клетка и WID пета)
    "petManager": "0x14F0",
    // Менеджер работ: 0x1930 → 0x14D8 (24); его же берёт hostPickupObject (0x3E5150: mov ecx, [edi+0x14D8])
    "workMan": "0x14D8",
    // Сумка: 0x1090 → 0x1078 (33). Probe port: 26 предметов, банки и корм на местах, кирка 3073
    "inventory": "0x1078",
    // Банк (хранилище), основная вкладка: контейнер с тем же устройством, что сумка; заполняется, когда банк открыт (у банкира).
    // Найдено по коду клиента: функция «контейнер по номеру» (0x3D9DE0, switch по where: 0 — сумка +0x1078, 3 — банк +0x10B4,
    // 4 и 5 — дополнительные вкладки +0x10B8 и +0x10BC), её вызывает c2s-функция переноса bankExchange
    "bank": "0x10B4",
    // Надетые вещи: контейнер с тем же устройством, что сумка, ячейка — место. Как найти на другом клиенте: обработчик кнопки
    // «Починить все» лавки (команда «repairall» окна Win_Shop) берёт это поле перса и зовёт проверку «есть что чинить»
    // (подробно — в comeback136.jsonc). Проверено чтением живого клиента: оружие, броня, украшения на местах
    "equipment": "0x107C",
    // Ячейка полётника (крылья, меч) в надетых вещах ("equipment"): есть в ней вещь — бот взлетает, нет — даже не пробует.
    // Как найти на другом клиенте: надеть полётник, Probe snapshot — «надето», место с ним. Проверено в игре на всех трёх: 12
    "flyerSlot": 12,
    // Сумка заданий: как найти, см. comeback146.jsonc. Не проверено
    "questItems": "",
    // Объект заданий (CECTaskInterface, первым полем vtable): +4 — сам перс, +8 — список принятых заданий (см. "quests").
    // Как найти на другом клиенте: поле перса с объектом, у которого [+4] = перс, а [+8] — список, первый байт которого — число
    // записей; в коде — функция окна заданий (рядом push строки "Btn_TreasureMap") берёт его из [[game+0x2C] + смещение]
    "quests": "0x14E0",
    // Сопоставление не дало; у comeback136 скиллы на +0x14 от менеджера петов — так же и здесь. Проверено: 299 «Жалящий рой»,
    // 328, 329, 330, 167 — названия из configs.pck
    "skills": "0x1504",
    "skillsCount": "0x1508",
    // Где персонаж: 0x790 → 0x6D0 (6). Probe port 08.10: взлёт — 0 → 2
    "moveEnv": "0x6D0"
  },

  // Как в comeback136. Probe port 08.10: призыв — клетка и WID пета, отзыв — обратно
  "petManager": {
    "activeCage": "0x8",
    "cages": "0x10",
    "cageCount": 20,
    "activePetWid": "0x64"
  },

  "pet": {
    "hpRatio": "0x1C",
    "hunger": "0x8",
    "tid": "0xC",
    "essence": "0x190",
    "essenceName": "0x8",
    // Где живёт питомец (0 земля, 1 вода, 2 воздух): живой клиент 08.10 — скорпион 10492 = 0, пчела 10521 = 2; +0x1DC — то же.
    // В comeback136 +0x1E8 — здесь там указатели (без этого поля окно не знает среду и просит номер клетки)
    "essenceInhabit": "0x1D8",
    // HP пета в единицах игра не хранит — его считает окно пета (CDlgPetDetail): макс = (int)((уровень − levelRequire × hpB + hpC)
    // × hpA), всё во float; сейчас = (int)(макс × доля HP). Уровень — в данных пета (level), остальное — в записи справочника:
    // +0x150 int, +0x158, +0x15C, +0x160 float. Как найти: в функции окна с L"%d/%d" — умножение на долю HP (+0x1C), а перед ним
    // эти четыре поля записи и уровень пета. Проверено: скорпион ур. 37 — 1067, как в окне пета
    "level": "0x24",
    "essenceLevelRequire": "0x150",
    "essenceHpA": "0x158",
    "essenceHpB": "0x15C",
    "essenceHpC": "0x160"
  },

  // Probe port 08.10: мир — game +0x18 (в comeback136 +0x14); в мире менеджеры сдвинуты на +4: мобы +0x24 (в +0x20 здесь
  // игроки), предметы +0x28. Проверено: обход слотов дал ровно счётчик, все объекты рядом с персом, у мобов тип 6/7/9
  "world": {
    "world": "0x18",
    "slotCount": 769,
    "objectInSlot": "0x4",
    "npcs": { "manager": "0x24", "slotArray": "0x20", "count": "0x18" },
    "groundItems": { "manager": "0x28", "slotArray": "0x1C", "count": "0x14" },
    // Другие игроки: [мир + 0x20], раскладка менеджера как у мобов (счётчик +0x18, 769 ячеек +0x1C, массив +0x20), в узле
    // +0x8 — WID. Как найти: соседний с мобами менеджер мира, где обход даёт объекты с ником по смещению ника перса.
    // Проверено 31.10 в людном месте: обход совпал со счётчиком (18), ники и расстояния — как вокруг перса
    "players": { "manager": "0x20", "slotArray": "0x20", "count": "0x18" }
  },

  // Удары: кто, кого, сколько урона — менеджер атак мира (CECAttacksMan, имя класса есть в exe). Игра кладёт туда каждый удар
  // и скилл по цели, когда пришёл ответ сервера, и убирает после попадания (живёт 0,4…2 с) — читать раз в 250 мс хватает.
  // Как найти: строка «CECAttacksMan::CECAttacksMan(), failed to load multi skill sgc config file» — в конструкторе; его зовёт
  // создание мира и кладёт результат в [мир + manager] (рядом мобы +0x24 и предметы +0x28). Список событий (AList2) — с +0x10:
  // +0x14 первый узел; узел: +0x0 следующий, событие с +0x8. Раскладка события — в функции «попадание» (её зовёт Tick
  // менеджера, vtable[2]): +0x8 сколько мс живёт, +0x14 кто бьёт, +0x30 скилл, +0x1C массив целей по 0x18 байт, +0x28 сколько
  // целей; в цели +0x0 кого, +0x8 флаги, +0xC урон (его игра и показывает над целью). Проверено на живом
  // клиенте: Probe attacks показывает удары пета, мобов и перса с уроном и названиями скиллов
  "attacks": {
    "manager": "0x34",
    "head": "0x14",
    "event": "0x8",
    "lived": "0x8",
    "attacker": "0x14",
    "skill": "0x30",
    "targets": "0x1C",
    "targetCount": "0x28",
    "targetSize": "0x18",
    "targetFlags": "0x8",
    "targetDamage": "0xC"
  },

  // Сообщения окна чата (последние до 200): глобальный список {начало, конец, ?, сколько} в данных exe. Адрес в профиле не
  // храним — бот находит его по коду «добавить сообщение» (здесь он на +7: mov ecx, список). Как найти на другом клиенте:
  // строка сообщения из чата (например, «Запомните это имя») → кто на неё указывает (запись в массиве) → кто указывает
  // на начало массива (глобальная переменная) → код, который её читает рядом с «cmp [список + 0xC], 200 (0xC8)».
  // Запись 0x24 байта: +0x4 канал (1 мир, 5 бой, 8 системные, 9 объявления), +0x8 текст (UTF-16, с кодами цвета),
  // +0x14 номер (по порядку), +0x20 WID отправителя (−1 у системных). Проверено 31.10: 199 сообщений (опыт, монеты, мир). Код отличается от comeback146 одним байтом (lea [ebp-0x9A8]);
  // рядом такой же код со вторым списком (+0x10 от этого, lea [ebp-0x9D0]) — он не тот
  "chat": {
    "find": "8D 85 58 F6 FF FF B9 ?? ?? ?? ?? 50 E8 ?? ?? ?? ?? 81 3D ?? ?? ?? ?? C8 00 00 00 7C",
    "at": "0x7",
    "entrySize": "0x24",
    "channel": "0x4",
    "text": "0x8",
    "number": "0x14",
    "sender": "0x20",
    // После смерти персонажа игра пишет в системный канал (8), кто убил — и игрока (даже из инвиза, когда удара не видно),
    // и моба. Шаблон — строка из таблицы строк клиента (в памяти — «%s. Запомните…»; та же, что в comeback146)
    "killedBy": "%s. Запомните это имя. Так зовут вашего убийцу.",
    // После гибели пета — тоже системный канал (8), но без убийцы: его бот берёт из последних ударов по пету.
    // Строка — в таблице строк клиента, та же, что в comeback146
    "petDied": "Питомец погиб."
  },

  // Принятые задания (окно «Задания»). Список [объект заданий + 0x8]: байт +0 — сколько в нём записей (с подзаданиями), байт +4 —
  // сколько верхнего уровня («Активные N/60»). Записи по 0x20 байт с +0x8, поля подряд без выравнивания: +0 номер (ushort),
  // +2 номер записи-родителя (0xFF — нет), +3/+4 соседи, +5 первое подзадание, +7 когда взято (unix-время), +0xD указатель на
  // запись задания, +0x15 сколько убито (ushort на каждого моба цели). Как найти: в памяти номер задания (ushort) рядом с номером
  // родителя в 0x20 байтах, за ними указатель на запись с тем же номером.
  // Запись задания — из tasks.data, первым полем vtable: +0x4 номер, +0x8 название (UTF-16, бывает с кодом цвета «^ffffff»).
  // Остальное — по коду клиента, раскладка записи своя (не как в Comeback). Функция окна заданий (рядом push строки
  // "Btn_TreasureMap"): тип цели — [запись+0x28C] == 0xC перед ней; кому сдать — [запись+0x11E], её выводит «%s (%d, %d)»;
  // [запись+0x47C] — родитель. Мобы и предметы цели — функция прогресса задания: тип 1 — цикл по [запись+0x294] записям массива
  // [запись+0x298] шагом 0x16 (+0 моб, +4 сколько), счётчик — word [список + (номер записи×16 + моб)×2 + 0x1D]; тип 2 —
  // [запись+0x29C] записей массива [запись+0x2A0] шагом 0x11 (+0 предмет, +5 сколько).
  // Проверено 01.11 в игре: «Распределитель званий» 6933 — тип 3, сдать NPC 12473, как в окне.
  // Мобы и предметы цели (смещения выше) в игре ещё не сверены — пусто
  "quests": {
    "active": "0x8",
    "entries": "0x8",
    "entrySize": "0x20",
    "entryId": "0x0",
    "entryParent": "0x2",
    "entryTemplate": "0xD",
    "entryKills": "0x15",
    "id": "0x4",
    "name": "0x8",
    "goal": "0x28C",
    // Кто даёт задание — tid NPC: как найти, см. comeback146.jsonc. Не проверено
    "giverNpc": "",
    "awardNpc": "0x11E",
    "monsterCount": "",
    "monsters": "",
    "monsterSize": "",
    // Предмет с моба цели и сколько нужно: как найти, см. comeback146.jsonc. Не проверено
    "monsterDrop": "",
    "monsterDropNeed": "",
    "itemCount": "",
    "items": "",
    "itemSize": "",
    "itemNeed": "",
    // Доступные задания: как найти — см. comeback146.jsonc. Не проверено
    "availableFind": "",
    "availableAt": "",
    "available": "",
    // Все задания верхнего уровня и границы уровня в записи: как найти, см. comeback146.jsonc. Не проверено
    "all": "",
    "minLevel": "",
    "maxLevel": "",
    "rebirthLevel": "",
    // Дерево заданий и «выполнить одно из подзаданий»: как найти, см. comeback146.jsonc. Не проверено
