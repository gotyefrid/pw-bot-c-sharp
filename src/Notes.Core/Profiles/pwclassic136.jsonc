  "mineEssence": {
    "nameInRecord": "0x8",
    "size": "0x180",
    "id": "0x0",
    "tool": "0x50",
    "materials": "0xE8",
    "materialSlots": 16,
    "amounts": "0x168",
    "quest": "0x178",
    "levelRequired": "0x4C"
  },

  // Записи предметов в справочнике (elements.data), в которых есть тип: указатель на название у предмета на земле
  // (groundItem.namePointer) ведёт внутрь записи, перед названием — tid и тип. Две раскладки: оружие, броня, украшения, банки,
  // материалы — +0x0 tid, +0x4 тип, +0x8 подтип, +0xC название; снаряды — +0x0 tid, +0x4 тип, +0x8 название. Бот пробует обе:
  // годится та, где на месте tid — tid предмета (у другой там чужое число). Сверено на живом клиенте 27.10 — все группы по типу,
  // кроме оружия: «Бивень» 8099 — тип 8077 (материал), «Железная пуля» 1041 — тип 8548 (снаряд), «☆Корона с перьями» — 316.
  // Как найти на другом клиенте:
  // 1. Выложить на землю вещь с типом (оружие, броню или банку) и снаряд. Probe snapshot — их tid в строке «Лут».
  // 2. В elements.data (у Comeback он внутри gamedata.pck, ключи — gameFiles.pck) найти 4 байта tid, за которыми через 8 байт (у
  //    снаряда — через 4) идёт название предмета в UTF-16. Сдвиг названия от tid — nameInRecord, 4 байта сразу за tid — тип. В
  //    памяти клиента запись лежит так же, как в файле.
  // 3. Тип сверить со списками типов (как их найти — у lootGroups): например, 1 — «Мечи», 8548 — «Пуля».
  // 4. После правки Probe snapshot пишет у предмета на земле [группу]. Нет её у предмета из группы — раскладка не та.
  "itemEssences": [
    { "nameInRecord": "0xC", "id": "0x0", "type": "0x4" },
    { "nameInRecord": "0x8", "id": "0x0", "type": "0x4" }
  ],

  // Группы лута — по типу предмета в справочнике (тип читается по itemEssences). Данные игры, одинаковы на трёх серверах.
  // Оружие: мечи, копья, топоры/молоты, дальнобойное, кастеты, бичи, магическое, кинжалы, сферы, сабли, косы (сабли и косы есть
  // только на Comeback). Броня: верх, низ, обувь, голова, наручи, накидка. Украшения: ожерелье, пояс, кольцо. Банки: ЖС, МЭ,
  // ЖС и МЭ, детоксикатор, мгновенное противоядие. Снаряды: стрела, болт, пуля. Предметы ДК — тип материала 8077: подтипы
  // «Особые товары ур.1…10» по 10 предметов (с мобов падают 6), ур.2…9 — квесты «Искатель драконов» 20…91 по описанию предметов
  // (configs.pck → item_ext_desc.txt).
  // Как найти номера типов на другом клиенте: в elements.data списки типов — записи подряд по 68 байт (+0x0 id, +0x4 название
  // UTF-16, 32 символа); у оружия, брони, украшений и банок 4 байта перед первой записью — число записей. Найти в UTF-16 название
  // первой записи, id — 4 байта перед ним: оружие — 1 «Мечи», броня — 125 «Верх», украшения — 171 «Ожерелье», банки — 1794
  // «Восстанавливается ЖС», снаряды — 8546 «Стрела» (на Comeback — «Лук»). Новый тип на сервере — новая запись в том же списке
  // (так нашлись сабля 44878 и коса 44879 на Comeback). Тип ДК — 4 байта за tid в записи любого предмета ДК («Бивень» 8099); в
  // списке типов материалов он называется «Деньги дешевеют, цены падают».
  // Корм пета — списком tid: в его записи типа нет (+0x0 tid, +0x4 название, +0x148 верность, как в petFood; запись 0x168 байт),
  // 16 предметов, одни на трёх серверах. Как найти: в elements.data найти tid 8796, за которым сразу «Чистая вода» в UTF-16, — это
  // первая запись списка корма; 4 байта перед ней — число записей (16), дальше записи подряд по 0x168 байт, tid — первые 4 байта
  // каждой. Проверка: Probe snapshot показывает корм в сумке строкой «корм … (tid …)», на земле — с [Корм пета].
  // Счастливые билеты — предметы-сюрпризы (правой кнопкой — случайное задание с наградой) по уровням: карта (любой), билет
  // (с 20), мешок (с 50), коробка (с 70), звезда (с 90). С мобов падают 11092, 11094, 11096, 11098, 11101, остальные tid —
  // двойники с тем же названием. Тоже списком tid: это записи списка «предметы, дающие задание» (+0x0 tid, +0x4 название, дальше
  // до 8 заданий с вероятностями), типа в них нет. Одни tid на трёх серверах. Как найти: в elements.data найти в UTF-16
  // «Счастливая карта», «Счастливый билет», «Счастливый мешок», «Счастливая коробка», «Счастливая звезда» — tid в 4 байтах перед
  // названием; описание (configs.pck → item_ext_desc.txt) — «…сюрприз» или «ценный подарок» и «с N уровня». На Comeback так же
  // называются свадебный «Счастливый билет» 32083 (обмен на наряд) и «Счастливая карта усердия…доброты» 39220…39229 (задание
  // «Удача») — это другое, с мобов не падает, в группу не входит. Проверка: Probe snapshot — у билета на земле [Счастливые билеты].
  // Название группы хранится в настройках персонажа — не переименовывать
  "lootGroups": [
    { "name": "Оружие", "types": [ 1, 5, 9, 13, 182, 291, 292, 23749, 25333, 44878, 44879 ] },
    { "name": "Броня", "types": [ 125, 150, 216, 316, 346, 369 ] },
    { "name": "Украшения", "types": [ 171, 234, 247 ] },
    { "name": "Банки", "types": [ 1794, 1802, 1810, 1815, 2038 ] },
    { "name": "Снаряды", "types": [ 8546, 8547, 8548 ] },
    { "name": "Предметы ДК", "types": [ 8077 ] },
    { "name": "Корм пета", "tids": [ 8796, 9757, 9758, 9759, 9760, 9761, 11550, 11551, 11552, 11553, 11554, 11580, 11581, 12842, 18251, 26977 ] },
    { "name": "Счастливые билеты", "tids": [ 11092, 11093, 11094, 11095, 11096, 11097, 11098, 11099, 11100, 11101, 11102, 11103,
                                             13606, 13607, 13608, 13609, 13610, 13611, 13612 ] }
  ],

  // Как в comeback136, проверено на живом клиенте 08.10: агрессивные 1 (Царь черных гадюк, Нефритовый призрак), мирные 0;
  // радиус 5..6 м. Сопоставление предлагало радиус +0x268 — там 37/33/9, не радиус
  "monsterEssence": {
    "aggressive": "0x2B8",
    "aggroRadius": "0x260",
    // Где обитает — +0x2CC, как в Comeback (коды и как найти — в comeback146.jsonc). Проверено 03.11 (Probe mobessence): Летяга-
    // разбойница и Король небесных волков — 2 (воздух), Черепаха мелководья — 1 (вода), Молодой пятнистый скорпион, Царь звездных
    // жуков — 0 (земля)
    "inhabit": "0x2CC"
  },

  // Функции — сигнатуры comeback136 (совпали ровно в одном месте), остальные найдены по коду (08.10, ниже — как).
  // В скобках — адрес в comeback136. Все с тем же числом аргументов, что там
  "functions": {
    // Переложить в сумке — c2s 0x0D: перенести N штук из одной ячейки сумки в другую; в пустую ячейку — разделить стопку. stdcall,
    // 3 аргумента (откуда, куда, сколько), ячейки с 0, ret 0xC; обе ячейки помечаются «занято» (+0x33 у предмета), снимет ответ
    // сервера. Пакет 6 байт: [команда:2][откуда][куда][число:2]. Как найти на другом клиенте: c2s-функция, пишущая команду 0x0D
    // (mov eax, 0xD … mov word [esi], ax); одно место в exe.
    "bagMove": { "rva": "0x50FC80", "convention": "stdcall", "args": [ "from", "to", "count" ],
                 "signature": "55 8B EC 53 56 8B 35 ?? ?? ?? ?? 8B 4E 1C 8B C1 8B 51 2C 85 D2 74 ?? 8B 92 ?? ?? ?? ?? 85 D2 74 ?? 8B 5D 08 85 DB 78 ?? 3B 5A 10 7D ?? 8B 42 0C 8B 14 98 8B C1 85 D2 74 ?? C6 42 33 01 8B 46 1C 8B 40 2C 8B 5D 0C 85 C0 74 ?? 8B 80 ?? ?? ?? ?? 85 C0 74 ?? 85 DB 78 ?? 3B 58 10 7D ?? 8B 40 0C 8B 04 98 85 C0 74 ?? C6 40 33 01 6A 06 B9 04 E4 E1 00 E8 ?? ?? ?? ?? 8B F0 85 F6 74 ?? 8B 0D ?? ?? ?? ?? B8 0D 00 00 00 66 89 06 8B 45 08 88 46 02 66 8B 45 10 56 68 AF 00 00 00 88 5E 03 66 89 46 04 8B 49 20 68 A9 00 00 00 E8 ?? ?? ?? ?? 8B CE E8 ?? ?? ?? ?? 5E 5B 5D C2 0C 00" },

    // Начать разговор с NPC — c2s 0x23, как клик по нему: сервер отвечает списком услуг, клиент открывает окно Win_NPC. Метод
    // объекта связи (this = [[база]+0x20], ret 4), аргумент — WID NPC; пакет 6 байт. Как найти на другом клиенте: функция
    // начинается с «mov dword [ebp-4], 0x23» (C7 45 FC 23 00 00 00) — одно место в exe; её зовёт обработчик клика по NPC.
    "npcHello": { "rva": "0x230A10", "convention": "thiscall", "this": "session", "args": [ "wid" ],
                  "signature": "55 8B EC 83 EC 08 56 8D 45 FC C7 45 FC 23 00 00 00" },

    // (0xF5F00) Встать в ближайшем городе после смерти — c2s 0x04, кнопка «Ближний город» окна смерти (что делает — в
    // comeback146.jsonc). Метод объекта связи (ret 4), аргумент — номер колесницы, при обычной смерти 0. Как найти: начало как
    // у npcHello, но «mov dword [ebp-4], 4» и ограничитель частоты (связь +0x104); таких функций две — нужна та, что пишет в пакет
    // команду 4 и аргумент (B8 04 00 00 00 … 89 4E 02); вторая (команда 5 без аргумента) — «Св. воскрешения». Проверено 03.11
    // (Probe act revive-town): перс 1 ур. мёртв (HP 0) — через 2,9 с жив в городе, ~820 м в стороне; встаёт с 20 % HP (10/50), не с полным
    "reviveInTown": { "rva": "0xFF900", "convention": "thiscall", "this": "session", "args": [ "0" ],
                      "signature": "55 8B EC 83 EC 08 56 8D 45 FC C7 45 FC 04 00 00 00 50 81 C1 04 01 00 00 E8 ?? ?? ?? ?? 8B 08 8B 01 3B 41 04 72 ?? C7 01 00 00 00 00 B9 ?? ?? ?? ?? 6A 06 E8 ?? ?? ?? ?? 8B F0 85 F6 74 ?? 8B 4D 08 B8 04 00 00 00 89 4E 02" },

    // Перенос между сумкой и банком — c2s 0x3A, как в comeback136: обмен ячейки банка и ячейки сумки местами, стопка целиком; в
    // пустую ячейку — просто перенос. stdcall, 3 аргумента (вкладка банка — для основной 3, ячейка банка, ячейка сумки), ячейки с 0,
    // ret 0xC. Перед отправкой обе ячейки помечаются «занято» (+0x33 у предмета). Пакет 5 байт: [команда:2][вкладка][ячейка банка]
    // [ячейка сумки]. Как найти на другом клиенте: c2s-функции 0x38…0x3C идут в exe подряд (mov eax, 0x3A … mov word [esi], ax);
    // нужная — с пакетом в 5 байт. Банк открывается только у банкира (npcHello + npcOpenStorage), кнопки в сумке здесь нет
    "bankExchange": { "rva": "0x5102F0", "convention": "stdcall", "args": [ "tab", "bankSlot", "slot" ],
                      "signature": "55 8B EC 53 56 8B 35 ?? ?? ?? ?? 8B 4E 1C 8B C1 8B 51 2C 85 D2 74 ?? 8B 92 ?? ?? ?? ?? 85 D2 74 ?? 8B 5D 10 85 DB 78 ?? 3B 5A 10 7D ?? 8B 42 0C 8B 14 98 8B C1 85 D2 74 ?? C6 42 33 01 8B 46 1C 8B 48 2C 8B 5D 0C 85 C9 74 ?? FF 75 08 E8 ?? ?? ?? ?? 85 C0 74 ?? 85 DB 78 ?? 3B 58 10 7D ?? 8B 40 0C 8B 04 98 85 C0 74 ?? C6 40 33 01 6A 05 B9 04 E4 E1 00 E8 ?? ?? ?? ?? 8B F0 85 F6 74 ?? 8B 0D ?? ?? ?? ?? B8 3A 00 00 00 66 89 06 8B 45 08 56 88 46 02 8B 45 10 68 AE 00 00 00 88 46 04 88 5E 03 8B 49 20 68 A9 00 00 00 E8 ?? ?? ?? ?? 8B CE E8 ?? ?? ?? ?? 5E 5B 5D C2 0C 00" },

    // Доложить в банк с числом — c2s 0x3C: N штук из ячейки сумки на стопку того же предмета в ячейке банка (как мышкой
    // бросить стопку на такую же — стопки сливаются; 0x3A на такую ячейку поменял бы их местами). stdcall, 4 аргумента
    // (ret 0x10): вкладка банка (основная 3), ячейка банка, ячейка сумки, сколько; ячейки с 0; обе ячейки помечаются «занято»
    // (+0x33 у предмета). Пакет 7 байт: [команда:2][вкладка][ячейка сумки][ячейка банка][число:2]. Соседка 0x3B — то же
    // обратно, из банка в сумку (в пакете сначала ячейка банка). Как найти на другом клиенте: c2s-функция сразу за
    // bankExchange, команда 0x3C.
    "bankPutCount": { "rva": "0x510480", "convention": "stdcall", "args": [ "tab", "bankSlot", "slot", "count" ],
                      "signature": "55 8B EC 53 56 8B 35 ?? ?? ?? ?? 8B 4E 1C 8B C1 8B 51 2C 85 D2 74 ?? 8B 92 ?? ?? ?? ?? 85 D2 74 ?? 8B 5D 10 85 DB 78 ?? 3B 5A 10 7D ?? 8B 42 0C 8B 14 98 8B C1 85 D2 74 ?? C6 42 33 01 8B 46 1C 8B 48 2C 8B 5D 0C 85 C9 74 ?? FF 75 08 E8 ?? ?? ?? ?? 85 C0 74 ?? 85 DB 78 ?? 3B 58 10 7D ?? 8B 40 0C 8B 04 98 85 C0 74 ?? C6 40 33 01 6A 07 B9 ?? ?? ?? ?? E8 ?? ?? ?? ?? 8B F0 85 F6 74 ?? 8B 0D ?? ?? ?? ?? B8 3C 00 00 00 66 89 06 8B 45 08 88 46 02 8B 45 10 88 46 03 66 8B 45 14 56 68 B0 00 00 00 88 5E 04 66 89 46 05 8B 49 20 68 A9 00 00 00 E8 ?? ?? ?? ?? 8B CE E8 ?? ?? ?? ?? 5E 5B 5D C2 10 00" },

    // Отправить пакет серверу — метод объекта связи (this = [[база]+0x20], ret 0xC), три аргумента: число-ключ, длина пакета
    // плюс этот ключ, адрес пакета (функция сама вычитает ключ из второго). Клиент везде шлёт ключ 0xA9: «push данные;
    // push длина+0xA9; push 0xA9; mov ecx,[[база]+0x20]; call». Нужна для продажи (см. packets). Как найти на другом клиенте:
    // в методе «продать корзину» сразу за сборкой команды 0x25 с услугой 2 — вызов с ecx = [[база]+0x20]
    "sendPacket": { "rva": "0x509480", "convention": "thiscall", "this": "session", "args": [ "0xA9", "size+0xA9", "data" ],
                    "signature": "55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 00 00 00 00 50 83 EC 30 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3 00 00 00 00 89 4D E0 B9 07 00 00 00 E8 ?? ?? ?? ?? 8B 45 0C 3B 45 08 76 09 8B 4D 0C 2B 4D 08 89 4D 0C 83 7D 08 00" },

    // Закрыть окно разговора с NPC — команда «IDCANCEL» окна Win_NPC (CDlgNPC), её же зовут кнопка «Назад» и Esc. this — окно
    // NPC (см. "ui"), один аргумент — имя команды (не читается, ret 4). Прячет окно и сбрасывает отметки клиента, серверу
    // ничего не шлёт. Как найти на другом клиенте: таблица команд окна NPC — рядом строки "back" и "IDCANCEL" (у "IDCANCEL" —
    // эта функция); начинается с «mov edi,ecx; mov eax,[edi]; push 1; push 0; push 0; call [eax+0x20]» (спрятать окно)
    "npcDialogClose": { "rva": "0x1ED410", "convention": "thiscall", "this": "npcDialog", "args": [ "0" ],
                        "signature": "55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 00 00 00 00 50 51 53 56 57 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3 00 00 00 00 8B F9 8B 07 6A 01 6A 00 6A 00 FF 50 20 6A 00 68 ?? ?? ?? ?? 68 ?? ?? ?? ??" },

    // Починить предмет — c2s 0x25 «услуга NPC» с услугой 3 «ремонт», окно ремонта NPC открыто. tid -1 (и 0, 0) — починить всё.
    // Как в 1.3.6: cdecl, в стеке tid, в cl — где предмет, в dl — ячейка (подробно — в comeback136.jsonc). Проверено в игре:
    // после разговора с кузнецом (окно лавки не открывали) починилось всё надетое.
    // Как найти на другом клиенте: c2s-функция с «mov dword [esi+2], 3» и «mov dword [esi+6], 6» рядом с «mov eax, 0x25»
    "repairItem": { "rva": "0x4B1550", "convention": "cdecl", "args": [ "tid" ],
                    "registers": { "ecx": "where", "edx": "slot" },
                    "signature": "55 8B EC 53 56 8A F9 8A DA 6A 10 B9 ?? ?? ?? ?? E8 ?? ?? ?? ?? 8B F0 85 F6 74 ?? 8B 0D ?? ?? ?? ?? B8 25 00 00 00 56 66 89 06 8B 45 08 68 B9 00 00 00 C7 46 02 03 00 00 00 C7 46 06 06 00 00 00" },

    // Открыть банк у банкира — c2s 0x25 «услуга NPC» с услугой 0x0F «открыть хранилище», как пункт «Услуги хранения» в окне NPC:
    // разговор не нужен — достаточно стоять рядом с банкиром (проверено в игре; после npcHello окно банкира остаётся открытым,
    // поэтому без него лучше). stdcall, один аргумент — строка пароля банка (ret 4); без пароля клиент шлёт "".
    // Пакет: [0x25:2][услуга 0x0F:4][длина данных = 4 + длина пароля:4][длина пароля:4][пароль]. Как найти на другом клиенте:
    // одно место в exe, где пишется «mov dword [reg+2], 0x0F» рядом с «mov eax, 0x25»; её зовут окно NPC (с пустой строкой) и
    // окно ввода пароля Win_InputString. Соседняя услуга 0x0E — смена пароля банка.
    "npcOpenStorage": { "rva": "0x1ECCB0", "convention": "stdcall", "args": [ "data" ],
                        "signature": "55 8B EC 53 56 57 8B 7D 08 33 F6 85 FF 74 ?? 80 3F 00 74 ?? 8B F7 8D 4E 01 0F 1F 80 00 00 00 00 8A 06 46 84 C0 75 F9 2B F1 8D 46 0E B9 ?? ?? ?? ?? 50 E8 ?? ?? ?? ?? 8B D8 85 DB 74 ?? C7 43 02 0F 00 00 00 B8 25 00 00 00" },

    // Сдать задание — c2s 0x25 «услуга NPC» с услугой 6 «сдать задание», как пункт «сдать» в окне NPC: разговор с NPC уже начат
    // (npcHello). stdcall, 2 аргумента (ret 8): номер задания, номер выбранной награды (0 — первая / без выбора). Пакет 18 байт:
    // [0x25:2][услуга 6:4][длина данных 8:4][задание:4][награда:4]. Рядом услуга 7 — взять задание. Как найти на другом клиенте:
    // место в exe, где пишется «mov dword [reg+2], 6» и «mov dword [reg+6], 8» рядом с «mov eax, 0x25».
    // Проверено 01.11 в игре: «Распределитель званий» 6933 сдано, пропало из списка вместе с родителем.
    "npcReturnTask": { "rva": "0xDDED0", "convention": "stdcall", "args": [ "task", "choice" ],
                       "signature": "55 8B EC 56 6A 12 B9 ?? ?? ?? ?? E8 ?? ?? ?? ?? 8B F0 85 F6 74 ?? 8B 0D ?? ?? ?? ?? B8 25 00 00 00 66 89 06 8B 45 08 56 89 46 0A 8B 45 0C 68 BB 00 00 00 C7 46 02 06 00 00 00 C7 46 06 08 00 00 00" },

    // Взять задание — c2s 0x25 «услуга NPC» с услугой 7 «взять задание», как пункт задания в окне NPC: разговор с NPC уже начат
    // (npcHello). stdcall, 3 аргумента (ret 0xC), как на Comeback, но в пакет идёт только первый — номер задания (из tasks.data, как
    // в "quests"); склад и обновление (0) клиент не шлёт. Пакет 14 байт: [0x25:2][услуга 7:4][длина данных 4:4][задание:4]. Как
    // найти на другом клиенте: единственное место в exe, где пишется «mov dword [reg+2], 7» рядом с «mov eax, 0x25».
    // В игре на этом клиенте ещё не проверено
    "npcAcceptTask": { "rva": "0x1ECC50", "convention": "stdcall", "args": [ "task", "storage", "refresh" ],
                       "signature": "55 8B EC 56 6A 0E B9 ?? ?? ?? ?? E8 ?? ?? ?? ?? 8B F0 85 F6 74 ?? 8B 0D ?? ?? ?? ?? B8 25 00 00 00 56 66 89 06 8B 45 08 68 B7 00 00 00 C7 46 02 07 00 00 00 C7 46 06 04 00 00 00 89 46 0A" },

    // (0x330000) c2s 0x03 — по коду отправки «mov eax, 3 … mov word [esi], ax»; одно место в exe
    "normalAttack": { "rva": "0x3FC8C0", "convention": "stdcall",
                      "signature": "55 8B EC 51 56 68 ?? ?? ?? ?? FF 15 ?? ?? ?? ?? 83 3D ?? ??" },
    // (0x31A720) — сопоставление кода; тот же код, флаги перса +0x74C (там +0x80C), работы +0x14D8
    "hostPickupObject": { "rva": "0x3E5150", "convention": "thiscall", "this": "host",
                          "signature": "55 8B EC 51 53 56 57 8B F9 8B 87 4C" },
    // (0x3CD940) c2s 0x28, cl = где, dl = ячейка — второе место с 0x28 (первое, 0x1B0010, шлёт без аргументов)
    "useItem": { "rva": "0x4B0F30", "convention": "cdecl", "args": [ "tid", "count" ],
                 "registers": { "ecx": "where", "edx": "slot" },
                 "signature": "55 8B EC 53 56 8A F9 8A DA 6A 0A B9" },
    // (0x31E670) c2s 0x64 — функция прямо перед recallPet, начало как там (перс +0x17E4)
    "summonPet": { "rva": "0x3E9120", "convention": "thiscall", "this": "host",
                   "signature": "55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 00 00 00 00 50 51 53 56 57 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3 00 00 00 00 8B F1 8B 8E E4 17" },
    // (0x31E820) c2s 0x65 — сопоставление кода
    "recallPet": { "rva": "0x3E92E0", "convention": "thiscall", "this": "host",
                   "signature": "56 8B F1 8B 8E E4 17 00 00 85 C9 74" },
    // (0x2EF6F0) кнопка «Полёт» — сигнатура comeback136 с +0x17E4 вместо +0x1C04, одно место
    "hostFly": { "rva": "0x3B6B30", "convention": "thiscall", "this": "host", "args": [ "force" ],
                 "signature": "56 8B F1 57 8B 8E E4 17 00 00 85 C9" },
    // (0x31FB40)
    "selectTarget": { "rva": "0x3EA9B0", "convention": "thiscall", "this": "host", "args": [ "wid" ],
                      "signature": "55 8B EC 83 EC 08 53 56 57 6A 12 8B" },
    "unselect": { "rva": "0x3EA9B0", "convention": "thiscall", "this": "host", "args": [ "0" ],
                  "signature": "55 8B EC 83 EC 08 53 56 57 6A 12 8B" },
    // (0x311630)
    "hostApplySkill": { "rva": "0x3DBB90", "convention": "thiscall", "this": "host",
                        "signature": "55 8B EC 83 EC 0C 53 56 57 68 ?? ?? ?? ?? 8B F9" },
    // Запустить макрос (номер с 0, 0, -1) — как кнопка макроса на панели. Как найти: таблица методов класса CECSCSkillGrp
    // (имя есть в exe), метод 2 — «нажать»: зовёт эту функцию у персонажа. Она удаляет идущий макрос [перс + 0x14F8] и
    // запускает заново
    "hostApplyComboSkill": { "rva": "0x3E8170", "convention": "thiscall", "this": "host",
                             "signature": "55 8B EC 51 56 8B F1 8B 8E F8 14 00 00 85 C9 74" },
    // Остановить идущий макрос: удаляет его [перс + 0x14F8], макроса нет — ничего. Без аргументов, серверу ничего не шлёт,
    // каст не прерывает. Игра зовёт её сама, когда скилл нажат не макросом (hostApplySkill со вторым аргументом 0). Как найти:
    // функция сразу после hostApplyComboSkill — первые её строки (удалить идущий макрос) и сразу ret
    "hostClearComboSkill": { "rva": "0x3E8260", "convention": "thiscall", "this": "host",
                             "signature": "56 8B F1 8B 8E F8 14 00 00 85 C9 74 10 8B 01 6A 01 FF 10 C7 86 F8 14 00 00 00 00 00 00 5E C3" },
    // (0x30A9E0) c2s 0x29. Метод не самой связи, а объекта внутри неё: this = связь + 0xF4 (с самой связью клиент падает).
    // Как найти сдвиг: там, где клиент сам зовёт эту функцию (3 места), перед call стоит «mov ecx, [[база]+0x20]» и «add ecx, 0xF4».
    // Проверка: обе функции начинаются с ограничителя частоты связи — здесь «add ecx, 0x10», у cancelAction «add ecx, 0x104»;
    // разница 0x104 − 0x10 и есть сдвиг. Где разницы нет (одинаковое «add ecx»), сдвиг не нужен
    "castSkill": { "rva": "0x317170", "convention": "thiscall", "this": "session", "thisOffset": "0xF4",
                   "signature": "55 8B EC 51 56 8D 45 FC C7 45 FC 29" },
    // (0x1200E0) c2s 0x2A — отменить действие, как Esc; закрывает и окно банка (проверено в игре)
    "cancelAction": { "rva": "0x14D540", "convention": "thiscall", "this": "session",
                      "signature": "55 8B EC 51 56 8D 45 FC C7 45 FC 2A 00 00 00" },
    // (0x1CDFD0) c2s 0x67
    "petCtrl": { "rva": "0x234BC0", "convention": "thiscall", "this": "session",
                 "signature": "55 8B EC 51 53 56 57 8D 45 FC C7 45" },
    // (0x325F70)
    "workCreate": { "rva": "0x3F0DF0", "convention": "thiscall", "signature": "55 8B EC 8B 45 08 56 8B F1 83 F8 13" },
    // (0x32C070)
    "workMoveSetDestination": { "rva": "0x3F7970", "convention": "thiscall", "args": [ "type", "data" ],
                                "signature": "55 8B EC 83 EC 10 56 8B F1 8B 4D 0C 57 8B 7D 08" },
    // (0x326850)
    // Работа «подойти» — цель задают два метода работы, как в Comeback 1.4.6 (там подробно: причины, как найти). NewTarget здесь
    // выделяет память своим распределителем (mov ecx, … перед call) — своя сигнатура; SetTarget — как в Comeback. Оба зовутся подряд
    // из CECHostPlayer::PickupObject (hostPickupObject), с причиной 2 — по выбранной цели (push 2; push [перс+0x114]). Проверено в игре (банкир).
    "workTraceTarget": { "rva": "0x3FDCD0", "convention": "thiscall",
                         "signature": "55 8B EC 56 8B 75 08 57 8B F9 85 F6 74 ?? 78 ?? 6A 1C B9 ?? ?? ?? ?? E8" },
    "workTraceSetTarget": { "rva": "0x3FDB60", "convention": "thiscall",
                            "signature": "55 8B EC 8A 45 0C 83 EC 18 56 8B F1 57 8B 7D 08 6A 00 88 46 3A" },
    "workStart": { "rva": "0x3F1980", "convention": "thiscall", "args": [ "1", "work", "0" ],
                   "signature": "55 8B EC 53 56 57 8B 7D 0C 8B F1 85 FF 74 10 8B" }
  },

  // Сторож клиента (element/reportbugs/pwprotector.exe): на этом клиенте файл не проверен — не проверяем.
  // Как проверить: посмотреть файл рядом с exe игры и вписать сюда его sha256.
  "protector": {
    "sha256": ""
  }
}
