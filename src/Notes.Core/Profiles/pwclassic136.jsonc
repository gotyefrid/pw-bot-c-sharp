  // Другой игрок. У игры это тот же класс, что наш персонаж: ник, WID и координаты — на тех же смещениях, что в "host"
  // (как найти: смещения перса; в узле списка игроков +0x8 — тот же WID). Проверено 31.10 в людном месте.
  // Уровень и HP игра знает только у игрока, которого выделили (у остальных — нули). Проверено 31.10: выделенный
  // лучник — ур. 1, HP 65/65. Цель — то же смещение, что у перса (в comeback136 проверено на игроке)
  "player": {
    "wid": "0x49C",
    "namePointer": "0x6C0",
    "location": "0x3C",
    "level": "0x4A8",
    "hp": "0x4B0",
    "maxHp": "0x4FC",
    "target": "0x580",
    // Класс — int сразу за указателем на ник. Номера как в игре: 0 воин, 1 маг, 2 шаман, 3 друид, 4 оборотень, 5 убийца,
    // 6 лучник, 7 жрец, 8 страж, 9 мистик. Проверено 31.10: у перса-друида — 3, у игроков рядом — только 0…9. Как найти:
    // поле, где у перса и у игрока другого класса разные маленькие числа (у перса то же смещение)
    "class": "0x6C4"
  },

  // Probe port 08.10: название (+0x244), расстояние (+0x26C) и запись справочника (+0x384) — сдвиг -0x20..-0x28 от comeback136;
  // названия и уровни как на экране (скриншот владельца). HP (+0x128) — только у цели, у пета 386.
  // Бой — запись 08.10 (все мобы раз в 0,25 с, 200 с), владелец дрался с агрессивными мобами и увёл одного полётом.
  // Сопоставление здесь ошиблось (state +0x31C, цели +0x338/+0x33C — там float)
  "npc": {
    "wid": "0x114",
    // Вид моба или NPC (tid): как найти — см. comeback146.jsonc. Не проверено
    "tid": "",
    "type": "0xB4",
    // Состояние: 1 стоит, 5 идёт, 2 бьёт, 4 мёртв — все четыре видны в записи боя (в comeback136 +0x2DC)
    "state": "0x2B8",
    "hp": "0x128",
    // Общего поля «цель» нет: +0x210 (как в comeback136) всё время боя 0. Бот берёт цель удара
    "target": "0x0",
    // Цель каста: WID перса или пета, пока моб кастует (состояние 3), — сразу за целью удара, как в comeback136 (+0x2F8 → +0x2FC).
    // Как найти: моб кастует в пета — ищем WID пета в мобе; было в каждом снимке каста, цель удара при этом 0
    "castTarget": "0x2D8",
    // Кого бьёт: WID перса (или пета), пока моб бьёт; после отагра остаётся. Рядом +0x2D0 — мс до удара. В comeback136 +0x2F8
    "attackTarget": "0x2D4",
    // У пета то же поле — на кого идёт по приказу: пет в бою — WID моба 102 раза из 148 снимков (+0x2D4 — 67, когда бьёт).
    // У моба здесь WID только во время каста (вне каста — числа вида 0x16D016C), поэтому у мобов — только как цель каста
    "petTarget": "0x2D8",
    "level": "0x120",
    "distance": "0x26C",
    "namePointer": "0x244",
    "location": "0x3C",
    // Указатель на запись справочника: +0x0 — id вида (он же в мобе +0x118)
    "essence": "0x384",
    // «Возвращается»: бит 0x20000 встал, когда перс взлетел на 18 м над мобом (через 4 с), снялся, когда моб ушёл; у мобов,
    // не бивших перса, бит никогда не стоит. +0x224 — копия. В comeback136 +0x22C
    "returning": "0x214",
    "returningFlag": "0x20000"
  },

  // Сумка — как в comeback136, кроме описаний (-0x10): Probe port нашёл по «+0x0 описания = tid предмета».
  // Сверено: банки HP 160/270/410/580 и MP 330/730 с уровнями 12..40, корм — верность 10 и 20
  "inventory": {
    "items": "0xC",
    "size": "0x10",
    "itemCategory": "0x8",
    "itemTid": "0xC",
    "itemCount": "0x14",
    "itemMaxCount": "0x18",
    // Цена продажи одной штуки — не проверено здесь: пакет продажи этого клиента цены не несёт (записи по 12 байт: tid, ячейка,
    // сколько), в коде её чтение не нашли; как найти — в comeback136.jsonc
    "itemPrice": "",
    // Прочность в сотых, флаги (бит 0x1000 — «не чинится»), маска мест — проверка «есть что чинить» у контейнера надетого
    // (её зовёт обработчик «Починить все», см. host.equipment): «mov ecx,[eax+0x28]; or ecx,[eax+0x2c]»,
    // «mov ecx,[eax+0x38]; shr ecx,0xc», «cmp [eax+0x74], [eax+0x78]». Прочность и массивы — на 0x10 раньше, чем в 1.3.6
    // (как и itemEssence). Проверено чтением живого клиента: у оружия 1626/3400
    "itemDurability": "0x74",
    "itemMaxDurability": "0x78",
    "itemFlags": "0x38",
    "flagNoRepair": "0x1000",
    // Ячейки под камни +0x9C/+0xA0 и свойства +0xB0/+0xB4 — массивы, как в 1.3.6 (подробно — в comeback136.jsonc), записи
    // свойств те же 0x1C байт. Как найти: перед каждым массивом — указатель на vtable (+0x98, +0xAC), за ним указатель,
    // число, ёмкость. Проверено чтением живого клиента: у кольца 0x55C/0x354/0x379 — те же номера, что у такого же на 1.4.6
    "itemEquipMask": "0x28",
    "itemSockets": "0x9C",
    "itemSocketCount": "0xA0",
    "itemAddons": "0xB0",
    "itemAddonCount": "0xB4",
    "addonSize": "0x1C",
    "addonParamCount": "0x4",
    "addonParams": "0xC",
    "itemEssence": "0x60",
    "foodEssence": "0x58",
    "categoryPotion": 9,
    "categoryPetFood": 27,
    // Яйцо питомца: как найти, см. comeback146.jsonc. Не проверено
    "categoryPetEgg": "",
    // Название и группа любого предмета (для «убирать в банк»): в первых essenceSearch байтах предмета ищется указатель на
    // описание, у которого +0x0 — тот же tid; место указателя у разных классов предметов разное (проверено в игре: банка +0x60, корм/кирка/руна +0x58; вещей в сумке не было).
    // Дальше название — по раскладкам itemEssences (с типом), а у записи без типа — +plainName. Как проверить на другом
    // клиенте: Probe snapshot — у предметов сумки названия и [группа]
    "essenceSearch": "0x200",
    "plainName": "0x4"
  },

