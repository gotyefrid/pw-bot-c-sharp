  // Правка exe клиента: фиксированный набор байтовых правок под конкретный билд (originalSha256) плюс пересчёт
  // контрольной суммы образа (см. digest) — без него клиент не запустится с изменённым файлом. Как найти те же
  // места в новом билде — в комментарии у каждой правки. Применяет кнопка «Пропатчить» (Clients/ClientPatcher):
  // оригинал сохраняется как .orig рядом с exe, откат — той же кнопкой «Откат». Обновление игры → sha не совпадёт,
  // патчер откажется («не тот билд»), новому билду нужен новый рецепт. Защита здесь та же, что в 1.4.6 (тот же
  // набор сканеров и эталон .mgbase), байты всех трёх ветвей совпали с 1.4.6 буквально
  "patch": {
    "originalSha256": "91578ab24182682b7d54b169a474b4b0325ab49ae88f9d51c5bc989f223a6305",
    "patchedSha256": "435d6c8b1b0d67ceb0df0e62036b13db9f9c4e095594720512cf0bcfcd6be69e",
    // Прежние сборки этого же рецепта: игрок мог пропатчить ими раньше. Такой файл бот узнаёт,
    // показывает «устарел» и пересобирает текущим рецептом из .orig.
    "supersededSha256": [ "82a3e5542e2fbb9bb93275783f855776bcad9800ca59ba1a81d6a957d6301a", "39f828e409918152e19816f93953ea219f453d3fede8c629e8f1d423cf5952ec" ],
