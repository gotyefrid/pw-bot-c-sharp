  "base": {
    // game = [база + 0x1C]. Саму базу бот находит в коде клиента (самая читаемая переменная) — в профиле её нет
    "game": "0x1C",
    // Объект связи с сервером: в нём SendGameData (ecx = [[база]+0x20])
    "session": "0x20",
    // Настройки игры (в них макросы): запуск макроса (hostApplyComboSkill) зовёт разбор макроса, тот читает [[база] + 0x18]
    "configs": "0x18",
    // Очередь сообщений игры: как найти, см. comeback146.jsonc. Не проверено
    "gameMessages": ""
  },

  "host": {
    "struct": "0x28",
    // Ник (UTF-16) — «Заметно». В 1.4.6 +0x788
    "namePointer": "0x780",
    // Байт «кастует»: два каста атаки — 1 на ~2.5 с каждый
    "castFlag": "0xB8",
    // В 1.4.6 +0x4B8: сопоставление кода — 69 инструкций 0x4B8 → 0x4AC (весь блок уровень/HP/MP сдвинут на -0xC)
    "wid": "0x4AC",
    // 69 — как в игре
    "level": "0x4B8",
    // HP 2766 = максимум, MP 4051 = максимум (полные); MP падал на 1 за каст атаки
    "hp": "0x4C0",
    "mp": "0x4C4",
    "maxHp": "0x524",
    "maxMp": "0x528",
    // Опыт на текущем уровне (int) — сразу за MP, как в 1.4.6 (там +0x4D4; как найти — там). Проверено 03.11 (Probe hostints):
    // перс 64 ур. на фарме — 169423 → 170411 за полторы минуты
    "exp": "0x4C8",
    // Таблица «опыт до следующего уровня» — тот же код окна персонажа, что в 1.4.6, с уровнем перса +0x4B8 вместо +0x4C4; одно
    // место в exe. Проверено 03.11: в таблице 0, 55, 220, 495, 880, 1400…, для 64 ур. — 677751 (опыт перса 170411 — четверть)
    "expTableFind": "8B 86 B8 04 00 00 FF 34 85 ?? ?? ?? ?? 8D 85 F0 FB FF FF",
    "expTableAt": "0x9",
    // Выбрал моба — его WID (0x80106570), снял — 0. В 1.4.6 +0x5B4
    "targetId": "0x5A8",
    // Перезарядка корма, мс: покормил — 0 → 59859 и убывает. В 1.4.6 +0xCB4
    "petFoodCooldown": "0xC84",
    "location": "0x3C",
    // Объект скилла, пока кастуется (атака — 299), в конце 0; рядом +0x87C — цель каста. В 1.4.6 +0x87C
    "castingSkill": "0x878",
    // Копание: прошло мс (0 → 6000 на угле) и всего (6000); после конца или срыва остаются последними. В 1.4.6 +0xC0C/+0xC10.
    // Копает ли — id ресурса +0x894 (0 — нет): пишет обработчик «начало сбора» (0x309270, сообщение 0x7E: [edi+0x894] = esi,
    // ниже +0xBE0 = секунды × 1000 и +0xBDC = 0), обнуляет «конец сбора» (0x7F, та же функция). В 1.4.6 +0x898.
    // Пишет только для ресурсов с флагом — обычно копание видно лишь по работе «сбор» (gatherWork)
    // Байт +0x28C (0 — копает, запись 04.10) — не признак копания: в воде он 0 и без копания (в бою 1) — бот видел «копает» и стоял
    "gatherTarget": "0x894",
    "gatherElapsed": "0xBDC",
    "gatherTotal": "0xBE0",
    // Менеджер петов: его берёт кнопка призыва (0x31E670: mov edi, [esi+0x1948]). В 1.4.6 +0x1980
    "petManager": "0x1948",
    // Менеджер работ: 37 инструкций 0x1968 → 0x1930
    "workMan": "0x1930",
    // Сумка: 32 ячейки, банки/корм/кирка 3073 на месте. В 1.4.6 +0x10C4
    "inventory": "0x1090",
    // Банк (хранилище), основная вкладка: контейнер с тем же устройством, что сумка. Найдено по коду клиента: функция «контейнер по
    // номеру» (switch по where: 0 — сумка +0x1090, 3 — банк +0x10CC, 4 и 5 — дополнительные вкладки +0x10D0 и +0x10D4), её
    // вызывают c2s-функции переноса предметов
    "bank": "0x10CC",
    // Надетые вещи: контейнер с тем же устройством, что сумка, ячейка — место (0 — оружие, 1 — шлем…; 38 ячеек). Как найти на
    // другом клиенте: обработчик кнопки «Починить все» лавки (команда «repairall» окна Win_Shop) первым делом берёт это поле перса
    // и проходит по его ячейкам, сравнивая прочность (itemDurability). Проверка: Probe snapshot — «надето» как в окне персонажа
    "equipment": "0x1094",
    // Ячейка полётника (крылья, меч) в надетых вещах ("equipment"): есть в ней вещь — бот взлетает, нет — даже не пробует.
    // Как найти на другом клиенте: надеть полётник, Probe snapshot — «надето», место с ним. Проверено в игре на всех трёх: 12
    "flyerSlot": 12,
    // Сумка заданий: как найти, см. comeback146.jsonc. Не проверено
    "questItems": "",
    // Объект заданий (CECTaskInterface, первым полем vtable): +4 — сам перс, +8 — список принятых заданий (см. "quests").
    // Как найти на другом клиенте: поле перса с объектом, у которого [+4] = перс, а [+8] — список, первый байт которого — число
    // записей; в коде — функция окна заданий (рядом push строки "Btn_TreasureMap") берёт его из [[game+0x2C] + смещение]
    "quests": "0x1938",
    // Скиллы друида 167, 299, 328, 329, 330. В 1.4.6 +0x1994/+0x1998
    "skills": "0x195C",
    "skillsCount": "0x1960",
    // Где персонаж: взлёт — 2, приземлился — 0 (запись 04.10). Рядом +0x80C бит 0x10 — тоже «летит». В 1.4.6 +0x798
    "moveEnv": "0x790"
  },

  // Как в 1.4.6. Призыв: +0x8 -1 → 0, +0x64 = WID пета; отзыв — обратно -1 и 0
  "petManager": {
    "activeCage": "0x8",
    "cages": "0x10",
    "cageCount": 20,
    "activePetWid": "0x64"
  },

  // Как в 1.4.6: tid 10492 «Молодой узорчатый скорпион» — среда 0 (земля), 10521 «Молодая лиственная пчела» — 2 (воздух)
  "pet": {
    "hpRatio": "0x1C",
    "hunger": "0x8",
    "tid": "0xC",
    "essence": "0x190",
    "essenceName": "0x8",
    "essenceInhabit": "0x1E8",
    // HP пета в единицах игра не хранит — его считает окно пета (CDlgPetDetail): макс = (int)((уровень − levelRequire × hpB + hpC)
    // × hpA), всё во float; сейчас = (int)(макс × доля HP). Уровень — в данных пета (level), остальное — в записи справочника:
    // +0x150 int, +0x158, +0x15C, +0x160 float. Как найти: в функции окна с L"%d/%d" — умножение на долю HP (+0x1C), а перед ним
    // эти четыре поля записи и уровень пета. Как в 1.4.6; сверено с окном пета:
    // пчела ур. 60 — 1530, скорпион ур. 32 — 929
    "level": "0x24",
    "essenceLevelRequire": "0x150",
    "essenceHpA": "0x158",
    "essenceHpB": "0x15C",
    "essenceHpC": "0x160"
  },

  // Как в 1.4.6: обход совпал со счётчиками (14 мобов, 4 ресурса)
  "world": {
    "world": "0x14",
    "slotCount": 769,
    "objectInSlot": "0x4",
    "npcs": { "manager": "0x20", "slotArray": "0x20", "count": "0x18" },
    "groundItems": { "manager": "0x24", "slotArray": "0x1C", "count": "0x14" },
    // Другие игроки: [мир + 0x1C], раскладка менеджера как у мобов (счётчик +0x18, 769 ячеек +0x1C, массив +0x20), в узле
    // +0x8 — WID. Как найти: соседний с мобами менеджер мира, где обход даёт объекты с ником по смещению ника перса.
    // Проверено 31.10 в людном месте: обход совпал со счётчиком (52), ники и расстояния — как вокруг перса
    "players": { "manager": "0x1C", "slotArray": "0x20", "count": "0x18" }
  },

  // Удары: кто, кого, сколько урона — менеджер атак мира (CECAttacksMan, имя класса есть в exe). Игра кладёт туда каждый удар
  // и скилл по цели, когда пришёл ответ сервера, и убирает после попадания (живёт 0,4…2 с) — читать раз в 250 мс хватает.
  // Как найти: строка «CECAttacksMan::CECAttacksMan(), failed to load multi skill sgc config file» — в конструкторе; его зовёт
  // создание мира и кладёт результат в [мир + manager] (рядом мобы +0x20 и предметы +0x24). Список событий (AList2) — с +0x10:
  // +0x14 первый узел; узел: +0x0 следующий, событие с +0x8. Раскладка события — в функции «попадание» (её зовёт Tick
  // менеджера, vtable[2]): +0x8 сколько мс живёт, +0x14 кто бьёт, +0x30 скилл, +0x1C массив целей по 0x18 байт, +0x28 сколько
  // целей; в цели +0x0 кого, +0x8 флаги, +0xC урон (его игра и показывает над целью). Всё как в
  // 1.4.6; проверено на живом клиенте: Probe attacks показывает удары пета и мобов с уроном, лечение пета и названия скиллов
  "attacks": {
    "manager": "0x30",
    "head": "0x14",
    "event": "0x8",
    "lived": "0x8",
    "attacker": "0x14",
    "skill": "0x30",
    "targets": "0x1C",
    "targetCount": "0x28",
    "targetSize": "0x18",
    "targetFlags": "0x8",
    "targetDamage": "0xC"
  },

  // Сообщения окна чата (последние до 200): глобальный список {начало, конец, ?, сколько} в данных exe. Адрес в профиле не
  // храним — бот находит его по коду «добавить сообщение» (здесь он на +7: mov ecx, список). Как найти на другом клиенте:
  // строка сообщения из чата (например, «Запомните это имя») → кто на неё указывает (запись в массиве) → кто указывает
  // на начало массива (глобальная переменная) → код, который её читает рядом с «cmp [список + 0xC], 200 (0xC8)».
  // Запись 0x24 байта: +0x4 канал (1 мир, 5 бой, 8 системные, 9 объявления), +0x8 текст (UTF-16, с кодами цвета),
  // +0x14 номер (по порядку), +0x20 WID отправителя (−1 у системных). Проверено 31.10: код тот же, что в comeback146, одно место; 16 сообщений мира и объявлений
  "chat": {
    "find": "8D 85 54 F6 FF FF B9 ?? ?? ?? ?? 50 E8 ?? ?? ?? ?? 81 3D ?? ?? ?? ?? C8 00 00 00 7C",
    "at": "0x7",
    "entrySize": "0x24",
    "channel": "0x4",
    "text": "0x8",
    "number": "0x14",
    "sender": "0x20",
    // После смерти персонажа игра пишет в системный канал (8), кто убил — и игрока (даже из инвиза, когда удара не видно),
    // и моба. Шаблон — строка из таблицы строк клиента (в памяти — «%s. Запомните…»; та же, что в comeback146)
    "killedBy": "%s. Запомните это имя. Так зовут вашего убийцу.",
    // После гибели пета — тоже системный канал (8), но без убийцы: его бот берёт из последних ударов по пету.
    // Строка — в таблице строк клиента, та же, что в comeback146
    "petDied": "Питомец погиб."
  },

  // Принятые задания (окно «Задания»). Список [объект заданий + 0x8]: байт +0 — сколько в нём записей (с подзаданиями), байт +4 —
  // сколько верхнего уровня («Активные N/60»). Записи по 0x20 байт с +0x8, поля подряд без выравнивания: +0 номер (ushort),
  // +2 номер записи-родителя (0xFF — нет), +3/+4 соседи, +5 первое подзадание, +7 когда взято (unix-время), +0xD указатель на
  // запись задания, +0x15 сколько убито (ushort на каждого моба цели). Как найти: в памяти номер задания (ushort) рядом с номером
  // родителя в 0x20 байтах, за ними указатель на запись с тем же номером.
  // Запись задания — из tasks.data, первым полем vtable: +0x4 номер, +0x8 название (UTF-16, бывает с кодом цвета «^ffffff»).
  // Остальное — по коду клиента. Код тот же, что в 1.4.6. Функция окна заданий (рядом push строки "Btn_TreasureMap"): тип цели — cmp [запись+0x33D], 0xC
  // перед ней; кому сдать — push [запись+0xF6] перед выводом «Персонаж, дающий награду» («%s (%d, %d)»); [запись+0x544] —
  // родитель. Мобы и предметы цели — функция прогресса задания (switch по [запись+0x33D]): тип 1 — цикл по [запись+0x34D] записям
  // массива [запись+0x351] шагом 0x1E (+0 моб, +4 сколько), счётчик — word [список + (номер записи×16 + моб)×2 + 0x1D]; тип 2 —
  // [запись+0x355] записей массива [запись+0x359] шагом 0x11 (+0 предмет, +5 сколько).
  // Проверено 01.11 в игре: дерево и названия как в окне; у «Распределителя званий» 6933 — тип 3.
  // Кому сдать (+0xF6 по коду), мобы и предметы цели в игре ещё не сверены — пусто
  "quests": {
    "active": "0x8",
    "entries": "0x8",
    "entrySize": "0x20",
    "entryId": "0x0",
    "entryParent": "0x2",
    "entryTemplate": "0xD",
    "entryKills": "0x15",
    "id": "0x4",
    "name": "0x8",
    "goal": "0x33D",
    // Кто даёт задание — tid NPC: как найти, см. comeback146.jsonc. Не проверено
    "giverNpc": "",
    "awardNpc": "",
    "monsterCount": "",
    "monsters": "",
    "monsterSize": "",
    // Предмет с моба цели и сколько нужно: как найти, см. comeback146.jsonc. Не проверено
    "monsterDrop": "",
    "monsterDropNeed": "",
    "itemCount": "",
    "items": "",
    "itemSize": "",
    "itemNeed": "",
    // Доступные задания: как найти — см. comeback146.jsonc. Не проверено
    "availableFind": "",
    "availableAt": "",
    "available": "",
    // Все задания верхнего уровня и границы уровня в записи: как найти, см. comeback146.jsonc. Не проверено
    "all": "",
    "minLevel": "",
    "maxLevel": "",
    "rebirthLevel": "",
    // Дерево заданий и «выполнить одно из подзаданий»: как найти, см. comeback146.jsonc. Не проверено
    "firstChild": "",
    "nextSibling": "",
    "chooseOne": ""
  },

  // Другой игрок. У игры это тот же класс, что наш персонаж: ник, WID и координаты — на тех же смещениях, что в "host"
  // (как найти: смещения перса; в узле списка игроков +0x8 — тот же WID). Проверено 31.10 в людном месте.
  // Уровень и HP игра знает только у игрока, которого выделили (у остальных — нули). Проверено 31.10: выделенный лучник — ур. 103, HP 9457/9457;
  // его цель — другой игрок рядом
  "player": {
    "wid": "0x4AC",
    "namePointer": "0x780",
    "location": "0x3C",
    "level": "0x4B8",
    "hp": "0x4C0",
    "maxHp": "0x524",
    "target": "0x5A8",
    // Класс — int сразу за указателем на ник. Номера как в игре: 0 воин, 1 маг, 2 шаман, 3 друид, 4 оборотень, 5 убийца,
    // 6 лучник, 7 жрец, 8 страж, 9 мистик. Проверено 31.10: у перса-друида — 3, у игроков рядом — только 0…9. Как найти:
    // поле, где у перса и у игрока другого класса разные маленькие числа (у перса то же смещение)
    "class": "0x784"
  },

  // Пати: как найти, см. comeback146.jsonc. Не проверено
  "party": {
    "team": "0x850", "leader": "0x4", "members": "0x14", "memberCount": "0x18", "memberWid": "0xC", "memberLevel": "0x10",
    "memberHp": "0x1C", "memberMp": "0x20", "memberMaxHp": "0x24", "memberMaxMp": "0x28", "memberHasLocation": "0x30",
    "memberLocation": "0x34", "memberClass": "0x44", "nameTable": "0x54", "nameNodeWid": "0x4", "nameNodeName": "0x8"
  },

  // Моб — всё как в 1.4.6 (сопоставление кода: каждое поле осталось на месте, десятки инструкций). Сверено вживую:
  // названия, уровни, тип 6/9, дистанция = расчёт по координатам, запись справочника (+0x3A4) с id вида моба
  "npc": {
    "wid": "0x114",
    // Вид моба или NPC (tid) — как в 1.4.6 (что это и как найти — см. comeback146.jsonc). Проверено 04.11: у каждого вида рядом
    // равен id его записи в справочнике (Росток росянки 3304, Изумрудный мотыль 1001, Король небесных волков 1746)
    "tid": "0x118",
    "type": "0xB4",
    "state": "0x2DC",
    "hp": "0x128",
    // Максимум HP — только у выбранной цели, как в 1.4.6 (как найти — см. comeback146.jsonc). Проверено 04.11: Росток росянки в
    // цели — HP 29 → 25 → 15, здесь всё время 29
    "maxHp": "0x18C",
    "target": "0x210",
    "castTarget": "0x2FC",
    "attackTarget": "0x2F8",
    "level": "0x120",
    // Расстояние до персонажа, которое держит игра (float, по горизонтали). Бот его не читает — считает из координат;
    // нужно только Probe selftest: «расчёт = память» ловит ошибку в смещении location. Не найдено — убрать строку
    "distance": "0x294",
    "namePointer": "0x26C",
    "location": "0x3C",
    "essence": "0x3A4",
    // «Возвращается» (отагр): то же место и флаг, что в 1.4.6 (45 инструкций кода). Проверено в игре 04.10: скарабей бил перса,
    // перс взлетел на 13 м — флаг встал ровно в момент разворота моба (агр 5 с), цель +0x210 в этот момент ещё показывала перса
    "returning": "0x22C",
    "returningFlag": "0x20000"
  },

  // Как в 1.4.6: банки (категория 9), корм (27), кирка 3073 — кроме указателей на описание: они на 8 ближе
  "inventory": {
    "items": "0xC",
    "size": "0x10",
    "itemCategory": "0x8",
    "itemTid": "0xC",
    "itemCount": "0x14",
    "itemMaxCount": "0x18",
    // Цена продажи одной штуки в лавке — её клиент кладёт в пакет продажи (см. sendPacket). Как найти на другом клиенте: метод
    // персонажа «продать корзину» (его зовёт ответ «Да» в окне Game_SellOut) берёт из предмета корзины +0xC (tid) и это поле;
    // у предметов класса 0x37 (поле itemCategory) клиент ещё умножает его на поле персонажа +0x1A08
    "itemPrice": "0x1C",
    // Прочность надетой вещи — текущая и наибольшая, в сотых (меч 46/66 в подсказке — 4600/6600). Флаги вещи: бит 0x1000 —
    // «не чинится». Как найти на другом клиенте: обработчик «Починить все» (см. host.equipment) у каждой вещи пропускает
    // ту, у которой в флагах этот бит, и сравнивает два поля прочности (cmp [eax+0x84], [eax+0x88]) — чинить, если меньше
    "itemDurability": "0x84",
    "itemMaxDurability": "0x88",
    "itemFlags": "0x38",
    "flagNoRepair": "0x1000",
    // Вещь (оружие, броня, украшение): +0x28 — куда надевается, маска мест, 8 байт (меч 1, шлем 2, ожерелье 4…); у банок, корма,
    // материалов — 0. Так вещь отличает и сам клиент: обработчик «Починить все» берёт только предметы с этой маской не 0.
    // Ячейки под камни и свойства — массивы клиента (указатель, число, ёмкость): ячейки +0xAC/+0xB0 — tid камня по 4 байта,
    // 0 — пустая; свойства +0xC0/+0xC4 — записи по 0x1C: +0x0 номер свойства (тип — в configs.pck → item_ext_prop.txt),
    // +0x4 сколько чисел, +0xC числа. Проверено на 14 надетых вещах: у меча 441 → 3 («Время активации -3%»), 815 → 29
    // («Магическая атака +29»), 1273 → 2 («Уменьшение физического урона +2%») и одна пустая ячейка. Как найти на другом
    // клиенте: у вещи с ячейкой найти поле-указатель на массив из стольких же чисел (рядом их количество); через 0x14 байт за
    // ним — такой же массив свойств, номера — как в item_ext_prop.txt
    "itemEquipMask": "0x28",
    "itemSockets": "0xAC",
    "itemSocketCount": "0xB0",
    "itemAddons": "0xC0",
    "itemAddonCount": "0xC4",
    "addonSize": "0x1C",
    "addonParamCount": "0x4",
    "addonParams": "0xC",
    // Указатель на описание (в нём +0x0 тот же tid): банка 8614 — HP 1000 за 10 с, 8644 — MP 1250 за 10 с; корм «Чистая вода» — 10.
    // В 1.4.6 +0x78 и +0x70; сопоставление кода этого не показало (те же числа у других структур) — нашлось проверкой банок вживую
    "itemEssence": "0x70",
    "foodEssence": "0x68",
    "categoryPotion": 9,
    "categoryPetFood": 27,
    // Яйцо питомца: как найти, см. comeback146.jsonc. Не проверено
    "categoryPetEgg": "",
    // Название и группа любого предмета (для «убирать в банк»): в первых essenceSearch байтах предмета ищется указатель на
    // описание, у которого +0x0 — тот же tid; место указателя у разных классов предметов разное (проверено в игре: банка и материал +0x70, корм/кирка/камень +0x68; вещей в сумке не было).
    // Дальше название — по раскладкам itemEssences (с типом), а у записи без типа — +plainName. Как проверить на другом
    // клиенте: Probe snapshot — у предметов сумки названия и [группа]
    "essenceSearch": "0x200",
    "plainName": "0x4"
  },

  // Описание банки — как в 1.4.6 (то же место в коде)
  "potion": {
    "requiredLevel": "0x14C",
    "hp": "0x154",
    "hpSeconds": "0x158",
    "mp": "0x15C",
    "mpSeconds": "0x160"
  },

  // Описание корма в справочнике игры (на него указывает foodEssence предмета): +0x0 tid корма, +0x4 название (UTF-16,
  // 32 символа), +0x148 верность — сколько даёт корм («Чистая вода» 10, «Зеленая трава» 20). Как найти: корм в сумке →
  // описание; название — строка сразу за tid, верность — число из подсказки корма в игре
  "petFood": {
    "loyalty": "0x148",
    "name": "0x4"
  },

  "skill": {
    "id": "0x8",
    "level": "0xC",
    "cooldownLeft": "0x10",
    "cooldownFull": "0x14",
    "flags": "0x18"
  },

  // Макросы персонажа: в настройках игры с +0x159, 8 штук по 0x11 байт — байт иконки (0 — макроса нет, у первого — 1) и 8
  // скиллов по 2 байта (-1 — обычная атака, -2 — повтор). Как найти: функция, которую зовёт запуск макроса, проверяет
  // номер ≤ 7 и копирует [настройки + номер×0x11 + 0x159] — 16 байт и ещё один
  // Идёт ли макрос (running, done): как найти — см. comeback146.jsonc. Не проверено
  "macros": { "list": "0x159", "size": "0x11", "count": 8, "running": "", "done": "" },

  "gatherTools": [ 3073 ],

  // Как в 1.4.6. Тип работы «идти» (1) тот же: случай 1 в CreateWork создаёт объект того же размера 0x7C
  // Копает ли — по работе «сбор» (тип 0xB, байт +0x28 = 1), как у PW Classic: её заводит обработчик «начало сбора» (0x309270:
  // workCreate(0xB), [работа+0x28] = 1, StartWork(1, …)); id ресурса (host.gatherTarget) он пишет только для ресурсов с флагом —
  // обычно его нет. Работы у менеджера — списками по уровням: [+0x38] — уровень, у уровня L массив [+L×0x10+8] и число
  // [+L×0x10+0x14]. Живой клиент: копает — уровень 1, одна работа типа 0xB с байтом 1; выкопал или прервал — список
  // сразу пуст (а «прошло» +0xBDC ещё тикает до конца полоски); бежит к ресурсу — работа типа 2
  "gatherWork": { "current": "0x18", "currentCount": "0x24", "type": "0x4", "gather": "0xB", "flag": "0x28" },

  // Что сделать у NPC после сдачи задания: как устроено, см. comeback146.jsonc. Задания этого сервера не проверены
  "questScripts": {},

  "moveTypes": { "direct": 0, "smart": 5, "fly": 1 },

  // Пакет продажи (см. sendPacket): размер записи — 0x10 (tid, ячейка сумки, сколько, цена штуки). Как найти на другом
  // клиенте: в методе «продать корзину» после команды 0x25 с услугой 2 — сдвиг числа записей (shl 4 — 0x10; ×0xC — без
  // цены) и что кладётся в запись; проверено в игре: продажа одной, трёх ячеек и целой стопки
  "packets": {
    "sellEntrySize": "0x10",
    // Услуги NPC «выучить скилл» и «вывести питомца»: как найти, см. comeback146.jsonc. Не проверено
    "learnSkillService": "",
    "hatchPetService": "",
    // «Ассист» члена пати: как найти, см. comeback146.jsonc. Не проверено
    "teamAssistCommand": "",
    // «Следовать» за игроком: как найти, см. comeback146.jsonc (функция postMessage там же). Не проверено
    "followMessage": ""
  },

  // Окна игры: [game + 0x10] — менеджеры окон; [+0x8] — окна в мире (CECGameUIMan), если [+0xC] = 1; в них [+0x734] — окно
  // разговора с NPC (CDlgNPC, имя «Win_NPC» в поле окна +0x4C). Как найти на другом клиенте: код, который зовёт окно по имени
  // «Win_NPC» — перед ним «mov eax,[база]; mov eax,[eax+0x1C]; mov eax,[eax+0x10]; mov ecx,[eax+8]; cmp [eax+0xC],1»; а поле
  // окна в CECGameUIMan — в функции, что создаёт все окна мира: строка "Win_NPC" и RTTI CDlgNPC, результат кладётся в
  // [this+0x734]. Проверено чтением живого клиента: по пути лежит окно с именем «Win_NPC»
  // Окно лавки (CDlgShop, имя «Win_Shop») — поле "shopDialog" того же CECGameUIMan. Как найти на другом клиенте: в функции,
  // что создаёт все окна мира, — строка "Win_Shop" и RTTI CDlgShop (.?AVCDlgShop@@), результат dynamic_cast кладётся в
  // [this+0x7E0] (как в 1.4.6)
  "ui": { "managers": "0x10", "inGame": "0x8", "active": "0xC", "npcDialog": "0x734", "shopDialog": "0x7E0" },

  // Карта кода, который сервер присылает для исполнения в клиенте (приёмник команд античита). Бот её только ЧИТАЕТ
  // (Probe code). В 1.3.6 механизм тот же: приёмник найден по тому же прологу (0x4B36F0), вызов из 0x4B41A2,
  // голова карты 0xCB437C, вектор записей 0xCB4384, очередь вызовов 0xCB4394. На живом клиенте ещё НЕ проверено —
  // поэтому пусто: значение впишем после Probe на запущенной игре, как и у остальных новых полей.
  "serverCode": {
    "mapHead": "",
    "ownKeyMin": "",
    "codeBytes": ""
  },

  "skills": {
    "healPet": 330,
    "revivePet": 329,
    "defaultAttack": 299,
    "notAttack": [ 167, 329, 330 ]
  },

  // Как в 1.4.6: «Шахта крупного угля», «Высохший древесный корень» — вид 2, дистанция = расчёт
  "groundItem": {
    "id": "0x110",
    "tid": "0x114",
    // Вид — байт: 1 предмет, 2 ресурс, 3 монеты; следующий байт у части вещей не 0 (в pwclassic136 бывает 0x101)
    "kind": "0x150",
    // Расстояние до персонажа, которое держит игра (float, в 3D — с высотой). Бот его не читает — считает из координат;
    // нужно только Probe selftest: «расчёт = память» ловит ошибку в смещении location. Не найдено — убрать строку
    "distance": "0x158",
    "namePointer": "0x168",
    "location": "0x3C"
  },

  // Как в 1.4.6: уголь 3089 — кирка 3073, даёт 815; корень 3074 — 795; уровень 1
  "mineEssence": {
    "nameInRecord": "0x8",
    "size": "0x1C0",
    "id": "0x0",
    "tool": "0x50",
    "materials": "0xE8",
    "materialSlots": 16,
    "amounts": "0x1A8",
    "quest": "0x1B8",
    "levelRequired": "0x4C"
  },

  // Записи предметов в справочнике (elements.data в gamedata.pck), в которых есть тип: указатель на название у предмета на земле
  // (groundItem.namePointer) ведёт внутрь записи, перед названием — tid и тип. Две раскладки, как в pwclassic136: оружие, броня,
  // украшения, банки, материалы — +0x0 tid, +0x4 тип, +0x8 подтип, +0xC название; снаряды — +0x0 tid, +0x4 тип, +0x8 название.
  // Бот пробует обе: годится та, где на месте tid — tid предмета (у другой там чужое число). Сверено на живом клиенте 27.10:
  // «☆Шлем "Голова тигра"» 322 — Броня, «Рука Будды» 8088 — Предметы ДК, «☆Ожерелье из зеленого нефрита» 251 — Украшения.
  // Как найти на другом клиенте:
  // 1. Выложить на землю вещь с типом (оружие, броню или банку) и снаряд. Probe snapshot — их tid в строке «Лут».
  // 2. В elements.data (внутри gamedata.pck, ключи — gameFiles.pck) найти 4 байта tid, за которыми через 8 байт (у снаряда —
  //    через 4) идёт название предмета в UTF-16. Сдвиг названия от tid — nameInRecord, 4 байта сразу за tid — тип. В памяти
  //    клиента запись лежит так же, как в файле.
  // 3. Тип сверить со списками типов (как их найти — у lootGroups): например, 1 — «Мечи», 8548 — «Праща».
  // 4. После правки Probe snapshot пишет у предмета на земле [группу]. Нет её у предмета из группы — раскладка не та.
  "itemEssences": [
    { "nameInRecord": "0xC", "id": "0x0", "type": "0x4" },
    { "nameInRecord": "0x8", "id": "0x0", "type": "0x4" }
  ],

  // Группы лута — по типу предмета в справочнике (тип читается по itemEssences). Данные игры, одинаковы на трёх серверах.
  // Оружие: мечи, копья, топоры/молоты, дальнобойное, кастеты, бичи, магическое, кинжалы, сферы, сабли, косы (сабли и косы есть
  // только на Comeback). Броня: верх, низ, обувь, голова, наручи, накидка. Украшения: ожерелье, пояс, кольцо. Банки: ЖС, МЭ,
  // ЖС и МЭ, детоксикатор, мгновенное противоядие. Снаряды: стрела, болт, пуля. Предметы ДК — тип материала 8077: подтипы
  // «Особые товары ур.1…10» по 10 предметов (с мобов падают 6), ур.2…9 — квесты «Искатель драконов» 20…91 по описанию предметов
  // (configs.pck → item_ext_desc.txt).
  // Как найти номера типов на другом клиенте: в elements.data списки типов — записи подряд по 68 байт (+0x0 id, +0x4 название
  // UTF-16, 32 символа); у оружия, брони, украшений и банок 4 байта перед первой записью — число записей. Найти в UTF-16 название
  // первой записи, id — 4 байта перед ним: оружие — 1 «Мечи», броня — 125 «Верх», украшения — 171 «Ожерелье», банки — 1794
  // «Восстанавливается ЖС», снаряды — 8546 «Стрела» (на Comeback — «Лук»). Новый тип на сервере — новая запись в том же списке
  // (так нашлись сабля 44878 и коса 44879 на Comeback). Тип ДК — 4 байта за tid в записи любого предмета ДК («Бивень» 8099); в
  // списке типов материалов он называется «Деньги дешевеют, цены падают».
  // Корм пета — списком tid: в его записи типа нет (+0x0 tid, +0x4 название, +0x148 верность, как в petFood; запись 0x168 байт),
  // 16 предметов, одни на трёх серверах. Как найти: в elements.data найти tid 8796, за которым сразу «Чистая вода» в UTF-16, — это
  // первая запись списка корма; 4 байта перед ней — число записей (16), дальше записи подряд по 0x168 байт, tid — первые 4 байта
  // каждой. Проверка: Probe snapshot показывает корм в сумке строкой «корм … (tid …)», на земле — с [Корм пета].
  // Счастливые билеты — предметы-сюрпризы (правой кнопкой — случайное задание с наградой) по уровням: карта (любой), билет
  // (с 20), мешок (с 50), коробка (с 70), звезда (с 90). С мобов падают 11092, 11094, 11096, 11098, 11101, остальные tid —
  // двойники с тем же названием. Тоже списком tid: это записи списка «предметы, дающие задание» (+0x0 tid, +0x4 название, дальше
  // до 8 заданий с вероятностями), типа в них нет. Одни tid на трёх серверах. Как найти: в elements.data найти в UTF-16
  // «Счастливая карта», «Счастливый билет», «Счастливый мешок», «Счастливая коробка», «Счастливая звезда» — tid в 4 байтах перед
  // названием; описание (configs.pck → item_ext_desc.txt) — «…сюрприз» или «ценный подарок» и «с N уровня». На Comeback так же
  // называются свадебный «Счастливый билет» 32083 (обмен на наряд) и «Счастливая карта усердия…доброты» 39220…39229 (задание
  // «Удача») — это другое, с мобов не падает, в группу не входит. Проверка: Probe snapshot — у билета на земле [Счастливые билеты].
  // Название группы хранится в настройках персонажа — не переименовывать
  "lootGroups": [
    { "name": "Оружие", "types": [ 1, 5, 9, 13, 182, 291, 292, 23749, 25333, 44878, 44879 ] },
    { "name": "Броня", "types": [ 125, 150, 216, 316, 346, 369 ] },
    { "name": "Украшения", "types": [ 171, 234, 247 ] },
    { "name": "Банки", "types": [ 1794, 1802, 1810, 1815, 2038 ] },
    { "name": "Снаряды", "types": [ 8546, 8547, 8548 ] },
    { "name": "Предметы ДК", "types": [ 8077 ] },
    { "name": "Корм пета", "tids": [ 8796, 9757, 9758, 9759, 9760, 9761, 11550, 11551, 11552, 11553, 11554, 11580, 11581, 12842, 18251, 26977 ] },
    { "name": "Счастливые билеты", "tids": [ 11092, 11093, 11094, 11095, 11096, 11097, 11098, 11099, 11100, 11101, 11102, 11103,
                                             13606, 13607, 13608, 13609, 13610, 13611, 13612 ] }
  ],

  // Как в 1.4.6 (125 и 39 инструкций — то же место); у мирных мобов здесь 0, радиус 6
  "monsterEssence": {
    "aggressive": "0x2B8",
    "aggroRadius": "0x260",
    // Где обитает — +0x2CC, как в 1.4.6 (коды и как найти — там). Проверено 03.11 (Probe mobessence): Лесная оса, которую перс
    // фармит в воздухе, — 2; земные внизу (Скелет-стрелок, Молодая рысь, Молодой горный соболь…) — 0
    "inhabit": "0x2CC"
  },

  // Функции — те же, что в 1.4.6 (там описано, что каждая делает), с тем же числом аргументов (ret N сверен у каждой).
  // В скобках — адрес в 1.4.6
  "functions": {
    // (0x3411F0) — сигнатура из 1.4.6 подошла как есть
    "selectTarget": { "rva": "0x321E10", "convention": "thiscall", "this": "host", "args": [ "wid" ],
                      "signature": "55 8B EC 83 EC 08 53 56 57 6A 12 8B" },
    "unselect": { "rva": "0x321E10", "convention": "thiscall", "this": "host", "args": [ "0" ],
                  "signature": "55 8B EC 83 EC 08 53 56 57 6A 12 8B" },
    // (0x351D30) c2s 0x03
    "normalAttack": { "rva": "0x3322C0", "convention": "stdcall",
                      "signature": "55 8B EC 83 EC 08 56 68 ?? ?? ?? ?? FF 15 ?? ??" },
    // Открыть удалённую панель, как кнопки «Банк / Почта / Лавка» в окне сумки (Btn_RemoteBank, Btn_RemoteMail, Btn_RemoteShop):
    // c2s, команда 0xE3, пакет 6 байт [0xE3 0x00][панель:4], stdcall с одним аргументом (ret 4). Панель: 1 — банк, 2 — почта,
    // 3 — лавка; открывается ответом сервера, работает и в бою. Как найти на другом клиенте: строка «Btn_RemoteBank» в exe
    // встречается один раз — в таблице команд окна; рядом с ней указатель на обработчик (3 обработчика подряд), он проверяет
    // состояние перса и вызывает эту функцию с push 1/2/3.
    "openRemotePanel": { "rva": "0x176200", "convention": "stdcall", "args": [ "panel" ],
                         "signature": "55 8B EC 56 6A 06 FF 15 ?? ?? ?? ?? 8B F0 83 C4 04 85 F6 74 ?? 8B 4D 08 B8 E3 00 00 00" },

    // Начать разговор с NPC — c2s 0x23, как клик по нему: сервер отвечает списком услуг, клиент открывает окно Win_NPC. Метод
    // объекта связи (this = [[база]+0x20], ret 4), аргумент — WID NPC; пакет 6 байт. Как найти на другом клиенте: функция
    // начинается с «mov dword [ebp-4], 0x23» (C7 45 FC 23 00 00 00) — одно место в exe; её зовёт обработчик клика по NPC.
    "npcHello": { "rva": "0x1CB840", "convention": "thiscall", "this": "session", "args": [ "wid" ],
                  "signature": "55 8B EC 83 EC 08 56 8D 45 FC C7 45 FC 23 00 00 00" },

    // (0xFC530) Встать в ближайшем городе после смерти — c2s 0x04, кнопка «Ближний город» окна смерти (что делает и как найти —
    // в 1.4.6). Сигнатура из 1.4.6 подошла как есть, одно место в exe; тело функции то же, ret 4. В игре ещё не нажато
    "reviveInTown": { "rva": "0xF5F00", "convention": "thiscall", "this": "session", "args": [ "0" ],
                      "signature": "55 8B EC 51 8D 45 FC C7 45 FC 04 00 00 00 50 81 C1 04 01 00 00 E8 ?? ?? ?? ?? 8B 08 8B 01 3B 41 04 72 ?? 56 6A 06 C7 01 00 00 00 00 FF 15 ?? ?? ?? ?? 8B F0 83 C4 04 85 F6 74 ?? 8B 4D 08 B8 04 00 00 00" },

    // Открыть банк у банкира — c2s 0x25 «услуга NPC» с услугой 0x0F «открыть хранилище», как пункт «Услуги хранения» в окне NPC:
    // разговор с NPC начат (npcHello); на 1.4.6 и PW Classic хватает стоять рядом с банкиром, здесь без разговора не проверено.
    // stdcall, один аргумент — строка пароля банка (ret 4); без пароля клиент шлёт "".
    // Пакет: [0x25:2][услуга 0x0F:4][длина данных = 4 + длина пароля:4][длина пароля:4][пароль]. Как найти на другом клиенте:
    // одно место в exe, где пишется «mov dword [reg+2], 0x0F» рядом с «mov eax, 0x25»; её зовут окно NPC (с пустой строкой) и
    // окно ввода пароля Win_InputString. Соседняя услуга 0x0E — смена пароля банка.
    "npcOpenStorage": { "rva": "0x19D8C0", "convention": "stdcall", "args": [ "data" ],
                        "signature": "55 8B EC 53 56 57 8B 7D 08 33 F6 85 FF 74 ?? 80 3F 00 74 ?? 8B F7 8D 4E 01 0F 1F 80 00 00 00 00 8A 06 46 84 C0 75 F9 2B F1 8D 46 0E 50 FF 15 ?? ?? ?? ?? 8B D8 83 C4 04 85 DB 74 ?? C7 43 02 0F 00 00 00 B8 25 00 00 00" },

    // Сдать задание — c2s 0x25 «услуга NPC» с услугой 6 «сдать задание», как пункт «сдать» в окне NPC: разговор с NPC уже начат
    // (npcHello). stdcall, 2 аргумента (ret 8): номер задания, номер выбранной награды (0 — первая / без выбора). Пакет 18 байт:
    // [0x25:2][услуга 6:4][длина данных 8:4][задание:4][награда:4]. Рядом услуга 7 — взять задание. Как найти на другом клиенте:
    // место в exe, где пишется «mov dword [reg+2], 6» и «mov dword [reg+6], 8» рядом с «mov eax, 0x25».
    // Проверено 01.11 в игре: «Распределитель званий» 6933 сдано, пропало из списка вместе с родителем.
    "npcReturnTask": { "rva": "0xDD380", "convention": "stdcall", "args": [ "task", "choice" ],
                       "signature": "55 8B EC 51 56 6A 12 FF 15 ?? ?? ?? ?? 8B F0 83 C4 04 85 F6 74 ?? 8B 0D ?? ?? ?? ?? B8 25 00 00 00 66 89 06 8B 45 08 6A 12 8B 49 20 89 46 0A 8B 45 0C 56 C7 46 02 06 00 00 00 C7 46 06 08 00 00 00" },

    // Взять задание — c2s 0x25 «услуга NPC» с услугой 7 «взять задание», как пункт задания в окне NPC: разговор с NPC уже начат
    // (npcHello). stdcall, 3 аргумента (ret 0xC): номер задания (из tasks.data, как в "quests"), склад заданий и обновление склада
    // (0 — обычное задание, не из «доски заданий»). Пакет 22 байта: [0x25:2][услуга 7:4][длина данных 0xC:4][задание:4][склад:4]
    // [обновление:4]. Как найти на другом клиенте: единственное место в exe, где пишется «mov dword [reg+2], 7» и
    // «mov dword [reg+6], 0xC» рядом с «mov eax, 0x25». Код тот же, что в 1.4.6; в игре на этом клиенте ещё не проверено
    "npcAcceptTask": { "rva": "0x19D860", "convention": "stdcall", "args": [ "task", "storage", "refresh" ],
                       "signature": "55 8B EC 56 6A 16 FF 15 ?? ?? ?? ?? 8B F0 83 C4 04 85 F6 74 ?? 8B 0D ?? ?? ?? ?? B8 25 00 00 00 66 89 06 8B 45 08 89 46 0A 8B 45 0C 8B 49 20 6A 16 89 46 0E 8B 45 10 56 C7 46 02 07 00 00 00 C7 46 06 0C 00 00 00 89 46 12" },

    // Переложить в сумке — c2s 0x0D: перенести N штук из одной ячейки сумки в другую; в пустую ячейку — разделить стопку. stdcall,
    // 3 аргумента (откуда, куда, сколько), ячейки с 0, ret 0xC; обе ячейки помечаются «занято» (+0x3B у предмета), снимет ответ
    // сервера. Пакет 8 байт: [команда:2][откуда][куда][число:4]. Рядом идут 0x0C (обмен ячеек сумки) и 0x0E (выбросить). Как найти
    // на другом клиенте: c2s-функция с командой 0x0D и пакетом в 8 байт, лежит рядом с 0x38…0x3C (перенос в банк).
    "bagMove": { "rva": "0x41BA00", "convention": "stdcall", "args": [ "from", "to", "count" ],
                 "signature": "55 8B EC 8B 15 ?? ?? ?? ?? 8B 42 1C 8B 40 28 85 C0 74 ?? 8B 80 ?? ?? ?? ?? 85 C0 74 ?? 8B 4D 08 85 C9 78 ?? 3B 48 10 7D ?? 8B 40 0C 8B 04 88 85 C0 74 ?? C6 40 33 01 8B 42 1C 53 8B 5D 0C 56 8B 40 28 85 C0 74 ?? 8B 80 ?? ?? ?? ?? 85 C0 74 ?? 85 DB 78 ?? 3B 58 10 7D ?? 8B 40 0C 8B 04 98 85 C0 74 ?? C6 40 33 01 6A 08 FF 15 ?? ?? ?? ?? 8B F0 83 C4 04 85 F6 74 ?? 8B 0D ?? ?? ?? ?? B8 0D 00 00 00 66 89 06 8B 45 08 6A 08 8B 49 20 88 46 02 8B 45 10 56 88 5E 03 89 46 04 E8 ?? ?? ?? ?? 56 FF 15 ?? ?? ?? ?? 83 C4 04 5E 5B 5D C2 0C 00" },

    // Перенос между сумкой и банком — c2s 0x3A: обмен ячейки банка и ячейки сумки местами, без числа (стопка целиком); в пустую
    // ячейку — просто перенос. Так клиент кладёт предмет в пустую ячейку банка и берёт из банка в пустую ячейку сумки.
    // stdcall, 3 аргумента в стеке (ret 0xC): (вкладка банка — для основной 3, ячейка банка, ячейка сумки), ячейки с 0.
    // Перед отправкой обе ячейки помечаются «занято» (+0x3B у предмета), снимет ответ сервера. Пакет 5 байт: [команда:2][вкладка]
    // [ячейка банка][ячейка сумки]. Рядом в exe идут их соседи: 0x38 обмен ячеек банка, 0x39 перенос внутри банка, 0x3B/0x3C —
    // положить/взять с числом (клиент зовёт их при слиянии со стопкой того же предмета; на пустую ячейку сервер отвечает
    // «неверное действие»). Как найти на другом клиенте: в обработчике окна банка (CDlgStorage) искать вызовы c2s-функций,
    // подряд идущих по команде 0x38…0x3C, они лежат рядом друг с другом; нужная — с пакетом в 5 байт.
    "bankExchange": { "rva": "0x41BFF0", "convention": "stdcall", "args": [ "tab", "bankSlot", "slot" ],
                      "signature": "55 8B EC 51 8B 15 ?? ?? ?? ?? 53 56 8B 42 1C 8B 40 28 85 C0 74 ?? 8B 80 ?? ?? ?? ?? 85 C0 74 ?? 8B 4D 10 85 C9 78 ?? 3B 48 10 7D ?? 8B 40 0C 8B 04 88 85 C0 74 ?? C6 40 33 01 8B 42 1C 8B 5D 0C 8B 48 28 85 C9 74 ?? FF 75 08 E8 ?? ?? ?? ?? 85 C0 74 ?? 85 DB 78 ?? 3B 58 10 7D ?? 8B 40 0C 8B 04 98 85 C0 74 ?? C6 40 33 01 6A 05 FF 15 ?? ?? ?? ?? 8B F0 83 C4 04 85 F6 74 ?? 8B 0D ?? ?? ?? ?? B8 3A 00 00 00 66 89 06 8B 45 08 6A 05 8B 49 20 88 46 02 8B 45 10 56 88 46 04 88 5E 03 E8 ?? ?? ?? ?? 56 FF 15 ?? ?? ?? ?? 83 C4 04 5E 5B 59 5D C2 0C 00" },

    // Доложить в банк с числом — c2s 0x3C: N штук из ячейки сумки на стопку того же предмета в ячейке банка (как мышкой
    // бросить стопку на такую же — стопки сливаются; 0x3A на такую ячейку поменял бы их местами). stdcall, 4 аргумента
    // (ret 0x10): вкладка банка (основная 3), ячейка банка, ячейка сумки, сколько; ячейки с 0; обе ячейки помечаются «занято»
    // (+0x33 у предмета). Пакет 9 байт: [команда:2][вкладка][ячейка сумки][ячейка банка][число:4]. Соседка 0x3B — то же
    // обратно, из банка в сумку (в пакете сначала ячейка банка). Как найти на другом клиенте: c2s-функция сразу за
    // bankExchange, команда 0x3C, пакет 9 байт.
    "bankPutCount": { "rva": "0x41C170", "convention": "stdcall", "args": [ "tab", "bankSlot", "slot", "count" ],
                      "signature": "55 8B EC 8B 15 ?? ?? ?? ?? 8B 42 1C 8B 40 28 85 C0 74 ?? 8B 80 ?? ?? ?? ?? 85 C0 74 ?? 8B 4D 10 85 C9 78 ?? 3B 48 10 7D ?? 8B 40 0C 8B 04 88 85 C0 74 ?? C6 40 33 01 8B 42 1C 53 8B 5D 0C 56 8B 48 28 85 C9 74 ?? FF 75 08 E8 ?? ?? ?? ?? 85 C0 74 ?? 85 DB 78 ?? 3B 58 10 7D ?? 8B 40 0C 8B 04 98 85 C0 74 ?? C6 40 33 01 6A 09 FF 15 ?? ?? ?? ?? 8B F0 83 C4 04 85 F6 74 ?? 8B 0D ?? ?? ?? ?? B8 3C 00 00 00 66 89 06 8B 45 08 88 46 02 8B 45 10 8B 49 20 6A 09 88 46 03 8B 45 14 56 88 5E 04 89 46 05 E8 ?? ?? ?? ?? 56 FF 15 ?? ?? ?? ?? 83 C4 04 5E 5B 5D C2 10 00" },

    // Отправить пакет серверу — через неё уходят все команды игры (c2s): метод объекта связи (this = [[база]+0x20]), 2 аргумента
    // (адрес пакета, длина; ret 8), пакет она копирует к себе. Нужна там, где у команды нет своей функции: продажа в лавке —
    // клиент собирает пакет прямо в методе персонажа «продать корзину» (его зовёт ответ «Да» в окне Game_SellOut, кнопка
    // «Продать» лавки — команда «sell» окна Win_Shop). Пакет продажи: [0x25:2][услуга 2 «продать»:4][длина данных = 4 + 16·N:4]
    // [N:4], дальше N записей по 16 байт: tid, ячейка сумки, сколько, цена одной штуки (itemPrice). Корзина «Продажа» в окне
    // лавки серверу ничего не шлёт — только этот пакет. Услуга 1 рядом — покупка, 3 — ремонт предмета.
    // Как найти на другом клиенте: сразу за командой 0x25 с услугой 2 в «продать корзину» — вызов с ecx = [[база]+0x20]; та же
    // функция стоит за каждым «mov ecx,[база]; mov ecx,[ecx+0x20]; call» в функциях c2s
    "sendPacket": { "rva": "0x414F00", "convention": "thiscall", "this": "session", "args": [ "data", "size" ],
                    "signature": "55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 00 00 00 00 50 83 EC 1C 53 56 57 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3 00 00 00 00 8B F9 68 ?? ?? ?? ?? FF 15 ?? ?? ?? ?? 83 3D ?? ?? ?? ?? 00 74 0C C7 45 F0" },

    // Закрыть окно разговора с NPC — команда «IDCANCEL» окна Win_NPC (CDlgNPC), её же зовут кнопка «Назад» и Esc. this — окно
    // NPC (см. "ui"), один аргумент — имя команды (не читается, ret 4). Прячет окно и сбрасывает отметки клиента, серверу
    // ничего не шлёт. Как найти на другом клиенте: таблица команд CDlgNPC (её отдаёт второй метод таблицы методов окна) —
    // строки "back" и "IDCANCEL", у "IDCANCEL" — эта функция; начинается с «mov edi,ecx; push 1; push 0; push 0; mov eax,[edi];
    // call [eax+0x1C]» (спрятать окно)
    "npcDialogClose": { "rva": "0x19DDA0", "convention": "thiscall", "this": "npcDialog", "args": [ "0" ],
                        "signature": "55 8B EC 51 56 57 8B F9 6A 01 6A 00 6A 00 8B 07 FF 50 1C 6A 00 68 ?? ?? ?? ?? 68 ?? ?? ?? ?? 6A 00 FF 77 34 E8 ?? ?? ?? ?? 6A 00 68 ?? ?? ?? ?? 68 ?? ?? ?? ?? C7 80 ?? ?? 00 00 00 00 00 00 A1 ?? ?? ?? ?? 6A 00 8B 40 1C 8B 40 28" },

    // Закрыть лавку — команда «IDCANCEL» окна Win_Shop (CDlgShop), её же зовут крестик и Esc. this — окно лавки (см. "ui"),
    // один аргумент — имя команды (не читается, ret 4). Прячет лавку и сумку, обнуляет отметки клиента; серверу ничего не шлёт.
    // Как найти на другом клиенте: таблица команд CDlgShop заполняется при старте кодом подряд — строки "repairall" и следом
    // "IDCANCEL", у "IDCANCEL" — эта функция; начинается с «push esi; mov esi,ecx; push 1; push 0; push 0; mov eax,[esi];
    // call [eax+0x1C]» (спрятать окно). Лавка нужна ремонту из сумки: без неё сервер не чинит («Служба недоступна»).
    // Проверено в игре: Probe act shop-open → act repair-all (всё надетое до полной) → act shop-close — лавка закрылась
    "shopDialogClose": { "rva": "0x1E0930", "convention": "thiscall", "this": "shopDialog", "args": [ "0" ],
                         "signature": "56 8B F1 6A 01 6A 00 6A 00 8B 06 FF 50 1C 6A 00 68 ?? ?? ?? ?? 68 ?? ?? ?? ?? 6A 00 FF 76 34 C7 86 68 03 00 00 00 00 00 00 E8" },

    // Починить предмет — c2s 0x25 «услуга NPC» с услугой 3 «ремонт», лавка открыта. tid -1 (и 0, 0) — починить всё: так её
    // зовёт ответ «Да» в окне Game_RepairAll (кнопка «Починить все» лавки — команда «repairall» окна Win_Shop); с настоящим
    // предметом — только его (кнопка «Починить», команда «repair»). cdecl: в стеке tid, в cl — где предмет, в dl — ячейка.
    // Пакет 16 байт: [0x25:2][услуга 3:4][длина данных 6:4][tid:4][где:1][ячейка:1]. Как найти на другом клиенте: c2s-функция
    // с «mov dword [reg+2], 3» и «mov dword [reg+6], 6» рядом с «mov eax, 0x25», лежит среди функций c2s рядом с useItem
    "repairItem": { "rva": "0x3CFF90", "convention": "cdecl", "args": [ "tid" ],
                    "registers": { "ecx": "where", "edx": "slot" },
                    "signature": "55 8B EC 51 53 56 6A 10 8A DA 8A F9 FF 15 ?? ?? ?? ?? 8B F0 83 C4 04 85 F6 74 ?? 8B 0D ?? ?? ?? ?? B8 25 00 00 00 6A 10 66 89 06 8B 45 08 8B 49 20 56 C7 46 02 03 00 00 00 C7 46 06 06 00 00 00" },

    // (0x33BE00) — по сопоставлению кода; первым читает флаги перса +0x80C (в 1.4.6 +0x814), поэтому старая сигнатура не подошла
    "hostPickupObject": { "rva": "0x31CA00", "convention": "thiscall", "this": "host",
                          "signature": "55 8B EC 51 53 56 57 8B F9 8B 87 0C" },
    // (0x3324F0)
    "hostApplySkill": { "rva": "0x313910", "convention": "thiscall", "this": "host",
                        "signature": "55 8B EC 83 EC 0C 53 56 57 68 ?? ?? ?? ?? 8B F9" },
    // Запустить макрос (номер с 0, 0, -1) — как кнопка макроса на панели. Как найти: таблица методов класса CECSCSkillGrp
    // (имя есть в exe), метод 2 — «нажать»: зовёт эту функцию у персонажа. Она удаляет идущий макрос [перс + 0x1950] и
    // запускает заново
    "hostApplyComboSkill": { "rva": "0x31F8A0", "convention": "thiscall", "this": "host",
                             "signature": "55 8B EC 51 56 8B F1 8B 8E 50 19 00 00 85 C9 74" },
    // Остановить идущий макрос: удаляет его [перс + 0x1950], макроса нет — ничего. Без аргументов, серверу ничего не шлёт,
    // каст не прерывает. Игра зовёт её сама, когда скилл нажат не макросом (hostApplySkill со вторым аргументом 0). Как найти:
    // функция сразу после hostApplyComboSkill — первые её строки (удалить идущий макрос) и сразу ret
    "hostClearComboSkill": { "rva": "0x31F990", "convention": "thiscall", "this": "host",
                             "signature": "56 8B F1 8B 8E 50 19 00 00 85 C9 74 10 8B 01 6A 01 FF 10 C7 86 50 19 00 00 00 00 00 00 5E C3" },
    // (0x3F6FD0) c2s 0x28, cl = где, dl = ячейка
    "useItem": { "rva": "0x3CFC20", "convention": "cdecl", "args": [ "tid", "count" ],
                 "registers": { "ecx": "where", "edx": "slot" },
                 "signature": "55 8B EC 53 56 6A 0A 8A DA 8A F9 FF" },
    // (0x32B160) c2s 0x29
    "castSkill": { "rva": "0x30CC20", "convention": "thiscall", "this": "session",
                   "signature": "55 8B EC 51 56 8D 45 FC C7 45 FC 29" },
    // (0x12FC90) c2s 0x2A — отменить действие, как Esc; на 1.4.6 и PW Classic закрывает и окно банка, здесь глазами не сверено
    "cancelAction": { "rva": "0x120670", "convention": "thiscall", "this": "session",
                      "signature": "55 8B EC 51 56 8D 45 FC C7 45 FC 2A 00 00 00" },
    // (0x1E3820) c2s 0x67
    "petCtrl": { "rva": "0x1CEDE0", "convention": "thiscall", "this": "session",
                 "signature": "55 8B EC 51 53 56 57 8D 45 FC C7 45" },
    // (0x33FD20) c2s 0x64 — функция прямо перед recallPet; берёт менеджер петов [перс + 0x1948]
    "summonPet": { "rva": "0x320940", "convention": "thiscall", "this": "host",
                   "signature": "55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 00 00 00 00 50 53 56 57 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3 00 00 00 00 8B F1 8B 8E 04 1C 00" },
    // (0x33FED0) c2s 0x65. Ещё одна отправка 0x65 — 0x2F5EA0 (без проверок окна), её не используем
    "recallPet": { "rva": "0x320AF0", "convention": "thiscall", "this": "host",
                   "signature": "56 8B F1 8B 8E 04 1C 00 00 85 C9 74" },
    // (0x347A70) — вызов из PickupObject в той же позиции; типов работ здесь 0..0x13 (в 1.4.6 0..0x14)
    "workCreate": { "rva": "0x328240", "convention": "thiscall", "signature": "55 8B EC 8B 45 08 56 8B F1 83 F8 13" },
    // (0x34DDF0)
    "workMoveSetDestination": { "rva": "0x32E350", "convention": "thiscall", "args": [ "type", "data" ],
                                "signature": "55 8B EC 83 EC 10 56 8B F1 8B 4D 0C 57 8B 7D 08" },
    // (0x30E340) кнопка «Полёт»
    "hostFly": { "rva": "0x2F1F80", "convention": "thiscall", "this": "host", "args": [ "force" ],
                 "signature": "56 8B F1 57 8B 8E 04 1C 00 00 85 C9" },
    // (0x3484D0)
    // Работа «подойти» — цель задают два метода работы, как в 1.4.6 (там подробно: причины, как найти). Те же сигнатуры, одно место
    // в exe; зовутся подряд из CECHostPlayer::PickupObject (hostPickupObject). Проверено в игре (банкир).
    "workTraceTarget": { "rva": "0x333710", "convention": "thiscall",
                         "signature": "55 8B EC 53 56 57 8B 7D 08 8B D9 85 FF 74 ?? 78 ?? 6A 1C E8" },
    "workTraceSetTarget": { "rva": "0x333580", "convention": "thiscall",
                            "signature": "55 8B EC 8A 45 0C 83 EC 18 56 8B F1 57 8B 7D 08 6A 00 88 46 3A" },
    "workStart": { "rva": "0x328B20", "convention": "thiscall", "args": [ "1", "work", "0" ],
                   "signature": "55 8B EC 53 56 57 8B 7D 0C 8B F1 85 FF 74 10 8B" }
