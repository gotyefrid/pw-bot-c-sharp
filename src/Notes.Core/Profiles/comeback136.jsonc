    { "offset": "0x8C0E24", "expected": "AD 50 AA A0 8A F6 D6 A9 64 4E DB 9B EB 87 0A A2 57 A0 53 13 1B 02 BA 34 6A 1A 9A 84 49 90 4C BB",
      "new": "CE 73 8E 0B AB 7D BA BE D9 09 4D 09 F1 00 F1 9B 31 C8 AB 1B 10 DC 9A 45 D7 0B 5C 1D CE FA B9 B8",
      "note": "Контрольная сумма образа .mgbase: SHA-256 от .mgbase[0:0x24] + .text + .reloc. После правки .text её надо пересчитать, иначе клиент не запустится" }
    
    ],
    "digest": {
      // Секция с контрольной суммой образа; у этого билда — .mgbase (магия MGBASE01 в начале данных).
      "section": ".mgbase",
      // Сколько байт начала секции входит в хэш — заголовок самой контрольной суммы.
      "headerLength": "0x24",
      // Где в секции лежит поле digest (от начала сырых данных секции); сравниваются все байты.
      "digestOffset": "0x24",
      "digestLength": "0x20",
      // Какие секции хэшируются после заголовка, каждая куском min(VirtualSize, RawSize) от начала: код и
      // релокации. Правки задели .text — после них поле digest пересчитывается, иначе клиент откажется стартовать.
      "hashSections": [ ".text", ".reloc" ]
    }
  },

  // Сторож клиента: element/reportbugs/pwprotector.exe — клиент сам его запускает на всё время игры. Тот же файл,
