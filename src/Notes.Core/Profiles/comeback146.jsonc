/*
  Comeback PW 1.4.6 — https://comeback.pw/ (свой сервер-аналог)

  Сборка клиента новая (метка в exe — сентябрь 2026), старые смещения Comeback146X.cs старого бота (метка old-bot) подходят лишь частично.
  Найдено чтением памяти живого клиента (ничего не писалось и не вызывалось); как искать поле — Probe port (до/после действия).

  Особенности клиента:
    - exe грузится по случайному адресу (ASLR, видели 0x540000) — все адреса здесь от начала модуля, это не мешает;
    - в exe уже стоит флаг LAA: клиенту доступно 4 ГБ адресов, а не 2, как у PW Classic.

  0 = «ещё не найдено»: поле не читается.
*/
{
  "id": "comeback146",
  "name": "Comeback 1.4.6",

  // Архивы .pck (configs.pck → названия скиллов) зашифрованы своими ключами. Найдено в загрузчике .pck клиента (0x9A46E2):
  // ключи лежат в .data (VA 0xCA2468..0xCA2478), версия формата 5 → смещение оглавления ^ 0x9A4E1CB0, хвост за 0x9E82 байт
  // до конца архива. Конец архива записан в заголовке файла — дальше клиент дописывает своё (это читатель .pck учитывает сам)
  "gameFiles": {
    "pck": { "key1": "0x1597270A", "key2": "0x604E0ECB", "offsetKey": "0x9A4E1CB0", "tailSize": "0x9E82" }
  },

  "base": {
    // game = [база + 0x1C]. Саму базу бот находит в коде клиента (самая читаемая переменная) — в профиле её нет
    "game": "0x1C",
    // Объект связи с сервером: в нём SendGameData (ecx = [[база]+0x20]) и ограничитель частоты команд (+0x104)
    "session": "0x20",
    // Настройки игры (в них макросы): запуск макроса (hostApplyComboSkill) зовёт разбор макроса, тот читает [[база] + 0x18]
    "configs": "0x18"
  },

  "host": {
    "struct": "0x28",
    // Указатель на ник (UTF-16). Старое 0x6F8 — не оно
    "namePointer": "0x788",
    // Байт «персонаж кастует»: два «Исцеления питомца» — дважды 1 на ~2.5 с, и каждый раз MP 130 → 126
    "castFlag": "0xB8",
    // WID: моб, который бьёт персонажа, хранит это число в «цели» (+0x210). После перезахода то же (0x130ECE0).
    // (+0x4C0 рядом — не WID: меняется при перезаходе и не встречается у моба)
    "wid": "0x4B8",
    // Было 2, после роста HP 84 → 108 стало 3 — уровень. Подтвердить по окну игры
    "level": "0x4C4",
    // HP/MP и максимумы: при полной мане MP (+0x4D0) = максимум (+0x534) = 96, HP = максимум = 84
    "hp": "0x4CC",
    "mp": "0x4D0",
    "maxHp": "0x530",
    "maxMp": "0x534",
    // WID выбранного моба: выбрал «Сумеречного жука» — здесь его WID, снял цель — 0
    "targetId": "0x5B4",
    // Перезарядка корма пета, мс осталось: после кормления 0 → ~52500 и убывает 1000/с (найдено сравнением до/после кормления)
    "petFoodCooldown": "0xCB4",
    "location": "0x3C",
    // Какой скилл кастуется: указатель на объект скилла (номер — по skill.id), ровно на время каста, в конце 0. Запись 22 кастов:
    // лечение пета — 330, атака — 299. Рядом +0x880 — цель каста (пет или моб)
    "castingSkill": "0x87C",
    // Копание ресурса (запись памяти во время сбора): +0xC0C — сколько мс прошло, +0xC10 — сколько всего (железная руда 5000,
    // камень 8000); после конца или срыва остаются последними.
    // Копает ли — id ресурса +0x898 (0 — нет). Его пишет обработчик «начало сбора» (0x329060, сообщение 0x7E: [edi+0x898] = esi,
    // ниже +0xC10 = секунды × 1000 и +0xC0C = 0), обнуляет «конец сбора» (0x7F, та же функция). Как найти на другом клиенте:
    // функция, где «всего мс» = байт × 0x3E8, а «прошло» = 0, — в ней выше «mov [edi+X], esi». Пишет только для ресурсов с
    // флагом — обычно копание видно лишь по работе «сбор» (gatherWork)
    // Байт +0x288 (0 — копает, запись памяти) не берём: в 1.3.6 такой байт в воде 0 и без копания — бот видел «копает» без конца
    // и стоял
    "gatherTarget": "0x898",
    "gatherElapsed": "0xC0C",
    "gatherTotal": "0xC10",
    // Найдено по коду клиента: кнопка «призвать/отозвать» (0x33FD20, шлёт c2s 0x64/0x65) берёт пета из [перс + 0x1980].
    // (+0x95C тоже хранит WID пета, но после отзыва не обнуляется — не годится)
    "petManager": "0x1980",
    // CECHPWorkMan — менеджер «работ» (идти, подойти к цели): PickupObject берёт его из [перс + 0x1968]
    "workMan": "0x1968",
    // Сумка: массив указателей на объекты-предметы (у каждого первым полем vtable из .rdata), 32 ячейки, как в 1.3.6.
    // Рядом +0x10C8 — 38 ячеек (похоже, экипировка)
    "inventory": "0x10C4",
    // Массив указателей на объекты скиллов (один класс) и их число: 167, 299, 329, 330 — как у друида в 1.3.6
    "skills": "0x1994",
    "skillsCount": "0x1998",
    // Где персонаж: 0 — земля, 2 — воздух (запись взлёта и посадки: 0 → 2 → 0; 1, по клиенту, вода). Рядом +0x814 бит 4 —
    // тоже «летит», +0xBD8 — нажатые клавиши движения (16 — вверх, 32 — вниз)
    "moveEnv": "0x798"
  },

  // Менеджер петов: [перс + 0x1980]. Проверено призывом/отзывом: призван — +0x8 = 0 и +0x64 = WID (как в игре по d_npcid),
  // отозван — -1 и 0
  "petManager": {
    "activeCage": "0x8",
    // Пет клетки N: [менеджер + 0x10 + (N-1)*4]. Клиент допускает индекс до 20 (cmp ebx, 0x14), берём 20 клеток
    "cages": "0x10",
    "cageCount": 20,
    "activePetWid": "0x64"
  },

  // Пет в клетке. HP — float 0..1: клиент сравнивает его с нулём перед призывом (мёртвого не призывает).
  // Сытость — как в 1.3.6, не сверено (у сытого волка 3)
  "pet": {
    "hpRatio": "0x1C",
    "hunger": "0x8",
    // Запись питомца в справочнике (PET_ESSENCE, шаг 0x2AC, 75 записей): [пет + 0x190] (так её берёт и кнопка призыва 0x33FD20),
    // id записи = tid пета (+0xC), название +8. Где живёт — +0x1E8 (inhabit_type): 0 земля, 1 вода, 2 воздух, 3 земля+вода,
    // 4 земля+воздух, 6 везде. Проверено на всех 75: пчёлы/оса 2, скорпионы/медведи 0, карп 1, фениксы/гарпии 6.
    // Клиент перед призывом среду не проверяет — отказывает сервер
    "tid": "0xC",
    "essence": "0x190",
    "essenceName": "0x8",
    "essenceInhabit": "0x1E8",
    // HP пета в единицах игра не хранит — его считает окно пета (CDlgPetDetail): макс = (int)((уровень − levelRequire × hpB + hpC)
    // × hpA), всё во float; сейчас = (int)(макс × доля HP). Уровень — в данных пета (level), остальное — в записи справочника:
    // +0x150 int, +0x158, +0x15C, +0x160 float. Как найти: в функции окна с L"%d/%d" — умножение на долю HP (+0x1C), а перед ним
    // эти четыре поля записи и уровень пета. Проверено: скорпион ур. 19 — 572, сейчас 409;
    // те же 409 игра держит в данных призванного пета (+0x38)
    "level": "0x24",
    "essenceLevelRequire": "0x150",
    "essenceHpA": "0x158",
    "essenceHpB": "0x15C",
    "essenceHpC": "0x160"
  },

  // Мир: [game + 0x14]. Хэш-таблицы как у 1.3.6 (769 ячеек, узел {+0x0 следующий, +0x4 объект, +0x8 id}),
  // но у менеджера мобов всё сдвинуто на 4: счётчик +0x18, число ячеек +0x1C, массив +0x20.
  // У менеджера предметов как у 1.3.6: счётчик +0x14, число ячеек +0x18, массив +0x1C. Обход совпал со счётчиками (75 и 16)
  "world": {
    "world": "0x14",
    "slotCount": 769,
    "objectInSlot": "0x4",
    "npcs": { "manager": "0x20", "slotArray": "0x20", "count": "0x18" },
    "groundItems": { "manager": "0x24", "slotArray": "0x1C", "count": "0x14" }
  },

  // Удары: кто, кого, сколько урона — менеджер атак мира (CECAttacksMan, имя класса есть в exe). Игра кладёт туда каждый удар
  // и скилл по цели, когда пришёл ответ сервера, и убирает после попадания (живёт 0,4…2 с) — читать раз в 250 мс хватает.
  // Как найти: строка «CECAttacksMan::CECAttacksMan(), failed to load multi skill sgc config file» — в конструкторе; его зовёт
  // создание мира и кладёт результат в [мир + manager] (рядом мобы +0x20 и предметы +0x24). Список событий (AList2) — с +0x10:
  // +0x14 первый узел; узел: +0x0 следующий, событие с +0x8. Раскладка события — в функции «попадание» (её зовёт Tick
  // менеджера, vtable[2]): +0x8 сколько мс живёт, +0x14 кто бьёт, +0x30 скилл, +0x1C массив целей по 0x18 байт, +0x28 сколько
  // целей; в цели +0x0 кого, +0x8 флаги, +0xC урон (его игра и показывает над целью). Раскладка как у
  // PW Classic — сверено по коду; на живом клиенте проверить: Probe attacks
  "attacks": {
    "manager": "0x30",
    "head": "0x14",
    "event": "0x8",
    "lived": "0x8",
    "attacker": "0x14",
    "skill": "0x30",
    "targets": "0x1C",
    "targetCount": "0x28",
    "targetSize": "0x18",
    "targetFlags": "0x8",
    "targetDamage": "0xC"
  },

  // Моб / NPC / пет. Состояние, цель и HP найдены 02.10.2026 в бою: запись полей цели 10 раз в секунду до исчезновения трупа
  "npc": {
    "wid": "0x114",
    // 6 моб, 7 NPC, 9 пет
    "type": "0xB4",
    // Как у 1.3.6: 1 стоит, 5 идёт, 2 бьёт, 4 мёртв (держится ~5 с, пока лежит труп). У живых других мобов 1.
    // Рядом +0x2D4 (старое значение) ведёт себя похоже, но у стоящих мобов там 0
    "state": "0x2DC",
    // Только у выбранной цели: шло 71 → 48 → 25 → 8. По +0x18C лежит максимум (71)
    "hp": "0x128",
    // WID того, кого бьёт моб: сначала персонаж, потом переключился на пета
    "target": "0x210",
    // Заклинатели (Шаман пламени) пока кастуют держат в +0x210 «никого» (-1), а цель каста — здесь: 30 из 30 замеров
    // WID пета, пока шаман кастовал в него. Без этого «сначала тех, кто бьёт меня или пета» шамана не видел
    "castTarget": "0x2FC",
    // Моб бьёт (состояние 2), а +0x210 = 0: так было у моба, заагрившегося на перса, пока пет и перс били другого. Кого он бьёт
    // на самом деле — здесь (у того, кто бил пета, тут тоже пет, как и в +0x210). Без этого «снимать мобов с меня петом» не видел его
    "attackTarget": "0x2F8",
    // Уровень: единственное поле 1..150, одинаковое у мобов одного вида и разное у разных
    // (Сумеречный жук 2, Малая росянка 1, Коза 1, Ястреб 80, Король небесных волков 40)
    "level": "0x120",
    // Расстояние до персонажа, которое держит игра (float, по горизонтали). Бот его не читает — считает из координат;
    // нужно только Probe selftest: «расчёт = память» ловит ошибку в смещении location. Не найдено — убрать строку
    // Сверено с координатами (старое 0x290 у части мобов расходится)
    "distance": "0x294",
    // «Почтовый ящик», «Малая росянка», «Летяга-разбойница»
    "namePointer": "0x26C",
    "location": "0x3C",
    // Указатель на запись моба в справочнике (MONSTER_ESSENCE, см. monsterEssence); на 1.3.6 — +0x364. Найдено так же:
    // указатель на запись, у которой id (+0x0) — вид моба, а название (+0x8) — его название
    "essence": "0x3A4",
    // Флаги моба: 0x20000 — бросил цель и возвращается на место (в игре в это время неуязвим и не агрится). Ставится в ту же
    // секунду, что и отагр, держится 4–6 с, пока идёт назад; цель +0x210 при этом может ещё показывать нас (и застревает, если
    // перс далеко). Найдено записью памяти мобов 5 раз/с (2026-10-03): у Лугового паука флаг был ровно в 4 отагра (взлёт над ним,
    // отбег), у остальных 27 мобов записи — всегда 0. Проверено скриптом в игре: завершился в момент разворота паука.
    // +0x244 — копия того же флага. На 1.3.6 — то же место и флаг (там копии в +0x244 нет)
    "returning": "0x22C",
    "returningFlag": "0x20000"
  },

  // Сумка: [перс + 0x10C4], +0xC массив, +0x10 число ячеек — как в 1.3.6. Предмет сдвинут на +4:
  // категория 9 — «Малая микстура бодрости» ×5, 27 — корм «Родниковая вода» ×200 (максимум в стопке 1000)
  "inventory": {
    "items": "0xC",
    "size": "0x10",
    "itemCategory": "0x8",
    "itemTid": "0xC",
    "itemCount": "0x14",
    "itemMaxCount": "0x18",
    // Указатель на описание (в нём +0x0 тот же tid). У банки и у корма разные классы предметов
    "itemEssence": "0x78",
    "foodEssence": "0x70",
    "categoryPotion": 9,
    "categoryPetFood": 27
  },

  // Описание банки — как в 1.3.6. Сверено на «Малой микстуре бодрости»: MP 40 за 10 с, HP 0.
  // Поля HP взяты по аналогии (у банки маны там 0) — сверить на банке HP
  "potion": {
    "requiredLevel": "0x14C",
    "hp": "0x154",
    "hpSeconds": "0x158",
    "mp": "0x15C",
    "mpSeconds": "0x160"
  },

  // Описание корма в справочнике игры (на него указывает foodEssence предмета): +0x0 tid корма, +0x4 название (UTF-16,
  // 32 символа), +0x148 верность — сколько даёт корм («Чистая вода» 10, «Зеленая трава» 20). Как найти: корм в сумке →
  // описание; название — строка сразу за tid, верность — число из подсказки корма в игре
  "petFood": {
    "loyalty": "0x148",
    "name": "0x4"
  },

  // Объект скилла — как в 1.3.6. Сверено на «Оживлении питомца»: перезарядка 1000 мс, +0x10 шло 916 → 0, +0x18 = 1 пока идёт
  "skill": {
    "id": "0x8",
    "level": "0xC",
    "cooldownLeft": "0x10",
    "cooldownFull": "0x14",
    "flags": "0x18"
  },

  // ID скиллов друида — те же, что в 1.3.6 (167 «Городской портал»)
  // Макросы персонажа: в настройках игры с +0x159, 8 штук по 0x11 байт — байт иконки (0 — макроса нет) и 8 скиллов по 2 байта
  // (-1 — обычная атака, -2 — повтор). Как найти: функция, которую зовёт запуск макроса, проверяет номер ≤ 7 и копирует
  // [настройки + номер×0x11 + 0x159] — 16 байт и ещё один
  "macros": { "list": "0x159", "size": "0x11", "count": 8 },

  // Кирка (tid 3073 — купленная у торговца): без неё руду не копают, бот к ресурсам не подходит
  "gatherTools": [ 3073 ],

  // Как бежать в точку (тип у SetDestination, см. workMoveSetDestination): 0 — по прямой, как клик по земле.
  // 5 — автопуть, как клик по карте (0x31BE0A): работа при первом шаге (0x34E110) строит маршрут от перса до точки
  // (0x357F60, объект маршрута 0xCB9A10) и бежит по нему, обходя препятствия; маршрут не нашёлся — бежит по прямой
  // 1 — точка в пространстве: в воздухе у работы «идти» для неё своя ветка (0x3505CF), летит вместе с высотой точки.
  // Тип 0 в воздухе ведёт только по горизонтали, высоту держат клавиши (или автопуть сам жмёт вверх/вниз)
  // Копает ли — по работе «сбор» (тип 0xB, байт +0x28 = 1), как у PW Classic: её заводит обработчик «начало сбора» (0x329060:
  // workCreate(0xB), [работа+0x28] = 1, StartWork(1, …)); id ресурса (host.gatherTarget) он пишет только для ресурсов с флагом —
  // обычно его нет. Работы у менеджера — списками по уровням: [+0x38] — уровень, у уровня L массив [+L×0x10+8] и число
  // [+L×0x10+0x14]. Живой клиент: копает — уровень 1, одна работа типа 0xB с байтом 1; выкопал или прервал — список
  // сразу пуст (а «прошло» +0xC0C ещё тикает до конца полоски); бежит к ресурсу — работа типа 2
  "gatherWork": { "current": "0x18", "currentCount": "0x24", "type": "0x4", "gather": "0xB", "flag": "0x28" },

  "moveTypes": { "direct": 0, "smart": 5, "fly": 1 },

  "skills": {
    "healPet": 330,
    "revivePet": 329,
    "defaultAttack": 299,
    "notAttack": [ 167, 329, 330 ]
  },

  // Предмет на земле: как у 1.3.6, сдвинуто на +4. Сверено на руде (вид 2), угле (2) и жезле (1)
  "groundItem": {
    "id": "0x110",
    "tid": "0x114",
    // Вид — байт: 1 предмет, 2 ресурс, 3 монеты; следующий байт у части вещей не 0 (в pwclassic136 бывает 0x101)
    "kind": "0x150",
    // Расстояние до персонажа, которое держит игра (float, в 3D — с высотой). Бот его не читает — считает из координат;
    // нужно только Probe selftest: «расчёт = память» ловит ошибку в смещении location. Не найдено — убрать строку
    "distance": "0x158",
    "namePointer": "0x168",
    "location": "0x3C"
  },

  // Запись ресурса в справочнике (MINE_ESSENCE из elements.data, шаг 560 байт, 911 записей). Найдено 2026-10-03:
  // указатель на название у предмета на земле (+0x168) ведёт в запись +8. Начало записи — как в 1.3.6; после списка добычи
  // здесь 64 байта лишних, поэтому количество и квест на 0x40 дальше. Корень: кирка 3073, даёт 795, 2 (90 %) или 4 (10 %);
  // «Труп старейш. пауков-призраков»: инструмента нет, добычи нет, квест 35864 — копается только с квестом
  "mineEssence": {
    "nameInRecord": "0x8",
    "size": "0x1C0",
    "id": "0x0",
    "tool": "0x50",
    "materials": "0xE8",
    "materialSlots": 16,
    "amounts": "0x1A8",
    "quest": "0x1B8",
    // Нужный уровень персонажа (+0x48 рядом — уровень самого ресурса 1..5): 1, 20, 40, 60, 80. Бузина — 20; на 17-м игра
    // отвечает «недостаточно высокий уровень»
    "levelRequired": "0x4C"
  },

  // Записи предметов в справочнике (elements.data в gamedata.pck), в которых есть тип: указатель на название у предмета на земле
  // (groundItem.namePointer) ведёт внутрь записи, перед названием — tid и тип. Две раскладки, как в pwclassic136: оружие, броня,
  // украшения, банки, материалы — +0x0 tid, +0x4 тип, +0x8 подтип, +0xC название; снаряды — +0x0 tid, +0x4 тип, +0x8 название.
  // Бот пробует обе: годится та, где на месте tid — tid предмета (у другой там чужое число). Сверено на живом клиенте 27.10:
  // «☆Меч Семи звезд» 349 — Оружие, «Большое исцеляющее зелье» 8619 — Банки, «Плоть призрака» 8090 — Предметы ДК.
  // Как найти на другом клиенте:
  // 1. Выложить на землю вещь с типом (оружие, броню или банку) и снаряд. Probe snapshot — их tid в строке «Лут».
  // 2. В elements.data (внутри gamedata.pck, ключи — gameFiles.pck) найти 4 байта tid, за которыми через 8 байт (у снаряда —
  //    через 4) идёт название предмета в UTF-16. Сдвиг названия от tid — nameInRecord, 4 байта сразу за tid — тип. В памяти
  //    клиента запись лежит так же, как в файле.
  // 3. Тип сверить со списками типов (как их найти — у lootGroups): например, 1 — «Мечи», 8548 — «Праща».
  // 4. После правки Probe snapshot пишет у предмета на земле [группу]. Нет её у предмета из группы — раскладка не та.
  "itemEssences": [
    { "nameInRecord": "0xC", "id": "0x0", "type": "0x4" },
    { "nameInRecord": "0x8", "id": "0x0", "type": "0x4" }
  ],

  // Группы лута — по типу предмета в справочнике (тип читается по itemEssences). Данные игры, одинаковы на трёх серверах.
  // Оружие: мечи, копья, топоры/молоты, дальнобойное, кастеты, бичи, магическое, кинжалы, сферы, сабли, косы (сабли и косы есть
  // только на Comeback). Броня: верх, низ, обувь, голова, наручи, накидка. Украшения: ожерелье, пояс, кольцо. Банки: ЖС, МЭ,
  // ЖС и МЭ, детоксикатор, мгновенное противоядие. Снаряды: стрела, болт, пуля. Предметы ДК — тип материала 8077: подтипы
  // «Особые товары ур.1…10» по 10 предметов (с мобов падают 6), ур.2…9 — квесты «Искатель драконов» 20…91 по описанию предметов
  // (configs.pck → item_ext_desc.txt).
  // Как найти номера типов на другом клиенте: в elements.data списки типов — записи подряд по 68 байт (+0x0 id, +0x4 название
  // UTF-16, 32 символа); у оружия, брони, украшений и банок 4 байта перед первой записью — число записей. Найти в UTF-16 название
  // первой записи, id — 4 байта перед ним: оружие — 1 «Мечи», броня — 125 «Верх», украшения — 171 «Ожерелье», банки — 1794
  // «Восстанавливается ЖС», снаряды — 8546 «Стрела» (на Comeback — «Лук»). Новый тип на сервере — новая запись в том же списке
  // (так нашлись сабля 44878 и коса 44879 на Comeback). Тип ДК — 4 байта за tid в записи любого предмета ДК («Бивень» 8099); в
  // списке типов материалов он называется «Деньги дешевеют, цены падают».
  // Корм пета — списком tid: в его записи типа нет (+0x0 tid, +0x4 название, +0x148 верность, как в petFood; запись 0x168 байт),
  // 16 предметов, одни на трёх серверах. Как найти: в elements.data найти tid 8796, за которым сразу «Чистая вода» в UTF-16, — это
  // первая запись списка корма; 4 байта перед ней — число записей (16), дальше записи подряд по 0x168 байт, tid — первые 4 байта
  // каждой. Проверка: Probe snapshot показывает корм в сумке строкой «корм … (tid …)», на земле — с [Корм пета].
  // Счастливые билеты — предметы-сюрпризы (правой кнопкой — случайное задание с наградой) по уровням: карта (любой), билет
  // (с 20), мешок (с 50), коробка (с 70), звезда (с 90). С мобов падают 11092, 11094, 11096, 11098, 11101, остальные tid —
  // двойники с тем же названием. Тоже списком tid: это записи списка «предметы, дающие задание» (+0x0 tid, +0x4 название, дальше
  // до 8 заданий с вероятностями), типа в них нет. Одни tid на трёх серверах. Как найти: в elements.data найти в UTF-16
  // «Счастливая карта», «Счастливый билет», «Счастливый мешок», «Счастливая коробка», «Счастливая звезда» — tid в 4 байтах перед
  // названием; описание (configs.pck → item_ext_desc.txt) — «…сюрприз» или «ценный подарок» и «с N уровня». На Comeback так же
  // называются свадебный «Счастливый билет» 32083 (обмен на наряд) и «Счастливая карта усердия…доброты» 39220…39229 (задание
  // «Удача») — это другое, с мобов не падает, в группу не входит. Проверка: Probe snapshot — у билета на земле [Счастливые билеты].
  // Название группы хранится в настройках персонажа — не переименовывать
  "lootGroups": [
    { "name": "Оружие", "types": [ 1, 5, 9, 13, 182, 291, 292, 23749, 25333, 44878, 44879 ] },
    { "name": "Броня", "types": [ 125, 150, 216, 316, 346, 369 ] },
    { "name": "Украшения", "types": [ 171, 234, 247 ] },
    { "name": "Банки", "types": [ 1794, 1802, 1810, 1815, 2038 ] },
    { "name": "Снаряды", "types": [ 8546, 8547, 8548 ] },
    { "name": "Предметы ДК", "types": [ 8077 ] },
    { "name": "Корм пета", "tids": [ 8796, 9757, 9758, 9759, 9760, 9761, 11550, 11551, 11552, 11553, 11554, 11580, 11581, 12842, 18251, 26977 ] },
    { "name": "Счастливые билеты", "tids": [ 11092, 11093, 11094, 11095, 11096, 11097, 11098, 11099, 11100, 11101, 11102, 11103,
                                             13606, 13607, 13608, 13609, 13610, 13611, 13612 ] }
  ],

  // Запись моба (MONSTER_ESSENCE) — раскладка как на 1.3.6 (подробности там): +0x2B8 агрессивный 0/1, +0x260 радиус агра, м
  // (обзор: моб с обзором 7 напал на 6.8 м), +0x2C4 погоня, float м, +0x2C8 время агра, float с (бросил через 14.7 с при 15)
  "monsterEssence": {
    "aggressive": "0x2B8",
    "aggroRadius": "0x260"
  },

  // Функции клиента. Здесь они собраны иначе, чем в 1.3.6: аргументы снимает сама функция (ret N), многие команды
  // отправляются прямо из логики клиента, а не из отдельных c2s_SendCmd*. Номер команды пишется «mov eax, N; mov word [esi], ax».
  // Таблица «команда → откуда отправляется» — по всем вызовам SendGameData (rva 0x43E5E0)
  "functions": {
    // CECHostPlayer::SelectTarget(int id) — то, что делает клик по мобу (this = перс, ret 4). Сама пишет цель в перс +0x5B4
    // и отправляет c2s 0x02 (6 байт); повтор той же цели не шлёт. Перед этим проверяет, можно ли сейчас выбирать (0x73C4F0(0x12))
    "selectTarget": { "rva": "0x3411F0", "convention": "thiscall", "this": "host", "args": [ "wid" ],
                      "signature": "55 8B EC 83 EC 08 53 56 57 6A 12 8B" },
    // Та же функция с id 0 — отправляет c2s 0x08 (снять цель), отдельной функции в клиенте нет
    "unselect": { "rva": "0x3411F0", "convention": "thiscall", "this": "host", "args": [ "0" ],
                  "signature": "55 8B EC 83 EC 08 53 56 57 6A 12 8B" },

    // c2s_SendCmdNormalAttack(byte pvpMask), команда 0x03, пакет 3 байта — как в 1.3.6, только ret 4.
    // Единственное место в exe, где отправляется 0x03. Перед отправкой — критическая секция и необязательный обработчик клиента
    "normalAttack": { "rva": "0x351D30", "convention": "stdcall",
                      "signature": "55 8B EC 83 EC 08 56 68 ?? ?? ?? ?? FF 15 ?? ??" },

    // Отдельной функции «подобрать» (c2s 0x06) в 1.4.6 нет: пакет шлёт работа «подойти к предмету» (CECTracedMatter, vtable[3]
    // @0x353AB0), когда персонаж дошёл. Поэтому подбор — только «как мышкой».
    // CECHostPlayer::PickupObject(int id, bool gather) — this = перс, ret 8. Проверяет id 0xC..., что вид предмета (+0x150, 2 = ресурс)
    // совпадает с gather, и через фабрику работ 0x353180 создаёт «подойти» с причиной 1 (подобрать) или 4 (собрать).
    // Найдено: CECTracedMatter → конструктор/фабрика 0x353180 → её вызывающие с причиной 1/4
    "hostPickupObject": { "rva": "0x33BE00", "convention": "thiscall", "this": "host",
                          "signature": "55 8B EC 51 53 56 57 8B F9 8B 87 14" },

    // CECHostPlayer::ApplySkill(int id, bool fromMacro, int target, int pvp) — нажатие кнопки скилла, this = перс, ret 0x10.
    // Та же фабрика 0x353180 с причиной 3 (скилл), внутри особая проверка на ID 167 (0xA7, «Городской портал») — как в 1.3.6
    "hostApplySkill": { "rva": "0x3324F0", "convention": "thiscall", "this": "host",
                        "signature": "55 8B EC 83 EC 0C 53 56 57 68 ?? ?? ?? ?? 8B F9" },
    // Запустить макрос (номер с 0, 0, -1) — как кнопка макроса на панели. Как найти: таблица методов класса CECSCSkillGrp
    // (имя есть в exe), метод 2 — «нажать»: зовёт эту функцию у персонажа. Она удаляет идущий макрос [перс + 0x1988] и
    // запускает заново
    "hostApplyComboSkill": { "rva": "0x341290", "convention": "thiscall", "this": "host",
                             "signature": "55 8B EC 51 56 8B F1 8B 8E 88 19 00 00 85 C9 74" },
    // Остановить идущий макрос: удаляет его [перс + 0x1988], макроса нет — ничего. Без аргументов, серверу ничего не шлёт,
    // каст не прерывает. Игра зовёт её сама, когда скилл нажат не макросом (hostApplySkill со вторым аргументом 0). Как найти:
    // функция сразу после hostApplyComboSkill — первые её строки (удалить идущий макрос) и сразу ret
    "hostClearComboSkill": { "rva": "0x341380", "convention": "thiscall", "this": "host",
                             "signature": "56 8B F1 8B 8E 88 19 00 00 85 C9 74 10 8B 01 6A 01 FF 10 C7 86 88 19 00 00 00 00 00 00 5E C3" },

    // c2s_SendCmdUseItem, команда 0x28, пакет 10 байт [0x28][where][count][index:2][tid:4] — как в 1.3.6, но часть аргументов
    // в регистрах: cl = where (0 — сумка), dl = ячейка, в стеке tid и count, стек чистит вызывающий (так вызывает клиент: add esp, 8)
    "useItem": { "rva": "0x3F6FD0", "convention": "cdecl", "args": [ "tid", "count" ],
                 "registers": { "ecx": "where", "edx": "slot" },
                 "signature": "55 8B EC 53 56 6A 0A 8A DA 8A F9 FF" },

    // Скилл пакетом, команда 0x29: метод объекта связи (this = [[база]+0x20], ret 0x10), args (skill, pvpMask, —, &цель).
    // Число целей в пакете клиент всегда пишет 1 (третий аргумент не читает), цель — *&цель. Перед отправкой — ограничитель частоты.
    // Вызывают: ApplySkill (особые 167 и 0x720) и логика скилла 0x33B000
    "castSkill": { "rva": "0x32B160", "convention": "thiscall", "this": "session",
                   "signature": "55 8B EC 51 56 8D 45 FC C7 45 FC 29" },

    // Отменить действие (каст, копание) — как Esc: команда 0x2A, пакет 2 байта. Метод объекта связи без аргументов
    // (this = [[база]+0x20], ret), с тем же ограничителем частоты, что у castSkill (чаще — молча не шлёт). Вызывают 12 мест клиента
    "cancelAction": { "rva": "0x12FC90", "convention": "thiscall", "this": "session",
                      "signature": "55 8B EC 51 56 8D 45 FC C7 45 FC 2A 00 00 00" },

    // c2s_SendCmdPetCtrl(int target, int cmd, void* data, int size), команда 0x67, пакет 10 + size — как в 1.3.6, но метод объекта
    // связи (this = [[база]+0x20], ret 0x10) с ограничителем частоты. Рядом 0x1E3BA0… — готовые приказы с постоянными данными
    "petCtrl": { "rva": "0x1E3820", "convention": "thiscall", "this": "session",
                 "signature": "55 8B EC 51 53 56 57 8D 45 FC C7 45" },

    // Кнопка «призвать пета»: CECHostPlayer::SummonPet(int index), this = перс, ret 4. Пет — [менеджер петов + 0x10 + index*4]
    // (по ней и нашли менеджер). Не призывает мёртвого и неподходящего по уровню, шлёт c2s 0x64.
    // Отзыв (0x65) — отдельная функция 0x33FED0, сюда не входит
    "summonPet": { "rva": "0x33FD20", "convention": "thiscall", "this": "host",
                   "signature": "55 8B EC 6A FF 68 ?? ?? ?? ?? 64 A1 00 00 00 00 50 53 56 57 A1 ?? ?? ?? ?? 33 C5 50 8D 45 F4 64 A3 00 00 00 00 8B F1 8B 8E 64 1C 00" },

    // Кнопка «отозвать пета»: CECHostPlayer::RecallPet(), this = перс, без аргументов, ret (стек не трогает).
    // Как найти в другом клиенте: среди отправителей SendGameData (rva 0x43E5E0) — тот, что пишет команду 0x65
    // («mov eax, 0x65; mov word [esi], ax», пакет 2 байта, только номер команды). Начало функции — как у summonPet:
    // [перс + 0x1C64] (окно/диалог, закрывается вызовом 0x6687E0), затем «можно действовать» (0x732D00), потом отправка.
    // Лежит сразу за summonPet (0x33FED0 = конец 0x33FD20 + выравнивание). Вызывают: 0x1C898E и 0x4023E7 (кнопки окна петов).
    "recallPet": { "rva": "0x33FED0", "convention": "thiscall", "this": "host",
                   "signature": "56 8B F1 8B 8E 64 1C 00 00 85 C9 74 10 80 79 3C 00 74 0A 6A" },

    // Идти в точку — как в 1.3.6: work = WorkMan->CreateWork(1); work->SetDestination(0, &point); WorkMan->StartWork(1, work, 0).
    // Так клиент делает ход с клавиатуры (0x3358D0, там тип 2 — направление); клик по земле (0x31BAC6) — то же, но SetDestination
    // вписан прямо в код. Отличие от 1.3.6 — у StartWork на один аргумент меньше (ret 0xC).
    // CreateWork(type) — switch по 0..0x14, тип 1 = CECHPWorkMove (vtable 0xBFC9DC), ret 4
    "workCreate": { "rva": "0x347A70", "convention": "thiscall", "signature": "55 8B EC 8B 45 08 56 8B F1 83 F8 14 0F 87" },
    // SetDestination(type, &point): пишет точку в +0x20, тип в +0x2C, направление в +0x34 (нормированное), ret 8.
    // Тип («type») — из moveTypes: 0 по прямой, 5 — автопуть
    "workMoveSetDestination": { "rva": "0x34DDF0", "convention": "thiscall", "args": [ "type", "data" ],
                                "signature": "55 8B EC 83 EC 10 56 8B F1 8B 4D 0C 57 8B 7D 08" },
    // Кнопка «Полёт» — CECHostPlayer::CmdFly(bool force), this = перс, ret 4. Переключатель: сидит — встаёт (и всё);
    // проверяет «можно действовать», полётник в экипировке (ячейка 12) и не заблокирован; в воде нельзя; потом
    // «использовать предмет» из экипировки, ячейка 12 (0x27FE70, c2s 0x28). Сама работа «идти» тоже вызывает её при автопути
    "hostFly": { "rva": "0x30E340", "convention": "thiscall", "this": "host", "args": [ "force" ],
                 "signature": "56 8B F1 57 8B 8E 64 1C 00 00 85 C9 74 10 80 79 3C 00" },
    "workStart": { "rva": "0x3484D0", "convention": "thiscall", "args": [ "1", "work", "0" ],
                   "signature": "55 8B EC 53 56 57 8B 7D 0C 8B F1 85 FF 74 10 8B" }
  },

  // Правка exe клиента: фиксированный набор байтовых правок под конкретный билд (originalSha256) плюс пересчёт
  // контрольной суммы образа (см. digest) — без него клиент не запустится с изменённым файлом. Как найти те же
  // места в новом билде — в комментарии у каждой правки. Применяет кнопка «Пропатчить» (Clients/ClientPatcher):
  // оригинал сохраняется как .orig рядом с exe, откат — той же кнопкой «Откат». Обновление игры → sha не совпадёт,
  // патчер откажется («не тот билд»), новому билду нужен новый рецепт.
  "patch": {
    "originalSha256": "98edc144320dae07908300cd50a4b1cc88ebe074115b40b537621b0d2b90a983",
    "patchedSha256": "6c4139540142160273bfa2bbc1f469cfabe35e22ec9bc1f7f968ca6ca4061daf",
    // Прежние сборки этого же рецепта: игрок мог пропатчить ими раньше. Такой файл бот узнаёт,
    // показывает «устарел» и пересобирает текущим рецептом из .orig.
    "supersededSha256": [ "a9cef1354595d2b1dee055e89929bd24d7ce44723c69e474c6287f83cfb51a19", "f5913175e9cc3f48ca14e0087128b44373081671a1e5ac89e55f33d30bacb112" ],
    "edits": [
    { "offset": "0xC4D2E", "expected": "74 4F",
      "new": "90 90",
      "note": "обход исполняемых регионов: JZ на ветку отчёта после CALL проверки белого списка → NOP. Как найти в новом билде: пара TEST AL,AL / JZ после CALL проверки белого списка" },
    { "offset": "0xC4428", "expected": "74 58",
      "new": "90 90",
      "note": "обход потоков процесса: JZ на ветку отчёта после CALL белого списка стартов → NOP. Как найти: TEST AL,AL / JZ после CALL белого списка стартов потоков" },
    { "offset": "0xC3FB1", "expected": "74 72",
      "new": "EB 72",
      "note": "обход открытых хендлов: JZ → JMP (чужой write-хендл не доложат). Как найти: проверка маски прав 0x2A в цикле обхода таблицы хендлов" },
    { "offset": "0x2E8", "expected": "44 00 00 00 00 80 93 00",
      "new": "00 02 00 00 00 80 93 00",
      "note": "Заголовок .mgbase: VirtualSize 0x44→0x200 — место под код фильтра. Как найти: таблица секций +8, секция — по магии MGBASE01 в начале данных" },
